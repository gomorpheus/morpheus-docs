#: ../../release_notes/current.rst:78
msgid "Fixed HKS cluster provisioning failures in proxy environments"
msgstr "Se corrigieron fallos de aprovisionamiento de clúster HKS en entornos proxy"

#: ../../release_notes/current.rst:80
msgid ""
"Fixed Bare Metal instance status remaining in \"Provisioning\" state in "
"multi-node scenarios"
msgstr "Se corrigió que el estado de la instancia Bare Metal permaneciera en \"Provisioning\" en escenarios multi-nodo"

