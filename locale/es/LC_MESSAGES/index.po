#: ../../release_notes/current.rst
msgid "BMaaS / Bare Metal"
msgstr ""

#: ../../release_notes/current.rst:51
msgid ""
"PXE/Network Boot support: boot Bare Metal hosts via customer PXE "
"infrastructure instead of virtual media, with optional Config ISO for "
"post-deployment automation"
msgstr ""

#: ../../release_notes/current.rst:52
msgid ""
"Brownfield import in Boot From SAN (BFS): discover and manage existing "
"BFS-provisioned servers"
msgstr ""

#: ../../release_notes/current.rst:53
msgid ""
"Support for multiple networks (VLANs) with Unmanaged Networking on a "
"single physical or bond interface"
msgstr ""

#: ../../release_notes/current.rst
msgid "HKS / Kubernetes"
msgstr ""

#: ../../release_notes/current.rst:55
msgid ""
"NGINX Replacement with Kubernetes Gateway API (Phase 1): Gateway API CRDs"
