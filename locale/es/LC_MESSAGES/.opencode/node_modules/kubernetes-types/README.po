#: ../../.opencode/node_modules/kubernetes-types/README.md:1
msgid "kubernetes-types"
msgstr ""

#: ../../.opencode/node_modules/kubernetes-types/README.md:3
msgid ""
"This package provides TypeScript definitions for Kubernetes API types, "
"generated from the Kubernetes OpenAPI definitions."
msgstr ""

#: ../../.opencode/node_modules/kubernetes-types/README.md:5
msgid "Example"
msgstr ""

#: ../../.opencode/node_modules/kubernetes-types/README.md:7
#, python-brace-format
msgid ""
"import {Pod} from 'kubernetes-types/core/v1'\n"
"import {ObjectMeta} from 'kubernetes-types/meta/v1'\n"
"\n"
"let metadata: ObjectMeta = {name: 'example', labels: {app: 'example'}}\n"
"let pod: Pod = {\n"
"  apiVersion: 'v1',\n"
"  kind: 'Pod', // 'v1' and 'Pod' are the only accepted values for a Pod\n"
"\n"
"  metadata,\n"
"\n"
"  spec: {\n"
"    containers: [\n"
"      /* ... */\n"
"    ],\n"
"  },\n"
"}\n"
msgstr ""

#: ../../.opencode/node_modules/kubernetes-types/README.md:26
msgid "Versioning"
msgstr ""

#: ../../.opencode/node_modules/kubernetes-types/README.md:28
msgid ""
"As an NPM package, kubernetes-types follows semver. The major and minor "
"version of the package will track the Kubernetes API version, while the "
"patch version will follow updates to the generated types."
msgstr ""

#: ../../.opencode/node_modules/kubernetes-types/README.md:30
msgid ""
"You should install the version of the types matching the Kubernetes API "
"version you want to be compatible with. Consult [NPM][versions] for the "
"list of available versions of this package."
msgstr ""

