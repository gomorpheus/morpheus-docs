#: ../../.opencode/node_modules/detect-libc/README.md:1
msgid "detect-libc"
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:3
msgid ""
"Node.js module to detect details of the C standard library (libc) "
"implementation provided by a given Linux system."
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:6
msgid "Currently supports detection of GNU glibc and MUSL libc."
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:8
msgid ""
"Provides asychronous and synchronous functions for the family (e.g. "
"`glibc`, `musl`) and version (e.g. `1.23`, `1.2.3`)."
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:11
msgid ""
"The version numbers of libc implementations are not guaranteed to be "
"semver-compliant."
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:14
msgid ""
"For previous v1.x releases, please see the [v1](https://github.com/lovell"
"/detect-libc/tree/v1) branch."
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:17
msgid "Install"
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:19
msgid "npm install detect-libc\n"
msgstr ""

