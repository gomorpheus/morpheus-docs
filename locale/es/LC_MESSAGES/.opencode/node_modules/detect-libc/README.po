msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:71
#, python-brace-format
msgid ""
"const { familySync, GLIBC, MUSL } = require('detect-libc');\n"
"\n"
"switch (familySync()) {\n"
"  case GLIBC: ...\n"
"  case MUSL: ...\n"
"  case null: ...\n"
"}\n"
msgstr ""

