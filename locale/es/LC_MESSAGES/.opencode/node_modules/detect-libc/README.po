#: ../../.opencode/node_modules/detect-libc/README.md:47
#: ../../.opencode/node_modules/detect-libc/README.md:87
#: ../../.opencode/node_modules/detect-libc/README.md:125
msgid "Resolves asychronously with:"
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:49
msgid "`glibc` or `musl` when the libc family can be determined"
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:50
#: ../../.opencode/node_modules/detect-libc/README.md:90
msgid "`null` when the libc family cannot be determined"
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:51
#: ../../.opencode/node_modules/detect-libc/README.md:91
msgid "`null` when run on a non-Linux platform"
msgstr ""

#: ../../.opencode/node_modules/detect-libc/README.md:53
#, python-brace-format
msgid ""
"const { family, GLIBC, MUSL } = require('detect-libc');\n"
"\n"
"switch (await family()) {\n"
"  case GLIBC: ...\n"
"  case MUSL: ...\n"
"  case null: ...\n"
"}\n"
msgstr ""

