#: ../../.opencode/node_modules/yaml/README.md:110
msgid "YAML.parse"
msgstr ""

#: ../../.opencode/node_modules/yaml/README.md:112
msgid ""
"# file.yml\n"
"YAML:\n"
"  - A human-readable data serialization language\n"
"  - https://en.wikipedia.org/wiki/YAML\n"
"yaml:\n"
"  - A complete JavaScript implementation\n"
"  - https://www.npmjs.com/package/yaml\n"
msgstr ""

#: ../../.opencode/node_modules/yaml/README.md:122
#, python-brace-format
msgid ""
"import fs from 'fs'\n"
"import YAML from 'yaml'\n"
"\n"
"YAML.parse('3.14159')\n"
"// 3.14159\n"
"\n"
"YAML.parse('[ true, false, maybe, null ]\\n')\n"
"// [ true, false, 'maybe', null ]\n"
"\n"
"const file = fs.readFileSync('./file.yml', 'utf8')\n"
"YAML.parse(file)\n"
"// { YAML:\n"
"//   [ 'A human-readable data serialization language',\n"
"//     'https://en.wikipedia.org/wiki/YAML' ],\n"
"//   yaml:\n"
"//   [ 'A complete JavaScript implementation',\n"
"//     'https://www.npmjs.com/package/yaml' ] }\n"
msgstr ""

#: ../../.opencode/node_modules/yaml/README.md:142
msgid "YAML.stringify"
msgstr ""

#: ../../.opencode/node_modules/yaml/README.md:144
#, python-brace-format
msgid ""
"import YAML from 'yaml'\n"
"\n"
"YAML.stringify(3.14159)\n"
"// '3.14159\\n'\n"
"\n"
"YAML.stringify([true, false, 'maybe', null])\n"
"// `- true\n"
"// - false\n"
"// - maybe\n"
"// - null\n"
"// `\n"
"\n"
"YAML.stringify({ number: 3, plain: 'string', block: 'two\\nlines\\n' })\n"
"// `number: 3\n"
"// plain: string\n"
"// block: |\n"
"//   two\n"
"//   lines\n"
"// `\n"
msgstr ""

