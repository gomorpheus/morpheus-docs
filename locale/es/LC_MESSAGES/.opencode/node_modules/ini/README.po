msgid "Un / Escape"
msgstr ""

#: ../../.opencode/node_modules/ini/README.md:169
msgid "Turn the given string into a safe to   use key or value in your INI file."
msgstr ""

#: ../../.opencode/node_modules/ini/README.md:172
msgid "safe(`\"unsafe string\"`) // -> \\\"unsafe string\\\"\n"
msgstr ""

#: ../../.opencode/node_modules/ini/README.md:176
msgid "Or reverse the process with:"
msgstr ""

#: ../../.opencode/node_modules/ini/README.md:178
msgid "unsafe(`\\\\\"safe string\\\\\"`) // -> \"safe string\"\n"
msgstr ""

