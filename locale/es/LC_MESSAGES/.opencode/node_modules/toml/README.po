#: ../../.opencode/node_modules/toml/README.md:24
msgid "Feature Support"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:26
msgid ""
"**Strings**: basic, literal, multiline, all escape sequences (`\\uXXXX`, "
"`\\UXXXXXXXX`, `\\xHH`, `\\e`)"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:27
msgid ""
"**Integers**: decimal, hexadecimal (`0xDEADBEEF`), octal (`0o755`), "
"binary (`0b11010110`)"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:28
msgid "**Floats**: decimal, scientific notation, `inf`, `-inf`, `nan`"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:29
msgid "**Booleans**: `true`, `false`"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:30
msgid ""
"**Dates/Times**: offset date-time, local date-time, local date, local "
"time; seconds optional"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:31
msgid "**Arrays**: mixed types allowed"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:32
msgid ""
"**Tables**: standard, inline (with dotted/quoted keys, newlines, trailing"
" commas), array of tables"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:33
msgid "**Keys**: bare, quoted, dotted (`fruit.apple.color = \"red\"`)"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:34
msgid "**Comments**: `# line comments`"
msgstr ""

