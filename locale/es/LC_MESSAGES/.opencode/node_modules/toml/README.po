msgid "Installation"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:39
msgid "npm install toml\n"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:43
msgid "Requires Node.js 20 or later. Zero runtime dependencies."
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:45
msgid "Usage"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:48
msgid ""
"const toml = require('toml');\n"
"const data = toml.parse(someTomlString);\n"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:53
msgid ""
"`toml.parse` throws an exception on parse errors with `line` and `column`"
" properties:"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:55
msgid ""
"try {\n"
"  toml.parse(someBadToml);\n"
"} catch (e) {\n"
"  console.error(`Parsing error on line ${e.line}, column ${e.column}: "
"${e.message}`);\n"
"}\n"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:63
msgid "Date/Time Values"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:65
msgid ""
"Offset date-times are returned as JavaScript `Date` objects. Local date-"
"times, local dates, and local times are returned as strings since they "
"have no timezone information and can't be losslessly represented as "
"`Date`:"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:67
msgid ""
"const data = toml.parse(`\n"
"odt = 1979-05-27T07:32:00Z       # Date object\n"
"ldt = 1979-05-27T07:32:00        # string: \"1979-05-27T07:32:00\"\n"
"ld  = 1979-05-27                  # string: \"1979-05-27\"\n"
"lt  = 07:32:00                    # string: \"07:32:00\"\n"
"`);\n"
"\n"
"data.odt instanceof Date  // true\n"
"typeof data.ldt            // \"string\"\n"
"typeof data.ld             // \"string\"\n"
"typeof data.lt             // \"string\"\n"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:81
msgid "Special Float Values"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:83
msgid "`inf` and `nan` are returned as JavaScript `Infinity` and `NaN`:"
msgstr ""

#: ../../.opencode/node_modules/toml/README.md:85
msgid ""
"const data = toml.parse(`\n"
"pos_inf = inf\n"
"neg_inf = -inf\n"
"not_a_number = nan\n"
"`);\n"
"\n"
"data.pos_inf === Infinity   // true\n"
"data.neg_inf === -Infinity  // true\n"
"Number.isNaN(data.not_a_number) // true\n"
msgstr ""

