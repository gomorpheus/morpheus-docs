#: ../../.opencode/node_modules/isexe/README.md:1
msgid "isexe"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:3
msgid "Minimal module to check if a file is executable, and a normal file."
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:5
msgid ""
"Uses `fs.stat` and tests against the `PATHEXT` environment variable on "
"Windows."
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:8
msgid "USAGE"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:10
msgid ""
"var isexe = require('isexe')\n"
"isexe('some-file-name', function (err, isExe) {\n"
"  if (err) {\n"
"    console.error('probably file does not exist or something', err)\n"
"  } else if (isExe) {\n"
"    console.error('this thing can be run')\n"
"  } else {\n"
"    console.error('cannot be run')\n"
"  }\n"
"})\n"
"\n"
"// same thing but synchronous, throws errors\n"
"var isExe = isexe.sync('some-file-name')\n"
"\n"
"// treat errors as just \"not executable\"\n"
"isexe('maybe-missing-file', { ignoreErrors: true }, callback)\n"
"var isExe = isexe.sync('maybe-missing-file', { ignoreErrors: true })\n"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:30
msgid "API"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:32
msgid "`isexe(path, [options], [callback])`"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:34
msgid ""
"Check if the path is executable.  If no callback provided, and a global "
"`Promise` object is available, then a Promise will be returned."
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:37
msgid ""
"Will raise whatever errors may be raised by `fs.stat`, unless "
"`options.ignoreErrors` is set to true."
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:40
msgid "`isexe.sync(path, [options])`"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:42
msgid "Same as `isexe` but returns the value and throws any errors raised."
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:44
msgid "Options"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:46
msgid ""
"`ignoreErrors` Treat all errors as \"no, this is not executable\", but "
"don't raise them."
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:48
msgid "`uid` Number to use as the user id"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:49
msgid "`gid` Number to use as the group id"
msgstr ""

#: ../../.opencode/node_modules/isexe/README.md:50
msgid ""
"`pathExt` List of path extensions to use instead of `PATHEXT` environment"
" variable on Windows."
msgstr ""

