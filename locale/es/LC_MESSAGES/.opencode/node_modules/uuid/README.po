#: ../../.opencode/node_modules/uuid/README.md:159
msgid "uuid.v1([options[, buffer[, offset]]])"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:161
msgid "Create an RFC version 1 (timestamp) UUID"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`options`]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "`Object` with one or more of the following properties:"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`options.node = (random)` ]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "RFC \"node\" field as an `Array[6]` of byte values (per 4.1.6)"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`options.clockseq = (random)`]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "RFC \"clock sequence\" as a `Number` between 0 - 0x3fff"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`options.msecs = (current time)`]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "RFC \"timestamp\" field (`Number` of milliseconds, unix epoch)"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`options.nsecs = 0`]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid ""
"RFC \"timestamp\" field (`Number` of nanoseconds to add to `msecs`, "
"should be 0-10,000)"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`options.random = (random)`]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "`Array` of 16 random bytes (0-255) used to generate other fields, above"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`options.rng`]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid ""
"Alternative to `options.random`, a `Function` that returns an `Array` of "
"16 random bytes (0-255)"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "[`buffer`]"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid ""
"`Uint8Array` or `Uint8Array` subtype (e.g. Node.js `Buffer`). If "
"provided, binary UUID is written into the array, starting at `offset`"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "`Number` Index to start writing UUID bytes in `buffer`"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "UUID `String` if no `buffer` is specified, otherwise returns `buffer`"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "`Error` if more than 10M UUIDs/sec are requested"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:178
msgid ""
"[!NOTE] The default [node "
"id](https://datatracker.ietf.org/doc/html/rfc9562#section-5.1) (the last "
"12 digits in the UUID) is generated once, randomly, on process startup, "
"and then remains unchanged for the duration of the process."
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:182
msgid ""
"[!NOTE] `options.random` and `options.rng` are only meaningful on the "
"very first call to `v1()`, where they may be passed to initialize the "
"internal `node` and `clockseq` fields."
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:187
#, python-brace-format
msgid ""
"import { v1 as uuidv1 } from 'uuid';\n"
"\n"
"uuidv1(); // ⇨ '2c5ea4c0-4067-11e9-9b5d-ab8dfbbd4bed'\n"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:193
#: ../../.opencode/node_modules/uuid/README.md:324
msgid "Example using `options`:"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:195
#, python-brace-format
msgid ""
"import { v1 as uuidv1 } from 'uuid';\n"
"\n"
"const options = {\n"
"  node: Uint8Array.of(0x01, 0x23, 0x45, 0x67, 0x89, 0xab),\n"
"  clockseq: 0x1234,\n"
"  msecs: new Date('2011-11-01').getTime(),\n"
"  nsecs: 5678,\n"
"};\n"
"uuidv1(options); // ⇨ '710b962e-041c-11e1-9234-0123456789ab'\n"
msgstr ""

