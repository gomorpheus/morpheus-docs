#: ../../.opencode/node_modules/uuid/README.md:379
msgid "uuid.validate(str)"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "`String` to validate"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md
msgid "`true` if string is a valid UUID, `false` otherwise"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:390
#, python-brace-format
msgid ""
"import { validate as uuidValidate } from 'uuid';\n"
"\n"
"uuidValidate('not a UUID'); // ⇨ false\n"
"uuidValidate('6ec0bd7f-11c0-43da-975e-2a8ad9ebae0b'); // ⇨ true\n"
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:397
msgid ""
"Using `validate` and `version` together it is possible to do per-version "
"validation, e.g. validate for only v4 UUIds."
msgstr ""

#: ../../.opencode/node_modules/uuid/README.md:399
#, python-brace-format
msgid ""
"import { version as uuidVersion } from 'uuid';\n"
"import { validate as uuidValidate } from 'uuid';\n"
"\n"
"function uuidValidateV4(uuid) {\n"
"  return uuidValidate(uuid) && uuidVersion(uuid) === 4;\n"
"}\n"
"\n"
"const v1Uuid = 'd9428888-122b-11e1-b85c-61cd3cbb3210';\n"
"const v4Uuid = '109156be-c4fb-41ea-b1b4-efe1671c5836';\n"
"\n"
"uuidValidateV4(v4Uuid); // ⇨ true\n"
"uuidValidateV4(v1Uuid); // ⇨ false\n"
msgstr ""

