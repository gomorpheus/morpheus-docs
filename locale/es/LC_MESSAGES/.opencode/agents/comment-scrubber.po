msgid "Output"
msgstr ""

#: ../../.opencode/agents/comment-scrubber.md:60
msgid ""
"Comment inventory: count by category (narrating, AI slop, WIP, stubs, "
"etc.)"
msgstr ""

#: ../../.opencode/agents/comment-scrubber.md:61
msgid "Summary of changes made"
msgstr ""

#: ../../.opencode/agents/comment-scrubber.md:62
