#: ../../.opencode/skills/root-cause-classification/SKILL.md:5
msgid "Root Cause Classification"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:7
msgid ""
"A structured approach to diagnosing bugs and classifying their root "
"causes."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:9
msgid "Classification Taxonomy"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:11
msgid ""
"Every bug falls into one of these categories. Choose the one that best "
"describes the **fundamental cause**, not the symptom."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:13
msgid "code"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:14
msgid "Logic errors in the application code itself."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:15
msgid "Off-by-one errors"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:16
msgid "Wrong conditional logic"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:17
msgid "Missing null/nil checks"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:18
msgid "Incorrect algorithm implementation"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:19
msgid "Type errors or casting issues"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:20
msgid "Missing error handling"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:22
msgid "data"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:23
msgid "Issues with data quality, format, or schema."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:24
msgid "Corrupt or unexpected data in the database"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:25
msgid "Schema migration issues"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:26
msgid "Data format mismatches between systems"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:27
msgid "Missing or stale cache entries"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:28
msgid "Encoding/serialization errors"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:30
msgid "env"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:31
msgid "Environment and infrastructure configuration."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:32
msgid "Missing or wrong environment variables"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:33
msgid "Wrong credentials or expired tokens"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:34
msgid "DNS/networking configuration"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:35
msgid "Resource limits (memory, disk, connections)"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:36
msgid "Version mismatches between environments"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:38
msgid "user"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:39
msgid "Unexpected user behavior or edge cases."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:40
msgid "Input the system doesn't handle (special characters, extreme values)"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:41
msgid "Workflow the design didn't anticipate"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:42
msgid "Concurrent actions from the same user"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:43
msgid "Browser/device-specific behavior"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:45
msgid "external"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:46
msgid "Failures in third-party services or dependencies."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:47
msgid "API breaking changes upstream"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:48
msgid "Dependency bugs"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:49
msgid "Third-party service outages or rate limits"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:50
msgid "SDK version incompatibilities"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:52
msgid "race"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:53
msgid "Concurrency and timing issues."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:54
msgid "Race conditions between goroutines/threads"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:55
msgid "Deadlocks"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:56
msgid "Timing-dependent behavior"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:57
msgid "Stale reads in distributed systems"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:58
msgid "Double-submit / duplicate processing"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:60
msgid "design"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:61
msgid "The design itself is flawed."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:62
msgid "Missing requirement in the original spec"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:63
msgid "Incorrect assumption about user behavior"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:64
msgid "Architecture doesn't handle the scale/pattern"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:65
msgid "Feature interaction not considered"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:67
msgid "Investigation Process"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:69
msgid ""
"**Reproduce** — Can you consistently trigger the bug? What's the minimal "
"reproduction?"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:70
msgid ""
"**Isolate** — What component/layer is the bug in? Use logs, debugger, or "
"tracing."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:71
msgid ""
"**Trace** — Follow the execution path from trigger to symptom. Where does"
" it diverge from expected?"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:72
msgid "**Classify** — Based on the root cause, assign a classification."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:73
msgid "**Assess** — Severity (low/medium/high/critical) and blast radius."
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:74
msgid ""
"**Fix** — Design the fix. Does it address the root cause or just the "
"symptom?"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:76
msgid "Severity Guide"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:78
msgid "**critical** — Data loss, security vulnerability, complete service outage"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:79
msgid ""
"**high** — Major feature broken, significant user impact, workaround "
"difficult"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:80
msgid ""
"**medium** — Feature partially broken, workaround exists, limited user "
"impact"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:81
msgid "**low** — Minor inconvenience, cosmetic, edge case with easy workaround"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:83
msgid "Frontmatter Fields"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:85
msgid "Add these to the bug spec:"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:87
msgid ""
"root_cause_class: code  # code, data, env, user, external, race, design\n"
"severity: medium        # low, medium, high, critical\n"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:92
msgid "Pattern Recognition"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:94
msgid "After classifying several bugs, look for patterns:"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:95
msgid "Cluster of `data` bugs → need better validation and migration testing"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:96
msgid ""
"Cluster of `env` bugs → need better config management and parity between "
"environments"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:97
msgid ""
"Cluster of `race` bugs → need concurrency review, consider adding race "
"detector to CI"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:98
msgid "Cluster of `design` bugs → specs need more thorough edge case analysis"
msgstr ""

#: ../../.opencode/skills/root-cause-classification/SKILL.md:99
msgid ""
"Cluster of `external` bugs → need better resilience patterns (retries, "
"circuit breakers, fallbacks)"
msgstr ""

