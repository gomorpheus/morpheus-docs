msgid "Pull request review guidance"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:11
msgid "Core approach"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:13
msgid "Focus on bugs, regressions, risky assumptions, and missing tests."
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:14
msgid "Review the full change scope, not just the latest diff hunk."
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:15
msgid "Consider runtime behavior, rollout behavior, and maintenance impact."
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:16
msgid "Prefer concrete findings over broad style commentary."
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:18
msgid "Review priorities"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:20
msgid "behavioral correctness"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:21
msgid "edge cases and failure paths"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:22
msgid "test coverage and validation quality"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:23
msgid "security, migration, and operational risk where relevant"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:24
msgid "consistency with existing architecture and conventions"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:26
msgid "Guardrails"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:28
msgid "findings first, summary later"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:29
msgid "prioritize by severity"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:30
msgid "cite evidence where possible"
msgstr ""

#: ../../.opencode/skills/pr-review/SKILL.md:31
msgid "explicitly say when no meaningful findings were discovered"
msgstr ""

