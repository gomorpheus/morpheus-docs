#: ../../.opencode/skills/performance-optimization/SKILL.md:9
msgid "Performance optimization"
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:11
msgid "Core approach"
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:13
msgid "Measure before and after when feasible."
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:14
msgid "Focus on actual bottlenecks and workload behavior."
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:15
msgid ""
"Prefer clear changes with material impact over complex micro-"
"optimizations."
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:16
msgid "Keep maintainability in view while improving performance."
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:18
msgid "Practical guidance"
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:20
msgid ""
"Consider data volume, latency, allocation, concurrency, rendering cost, "
"query shape, and caching behavior where relevant."
msgstr ""

#: ../../.opencode/skills/performance-optimization/SKILL.md:21
msgid "Call out assumptions behind measurements and likely next bottlenecks."
msgstr ""

