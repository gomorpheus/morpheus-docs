#: ../../.opencode/skills/python-stack/SKILL.md:9
msgid "Focus areas"
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:11
msgid ""
"Use type hints consistently (PEP 484/526/604). Prefer `str | None` over "
"`Optional[str]` in Python 3.10+."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:12
msgid ""
"Structure projects with clear package boundaries: `src/` layout or flat "
"layout, consistent `__init__.py` usage."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:13
msgid ""
"Prefer `pyproject.toml` over `setup.py` / `setup.cfg` for project "
"metadata and build configuration."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:14
msgid ""
"Use virtual environments (`venv`, `uv`, or `poetry`) — never install into"
" the system Python."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:15
msgid ""
"Handle errors explicitly: catch specific exceptions, avoid bare "
"`except:`, use custom exception hierarchies when the domain warrants it."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:17
msgid "Dependency management"
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:19
msgid ""
"Pin dependencies for applications (lock files via `pip-compile`, "
"`poetry.lock`, or `uv.lock`)."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:20
msgid "Use version ranges for libraries."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:21
msgid "Prefer standard library when it covers the need adequately."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:22
msgid "Audit transitive dependencies when adding new packages."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:24
msgid "Testing"
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:26
msgid "Use `pytest` as the default test runner."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:27
msgid "Prefer fixtures over setup/teardown methods."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:28
msgid ""
"Use `unittest.mock` or `pytest-mock` for mocking — mock at boundaries, "
"not internals."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:29
msgid "Structure tests to mirror source layout: `tests/` parallel to `src/`."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:30
msgid ""
"Use `parametrize` for data-driven tests rather than duplicating test "
"functions."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:32
msgid "Async"
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:34
msgid ""
"Use `asyncio` for I/O-bound concurrency. Do not use threads for I/O "
"unless interacting with blocking libraries."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:35
msgid "Prefer `async`/`await` over callback patterns."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:36
msgid "Use `asyncio.TaskGroup` (3.11+) or `asyncio.gather` for concurrent tasks."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:37
msgid ""
"Avoid mixing sync and async code — use `asyncio.to_thread` when calling "
"blocking functions from async context."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:39
msgid "Guardrails"
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:41
msgid "Avoid mutable default arguments (`def f(x=[])` is a classic bug)."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:42
msgid "Avoid global mutable state."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:43
msgid ""
"Prefer `dataclasses` or `pydantic` models over raw dicts for structured "
"data."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:44
msgid "Use `pathlib.Path` over `os.path` for file system operations."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:45
msgid "Prefer f-strings over `%` formatting or `.format()`."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:46
msgid ""
"Watch for import cycles — restructure packages rather than using lazy "
"imports as a workaround."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:47
msgid "Use `logging` module, not `print()`, for operational output."
msgstr ""

#: ../../.opencode/skills/python-stack/SKILL.md:48
msgid ""
"Be explicit about encoding when reading/writing files (`open(..., "
"encoding=\"utf-8\")`)."
msgstr ""

