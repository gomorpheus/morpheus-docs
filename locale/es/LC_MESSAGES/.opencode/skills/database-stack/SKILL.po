#: ../../.opencode/skills/database-stack/SKILL.md:11
msgid "Treat schema and data changes as operational changes."
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:12
msgid "Prefer additive, phased migrations when possible."
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:13
msgid "Watch query shape, index tradeoffs, and lock behavior."
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:14
msgid "Design backfills and repair paths to be resumable and idempotent."
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:15
msgid "Keep application changes and data changes sequenced safely."
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:17
msgid "Guardrails"
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:19
msgid ""
"Call out expensive migrations, risky rollouts, and data consistency "
"assumptions."
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:20
msgid "Avoid destructive changes without a clear deployment and rollback plan."
msgstr ""

#: ../../.opencode/skills/database-stack/SKILL.md:21
msgid "Be explicit about coordination between code deploys and data changes."
msgstr ""

