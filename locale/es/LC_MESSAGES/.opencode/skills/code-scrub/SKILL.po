#: ../../.opencode/skills/code-scrub/SKILL.md:81
msgid "Verification"
msgstr ""

#: ../../.opencode/skills/code-scrub/SKILL.md:83
msgid "After every change:"
msgstr ""

#: ../../.opencode/skills/code-scrub/SKILL.md:84
msgid "Build must pass"
msgstr ""

#: ../../.opencode/skills/code-scrub/SKILL.md:85
msgid "Tests must pass"
msgstr ""

#: ../../.opencode/skills/code-scrub/SKILL.md:86
msgid "No new warnings introduced"
msgstr ""

#: ../../.opencode/skills/code-scrub/SKILL.md:88
msgid ""
"If build or tests fail after a change, **revert and document** — don't "
"fix forward during a scrub."
msgstr ""

