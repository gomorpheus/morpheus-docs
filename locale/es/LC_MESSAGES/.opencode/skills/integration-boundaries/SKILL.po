#: ../../.opencode/skills/integration-boundaries/SKILL.md:9
msgid "Integration boundaries"
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:11
msgid "Core approach"
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:13
msgid "Treat integration points as failure-prone boundaries."
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:14
msgid "Design for retries, idempotency, timeouts, and partial failure."
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:15
msgid "Keep authentication, rate limiting, and data-shape assumptions explicit."
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:16
msgid "Preserve observability across boundaries."
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:18
msgid "Practical guidance"
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:20
msgid ""
"Make boundary behavior visible through logs, metrics, tracing, or other "
"diagnostics when possible."
msgstr ""

#: ../../.opencode/skills/integration-boundaries/SKILL.md:21
msgid "Prefer simple, testable integration seams over abstraction-heavy wrappers."
msgstr ""

