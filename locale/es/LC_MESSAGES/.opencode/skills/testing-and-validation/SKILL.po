#: ../../.opencode/skills/testing-and-validation/SKILL.md:9
msgid "What I do"
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:11
msgid ""
"Provide consistent guidance for validating changes and improving delivery"
" confidence."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:13
msgid "Core principles"
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:15
msgid "Run the most relevant validation available for the change."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:16
msgid "Prefer focused, high-signal tests over broad, expensive rituals."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:17
msgid "Tie validation to the behavior being changed."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:18
msgid "Distinguish verified behavior from assumed behavior."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:19
msgid "Report residual risk clearly when validation is incomplete."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:21
msgid "Practical guidance"
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:23
msgid "Add or update automated tests when the change materially affects behavior."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:24
msgid ""
"Prefer unit tests for isolated logic, integration tests for boundaries, "
"and end-to-end checks for user-critical flows."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:25
msgid ""
"If full validation is not possible, explain what was checked and what "
"remains uncertain."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:26
msgid ""
"Watch for brittle tests, missing fixtures, poor observability, and "
"unverified failure paths."
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:28
msgid "When to use me"
msgstr ""

#: ../../.opencode/skills/testing-and-validation/SKILL.md:30
msgid ""
"Use this skill whenever code changes need validation, test design, or "
"quality assessment."
msgstr ""

