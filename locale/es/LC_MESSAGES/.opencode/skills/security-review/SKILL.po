#: ../../.opencode/skills/security-review/SKILL.md:9
msgid "Core approach"
msgstr ""

#: ../../.opencode/skills/security-review/SKILL.md:11
msgid "Focus on meaningful security risk, not checkbox compliance language."
msgstr ""

#: ../../.opencode/skills/security-review/SKILL.md:12
msgid ""
"Review trust boundaries, data exposure, authn/authz paths, and risky "
"defaults."
msgstr ""

#: ../../.opencode/skills/security-review/SKILL.md:13
msgid "Prioritize concrete findings by severity and exploitability."
msgstr ""

#: ../../.opencode/skills/security-review/SKILL.md:14
msgid "Distinguish confirmed issues from areas needing more evidence."
msgstr ""

#: ../../.opencode/skills/security-review/SKILL.md:16
msgid "Practical guidance"
msgstr ""

#: ../../.opencode/skills/security-review/SKILL.md:18
msgid ""
"Examine authentication, authorization, secrets, injection surfaces, "
"deserialization, file handling, external calls, and dependency risk where"
" relevant."
msgstr ""

#: ../../.opencode/skills/security-review/SKILL.md:19
msgid "Consider both code-level issues and operational exposure."
msgstr ""

