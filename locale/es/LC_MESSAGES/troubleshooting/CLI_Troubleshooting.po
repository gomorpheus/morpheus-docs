#: ../../troubleshooting/CLI_Troubleshooting.rst:2
msgid "CLI Troubleshooting"
msgstr "Solución de problemas de CLI"

#: ../../troubleshooting/CLI_Troubleshooting.rst:4
msgid ""
"If you have installed the |morpheus| CLI successfully and get a "
"successful login but see this error ``Error Communicating with the "
"Appliance. SSL_connect returned=1 errno=0 state=error: certificate verify"
" failed``"
msgstr ""
"Si ha instalado la CLI de |morpheus| correctamente y obtiene un inicio de "
"sesión exitoso pero ve este error ``Error Communicating with the "
"Appliance. SSL_connect returned=1 errno=0 state=error: certificate verify"
" failed``"

#: ../../troubleshooting/CLI_Troubleshooting.rst:6
msgid "run the command"
msgstr "ejecute el comando"

#: ../../troubleshooting/CLI_Troubleshooting.rst:8
#, python-brace-format
msgid "morpheus remote update {appliancename} --insecure"
msgstr "morpheus remote update {appliancename} --insecure"

