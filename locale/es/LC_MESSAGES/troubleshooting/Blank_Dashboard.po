#: ../../troubleshooting/Blank_Dashboard.rst:2
msgid "Blank Dashboard"
msgstr "Panel de control en blanco"

#: ../../troubleshooting/Blank_Dashboard.rst:5
msgid "Problem"
msgstr "Problema"

#: ../../troubleshooting/Blank_Dashboard.rst:5
msgid "A blank dashboard or 500 error after installing morpheus"
msgstr "Un panel de control en blanco o error 500 después de instalar Morpheus"

#: ../../troubleshooting/Blank_Dashboard.rst:7
msgid ""
"A blank or 500 error on just the dashboard is different than the entire "
"morpheus-ui not loading. Please see UI note loading article for "
"troubleshooting the ui not loading after an upgrade."
msgstr ""
"Un error en blanco o 500 solo en el panel de control es diferente a que "
"toda la interfaz de Morpheus no cargue. Consulte el artículo sobre la "
"interfaz que no carga para solucionar problemas de la interfaz que no "
"carga después de una actualización."

#: ../../troubleshooting/Blank_Dashboard.rst:10
msgid "Cause"
msgstr "Causa"

#: ../../troubleshooting/Blank_Dashboard.rst:10
msgid ""
"Elasticsearch restarting prior to being fully bootstrapped during the "
"initial install."
msgstr ""
"Elasticsearch se reinició antes de estar completamente inicializado durante "
"la instalación inicial."

#: ../../troubleshooting/Blank_Dashboard.rst:13
msgid "Solution"
msgstr "Solución"

#: ../../troubleshooting/Blank_Dashboard.rst:13
msgid ""
"To fix, purge elasticsearch by running the following on the |morpheus| "
"Appliance:"
msgstr ""
"Para solucionar, purgue Elasticsearch ejecutando lo siguiente en el "
"Appliance de |morpheus|:"

#: ../../troubleshooting/Blank_Dashboard.rst:15
msgid ""
"curl -XDELETE http://localhost:9200/*\n"
"morpheus-ctl restart elasticsearch\n"
"morpheus-ctl restart morpheus-ui"
msgstr ""
"curl -XDELETE http://localhost:9200/*\nmorpheus-ctl restart "
"elasticsearch\nmorpheus-ctl restart morpheus-ui"

#: ../../troubleshooting/Blank_Dashboard.rst:21
msgid "Another option is:"
msgstr "Otra opción es:"

#: ../../troubleshooting/Blank_Dashboard.rst:23
msgid ""
"sudo rm –rf /var/opt/|morpheus| /elasticsearch/data/morpheus\n"
"morpheus-ctl restart elasticsearch\n"
"morpheus-ctl restart morpheus-ui"
msgstr ""
"sudo rm –rf /var/opt/|morpheus| /elasticsearch/data/morpheus\nmorpheus-ctl "
"restart elasticsearch\nmorpheus-ctl restart morpheus-ui"

#: ../../troubleshooting/Blank_Dashboard.rst:29
msgid "If you get a term/timeout on ui restart, run"
msgstr "Si obtiene un error de término/tiempo de espera al reiniciar la interfaz, ejecute"

#: ../../troubleshooting/Blank_Dashboard.rst:31
msgid ""
"morpheus-ctl kill morpheus-ui\n"
"morpheus-ctl start morpheus-ui"
msgstr "morpheus-ctl kill morpheus-ui\nmorpheus-ctl start morpheus-ui"

#: ../../troubleshooting/Blank_Dashboard.rst:37
msgid ""
"The morpheus-ui may take a few minutes to load and be available after "
"being restarted"
msgstr ""
"La interfaz morpheus-ui puede tardar unos minutos en cargar y estar "
"disponible después de ser reiniciada"

