#: ../../getting_started/installation/3_node_ha/3_node_ha_morpheus_rb.rst:15
#, python-brace-format
msgid ""
"appliance_url 'https://morpheus.localdomain'\n"
"elasticsearch['es_hosts'] = {'192.168.104.01' => 9200, '192.168.104.02' "
"=> 9200, '192.168.104.03' => 9200}\n"
"elasticsearch['node_name'] = '192.168.104.01'\n"
"elasticsearch['host'] = '0.0.0.0'\n"
"rabbitmq['host'] = '0.0.0.0'\n"
"rabbitmq['nodename'] = 'rabbit@node01'\n"
"mysql['enable'] = false\n"
"mysql['host'] = {'127.0.0.1' => 6446}\n"
"mysql['morpheus_db'] = 'morpheus'\n"
"mysql['morpheus_db_user'] = 'morpheus'\n"
"mysql['morpheus_password'] = 'morpheusDbUserPassword'\n"
"user['uid'] = 899\n"
"user['gid'] = 899\n"
"# at the time of this writing, local_user is not valid as an option so "
"the full entry is needed\n"
"node.default['morpheus_solo']['local_user']['uid'] = 898\n"
"node.default['morpheus_solo']['local_user']['gid'] = 898\n"
"elasticsearch['uid'] = 896\n"
"elasticsearch['gid'] = 896\n"
"rabbitmq['uid'] = 895\n"
"rabbitmq['gid'] = 895\n"
"guacd['uid'] = 894\n"
"guacd['gid'] = 894"
msgstr ""
"appliance_url 'https://morpheus.localdomain'\\nelasticsearch['es_hosts'] = "
"{'192.168.104.01' => 9200, '192.168.104.02' => 9200, '192.168.104.03' => "
"9200}\\nelasticsearch['node_name'] = "
"'192.168.104.01'\\nelasticsearch['host'] = '0.0.0.0'\\nrabbitmq['host'] = "
"'0.0.0.0'\\nrabbitmq['nodename'] = 'rabbit@node01'\\nmysql['enable'] = "
"false\\nmysql['host'] = {'127.0.0.1' => 6446}\\nmysql['morpheus_db'] = "
"'morpheus'\\nmysql['morpheus_db_user'] = "
"'morpheus'\\nmysql['morpheus_password'] = "
"'morpheusDbUserPassword'\\nuser['uid'] = 899\\nuser['gid'] = 899\\n# at "
"the time of this writing, local_user is not valid as an option so the full "
"entry is needed\\nnode.default['morpheus_solo']['local_user']['uid'] = "
"898\\nnode.default['morpheus_solo']['local_user']['gid'] = "
"898\\nelasticsearch['uid'] = 896\\nelasticsearch['gid'] = "
"896\\nrabbitmq['uid'] = 895\\nrabbitmq['gid'] = 895\\nguacd['uid'] = "
"894\\nguacd['gid'] = 894"

