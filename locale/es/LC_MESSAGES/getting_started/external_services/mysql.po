#: ../../getting_started/external_services/mysql.rst:4
msgid "MySQL"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:6
msgid ""
"MySQL is the transactional database for |morpheus|, storing all "
"operational data including Instances, users, tenants, policies, "
"automation configurations, and billing records. This page covers "
"preparing an external MySQL service for use with |morpheus|."
msgstr ""

#: ../../getting_started/external_services/mysql.rst:8
msgid "Note"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:10
msgid ""
"For HVM deployments and all-in-one installations, MySQL is embedded and "
"requires no configuration. This page is only relevant when running MySQL "
"externally for HA, managed database services, or organizational "
"requirements."
msgstr ""

#: ../../getting_started/external_services/mysql.rst:13
msgid "Supported Versions"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:15
msgid "**MySQL 8.4.8** (embedded in |morpheus| 9.0.0)"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:16
msgid "**MySQL 8.0.x FIPS** (|mysqlverfips|)"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:18
msgid ""
"The appliance supports configuration of an external MySQL service, "
"including the 8.4 LTS family. Configuration support does not by itself "
"certify every MySQL patch, managed-service variant, later major version, "
"or innovation release. Confirm the certified external versions in the "
"compatibility information for the specific |morpheus| release before "
"installation or upgrade; ``8.4 or greater`` is not an unconditional "
"compatibility statement."
msgstr ""

#: ../../getting_started/external_services/mysql.rst:20
#: ../../getting_started/external_services/mysql.rst:149
msgid "Important"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:22
msgid ""
"|morpheus| requires the ``utf8mb4`` character set and "
"``utf8mb4_general_ci`` collation. Ensure your external MySQL instance is "
"configured accordingly."
msgstr ""

#: ../../getting_started/external_services/mysql.rst:25
msgid "When to Externalize"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:27
msgid "Consider running MySQL externally when:"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:29
msgid ""
"You need **high availability** with multi-master replication or InnoDB "
"Cluster"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:30
msgid ""
"You want to use a **managed database service** (e.g., Amazon RDS, Azure "
"Database for MySQL, Google Cloud SQL)"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:31
msgid ""
"Your organization requires databases to be **managed by a dedicated DBA "
"team**"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:32
msgid "You need **cross-region replication** for disaster recovery"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:33
msgid ""
"The appliance's all-in-one footprint is constrained and you want to "
"offload database I/O"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:36
msgid "Preparing the External Database"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:38
msgid ""
"Perform the following on your external MySQL host or cluster to prepare "
"it for |morpheus|."
msgstr ""

#: ../../getting_started/external_services/mysql.rst:40
msgid "**Step 1 — Create the database**"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:42
msgid "CREATE DATABASE morpheus CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:46
msgid "**Step 2 — Create the Morpheus database user**"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:48
msgid ""
"This user will be used by |morpheus| application nodes to authenticate "
"with MySQL:"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:50
msgid "CREATE USER 'morpheus'@'%' IDENTIFIED BY '<secure-password>';"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:54
msgid "**Step 3 — Grant permissions**"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:56
msgid ""
"GRANT ALL PRIVILEGES ON morpheus.* TO 'morpheus'@'%' WITH GRANT OPTION;\n"
"GRANT SELECT, PROCESS, SHOW DATABASES, RELOAD ON *.* TO 'morpheus'@'%';\n"
"FLUSH PRIVILEGES;"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:62
msgid "Tip"
msgstr ""

#: ../../getting_started/external_services/mysql.rst:64
msgid ""
"Replace ``'%'`` with specific appliance node IPs for tighter security "
"(e.g., ``'morpheus'@'10.0.0.%'``)."
msgstr ""

