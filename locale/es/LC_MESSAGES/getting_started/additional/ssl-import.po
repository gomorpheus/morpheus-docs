#: ../../getting_started/additional/ssl-import.rst:2
msgid "Import Trusted Certificates"
msgstr "Import Trusted Certificates"

#: ../../getting_started/additional/ssl-import.rst:4
msgid "The following applies to upgrades after modifying the java keystore."
msgstr "The following applies to upgrades after modifying the java keystore."

#: ../../getting_started/additional/ssl-import.rst:6
msgid "Steps to import trusted certificates to |morpheus| after an upgrade."
msgstr "Steps importar trusted certificates to |morpheus| después de an upgrade."

#: ../../getting_started/additional/ssl-import.rst:8
msgid "Obtain the full SSL certificate chain in PEM format."
msgstr "Obtain the full certificado SSL chain in PEM format."

#: ../../getting_started/additional/ssl-import.rst:10
msgid ""
"Copy them to each appliance and place them in the "
"``/etc/morpheus/ssl/trusted_certs`` directory."
msgstr ""
"Copy them to each appliance y place them in the "
"``/etc/morpheus/ssl/trusted_certs`` directory."

#: ../../getting_started/additional/ssl-import.rst:12
msgid ""
"Run morpheus-ctl reconfigure on each appliance, note you don’t need to "
"stop Morpheus before you run this."
msgstr ""
"Run morpheus-ctl reconfigure on each appliance, note you don’t necesita "
"stop Morpheus antes de you run this."

#: ../../getting_started/additional/ssl-import.rst:14
msgid "Run the following command as root:"
msgstr "Run el siguiente comando as root:"

#: ../../getting_started/additional/ssl-import.rst:16
msgid ""
"export "
"PATH=/opt/morpheus/sbin:/opt/morpheus/sbin:/opt/morpheus/embedded/sbin:/opt/morpheus/embedded/bin:$PATH"
msgstr ""
"export "
"PATH=/opt/morpheus/sbin:/opt/morpheus/sbin:/opt/morpheus/embedded/sbin:/opt/morpheus/embedded/bin:$PATH"

#: ../../getting_started/additional/ssl-import.rst:20
msgid ""
"Run the following command for each certificate in the chain, adjusting "
"the file and alias name as needed. Answer yes for the root certificate "
"when asked it you want to trust it."
msgstr ""
"Run el siguiente comando for each certificate in the chain, adjusting el "
"archivo y alias name as needed. Answer yes for the root certificate when "
"asked it you want to trust it."

#: ../../getting_started/additional/ssl-import.rst:22
msgid ""
"/opt/morpheus/embedded/java/jre/bin/keytool -import -keystore "
"/opt/morpheus/embedded/java/jre/lib/security/cacerts -trustcacerts -file "
"/etc/morpheus/ssl/trusted_certs/root_ca.pem -alias some_alias -storepass "
"changeit"
msgstr ""
"/opt/morpheus/embedded/java/jre/bin/keytool -import -keystore "
"/opt/morpheus/embedded/java/jre/lib/security/cacerts -trustcacerts -file "
"/etc/morpheus/ssl/trusted_certs/root_ca.pem -alias some_alias -storepass "
"changeit"

#: ../../getting_started/additional/ssl-import.rst:26
msgid "Verify by running:"
msgstr "Verify by running:"

#: ../../getting_started/additional/ssl-import.rst:28
msgid "openssl s_client -connect host:port -showcerts -tls1_2"
msgstr "openssl s_client -connect host:port -showcerts -tls1_2"

