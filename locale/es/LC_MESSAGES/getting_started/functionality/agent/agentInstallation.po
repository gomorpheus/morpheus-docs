#: ../../troubleshooting/Morpheus_Agent.rst:153
msgid ""
"You can use the following to uninstall the linux agent (contains commands"
" for both rpm and deb agents)"
msgstr ""
"You can use lo siguiente to uninstall the linux agent (contains commands "
"for both rpm y deb agents)"

#: ../../troubleshooting/Morpheus_Agent.rst:155
msgid ""
"sudo rm /etc/apt/sources.list.d/morpheus.list \\\n"
"sudo morpheus-node-ctl kill \\\n"
"sudo apt-get -y purge morpheus-node \\\n"
"sudo apt-get -y purge morpheus-vm-node \\\n"
"sudo yum -y remove morpheus-node \\\n"
"sudo yum -y remove morpheus-vm-node \\\n"
"sudo yum clean all \\\n"
"sudo systemctl stop morpheus-node-runsvdir \\\n"
"sudo rm -f /etc/systemd/system/morpheus-node-runsvdir.service \\\n"
"sudo systemctl daemon-reload \\\n"
"sudo rm -rf /var/run/morpheus-node \\\n"
"sudo rm -rf /opt/morpheus-node \\\n"
"sudo rm -rf /etc/morpheus \\\n"
"sudo rm -rf /var/log/morpheus-node \\\n"
"sudo pkill runsv \\\n"
"sudo pkill runsvdir \\\n"
"sudo pkill morphd \\\n"
"sudo usermod -l morpheus-old morpheus-node \\"
msgstr ""
"sudo rm /etc/apt/sources.list.d/morpheus.list \\\\\\nsudo morpheus-node-"
"ctl kill \\\\\\nsudo apt-get -y purge morpheus-node \\\\\\nsudo apt-get "
"-y purge morpheus-vm-node \\\\\\nsudo yum -y remove morpheus-node "
"\\\\\\nsudo yum -y remove morpheus-vm-node \\\\\\nsudo yum clean all "
"\\\\\\nsudo systemctl stop morpheus-node-runsvdir \\\\\\nsudo rm -f "
"/etc/systemd/system/morpheus-node-runsvdir.service \\\\\\nsudo systemctl "
"daemon-reload \\\\\\nsudo rm -rf /var/run/morpheus-node \\\\\\nsudo rm "
"-rf /opt/morpheus-node \\\\\\nsudo rm -rf /etc/morpheus \\\\\\nsudo rm "
"-rf /var/log/morpheus-node \\\\\\nsudo pkill runsv \\\\\\nsudo pkill "
"runsvdir \\\\\\nsudo pkill morphd \\\\\\nsudo usermod -l morpheus-old "
"morpheus-node \\\\"

