"  vpc_options = {\n"
"    region = \"<%=customOptions.awsRegion%>\"\n"
"    aws_account = \"<%=customOptions.awsAccount%>\"\n"
"  }\n"
"}"
msgstr ""
"locals {\\n  #  Common tags to be assigned to all resources\\n  "
"default_tags = {\\n    Owner    = \\\"<%=username%>\\\"\\n    Group = "
"\\\"<%=groupName%>\\\"\\n    Management_Tool = \\\"Terraform\\\"\\n    "
