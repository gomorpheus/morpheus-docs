#: ../../getting_started/guides/terraform_instances.rst:34
msgid ""
"# This spec template creates AWS subnets based on the count requested "
"utilizing the vpc cidr provided in var.vpc_cidr variable\n"
"\n"
"locals {\n"
"  bitCount = "
"sum([tonumber(local.subnet_options.cidrMask),-tonumber(split(\"/\",var.vpc_cidr)[1])])"
"\n"
"}\n"
"\n"
"resource \"aws_subnet\" \"main\" {\n"
"    count = tonumber(var.subnetCount)\n"
"    vpc_id     = aws_vpc.main.id\n"
"    cidr_block = cidrsubnet(var.vpc_cidr, local.bitCount, count.index)\n"
"\n"
"    tags = merge(\n"
"        local.default_tags,\n"
"        {\n"
"        Name = \"${var.vpc_name}-subnet-0${count.index}\"\n"
"        }\n"
"    )\n"
"}\n"
"\n"
"output \"aws_subnet\" {\n"
"  value = aws_subnet.main\n"
"  sensitive = true\n"
"}"
msgstr ""
"# This spec template creates AWS subnets basado en the count requested "
"utilizing the vpc cidr provided in var.vpc_cidr variable\\n\\nlocals {\\n"
"  bitCount = "
"sum([tonumber(local.subnet_options.cidrMask),-tonumber(split(\\\"/\\\",var.vpc_cidr)[1])])\\n}\\n\\nresource"
" \\\"aws_subnet\\\" \\\"main\\\" {\\n    count = "
"tonumber(var.subnetCount)\\n    vpc_id     = aws_vpc.main.id\\n    "
"cidr_block = cidrsubnet(var.vpc_cidr, local.bitCount, count.index)\\n\\n"
"   tags = merge(\\n        local.default_tags,\\n        {\\n        Name"
" = \\\"${var.vpc_name}-subnet-0${count.index}\\\"\\n        }\\n    "
")\\n}\\n\\noutput \\\"aws_subnet\\\" {\\n  value = aws_subnet.main\\n  "
"sensitive = true\\n}"

#: ../../getting_started/guides/terraform_instances.rst:62
#, python-brace-format
msgid ""
"variable \"access_key\" {\n"
"  type        = string\n"
"}\n"
"\n"
"variable \"secret_key\" {\n"
"  type        = string\n"
"}\n"
"\n"
"variable \"subnetCount\" {\n"
"  type = number\n"
"  default = \"<%=customOptions.subnetCount%>\"\n"
"}\n"
"\n"
"variable \"sensitive_thing\" {\n"
"  type = string\n"
"  default = \"this_var_is_sensitive\"\n"
"  sensitive = true\n"
"}"
msgstr ""
"variable \\\"access_key\\\" {\\n  type        = string\\n}\\n\\nvariable "
"\\\"secret_key\\\" {\\n  type        = string\\n}\\n\\nvariable "
"\\\"subnetCount\\\" {\\n  type = number\\n  predeterminado = "
"\\\"<%=customOptions.subnetCount%>\\\"\\n}\\n\\nvariable "
"\\\"sensitive_thing\\\" {\\n  type = string\\n  predeterminado = "
"\\\"this_var_is_sensitive\\\"\\n  sensitive = true\\n}"

#: ../../getting_started/guides/terraform_instances.rst:85
msgid ""
"terraform {\n"
"  required_providers {\n"
"    aws = {\n"
"      source = \"hashicorp/aws\"\n"
"      version = \">= 3.35.0\"\n"
"    }\n"
"  }\n"
"}\n"
"\n"
"provider \"aws\" {\n"
"  region     = local.vpc_options.region\n"
"  access_key = var.access_key\n"
"  secret_key = var.secret_key\n"
"\n"
"  assume_role {\n"
"    # The role ARN within Account B to AssumeRole into.\n"
"    role_arn = "
"\"arn:aws:iam::${local.vpc_options.aws_account}:role/OrganizationAccountAccessRole\""
"\n"
"  }\n"
"}"
msgstr ""
"terraform {\\n  required_providers {\\n    aws = {\\n      source = "
"\\\"hashicorp/aws\\\"\\n      version = \\\">= 3.35.0\\\"\\n    }\\n  "
"}\\n}\\n\\nprovider \\\"aws\\\" {\\n  region     = "
"local.vpc_options.region\\n  access_key = var.access_key\\n  secret_key ="
" var.secret_key\\n\\n  assume_role {\\n    # El rol ARN dentro de Account"
" B to AssumeRole into.\\n    role_arn = "
"\\\"arn:aws:iam::${local.vpc_options.aws_account}:role/OrganizationAccountAccessRole\\\"\\n"
" }\\n}"

#: ../../getting_started/guides/terraform_instances.rst:109
msgid ""
