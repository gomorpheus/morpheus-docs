"mysql.db WHERE Db='test' \\\nOR Db='test\\_%';\"\nmysql -u root -p$RPass-e "
"\"FLUSH PRIVILEGES;\"\n\n#Create the SuiteCRM User\nmysql -u root "
"-p$RPass-e \"CREATE User '$SCRMUser'@'localhost' \\\nIDENTIFIED BY "
