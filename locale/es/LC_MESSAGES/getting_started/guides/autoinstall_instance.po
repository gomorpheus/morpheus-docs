"key in short_open_tag memory_limit upload_max_filesize "
"max_execution_time\ndo\n  sed -i \"s/^\\($key\\).*/\\1 $(eval echo = "
"\\${$key})/\" \\\n/etc/php/$PHP_VERSION/apache2/php.ini\ndone\n\n#Restart "
"apache\nsystemctl restart apache2.service\n\n#Test file created for "
"debugging\necho \"<?php phpinfo( ); ?>\" | sudo tee "
"/var/www/html/phpinfo.php\n\n#Download y install latest SuiteCRM. Composer "
