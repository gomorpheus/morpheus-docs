#: ../../provisioning/automation/ansible_tower_job.rst:4
msgid "Ansible Tower Job Task"
msgstr "Ansible Tower Job Tarea"

#: ../../provisioning/automation/ansible_tower_job.rst:7
msgid "Overview"
msgstr "Descripción general"

#: ../../provisioning/automation/ansible_tower_job.rst:9
msgid ""
"The Ansible Tower Job Task type integrates |morpheus| automation with "
"Ansible Tower (Red Hat Ansible Automation Platform). This Task relays "
"Ansible calls to an Ansible Tower server, executing Job Templates against"
" |morpheus|-managed Instances and infrastructure."
msgstr ""
"El/La Ansible Tower Job Tarea tipo integrates |morpheus| automation con "
"Ansible Tower (Red Hat Ansible Automation Platform). Este Tarea relays "
"Ansible calls a un Ansible Tower servidor, executing Job Plantillas "
"against |morpheus|-managed Instancias y infraestructura."

