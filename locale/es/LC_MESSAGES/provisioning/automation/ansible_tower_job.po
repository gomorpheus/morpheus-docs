msgstr "Mode"

#: ../../provisioning/automation/ansible_tower_job.rst:76
msgid "Behavior"
msgstr "Behavior"

#: ../../provisioning/automation/ansible_tower_job.rst:77
msgid "Limit to Instance"
msgstr "Limit to Instancia"

#: ../../provisioning/automation/ansible_tower_job.rst:78
msgid ""
"The Job Template runs with ``--limit`` set to the provisioned Instance "
"hostname. Only the specific Instance is affected."
msgstr ""
"El/La Job Plantilla runs con ``--limit`` establecer a el/la provisioned "
"Instancia hostname. Solo el/la specific Instancia es affected."

#: ../../provisioning/automation/ansible_tower_job.rst:79
msgid "Limit to Group"
msgstr "Limit a Group"

#: ../../provisioning/automation/ansible_tower_job.rst:80
msgid ""
"The Job Template runs with ``--limit`` set to the Group name. All hosts "
"in the Group are affected."
msgstr ""
"El/La Job Plantilla runs con ``--limit`` establecer a el/la Group nombre."
" Todos hosts en el/la Group son affected."

#: ../../provisioning/automation/ansible_tower_job.rst:81
msgid "Run for All"
msgstr "Ejecutar para Todos"

#: ../../provisioning/automation/ansible_tower_job.rst:82
msgid ""
"The Job Template runs against the entire Inventory without limits. All "
"hosts are affected."
msgstr ""
"El/La Job Plantilla runs against el/la entire Inventory without limits. "
"Todos hosts son affected."

#: ../../provisioning/automation/ansible_tower_job.rst:83
msgid "Skip Execution"
msgstr "Skip Execution"

#: ../../provisioning/automation/ansible_tower_job.rst:84
msgid ""
"The Instance is added to the Inventory and Group but no Job Template is "
"launched. Useful for registration-only scenarios."
msgstr ""
"El/La Instancia es added a el/la Inventory y Group pero no Job Plantilla "
"es launched. Useful para registration-solo scenarios."

