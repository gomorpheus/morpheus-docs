#: ../../provisioning/automation/ansible_tower_job.rst:15
msgid "Compliance enforcement and remediation"
msgstr "Compliance enforcement y remediation"

#: ../../provisioning/automation/ansible_tower_job.rst:16
msgid "Operational automation (patching, updates, health checks)"
msgstr "Operational automation (patching, updates, health checks)"

