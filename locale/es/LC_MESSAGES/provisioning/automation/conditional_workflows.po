#: ../../provisioning/automation/conditional_workflows.rst:55
msgid "Simple Comparisons"
msgstr "Simple Comparisons"

#: ../../provisioning/automation/conditional_workflows.rst:57
msgid ""
"// Check instance type\n"
"\"<%= instance.instanceTypeName %>\" === \"nginx\"\n"
"\n"
"// Check cloud type\n"
"\"<%= zone.zoneType.code %>\" === \"vmware\"\n"
"\n"
"// Numeric comparison\n"
"parseInt(\"<%= instance.maxMemory %>\") > 1073741824"
msgstr ""
"// Check instancia type\n"
"\"<%= instancia.instanceTypeName %>\" === \"nginx\"\n"
"\n"
"// Check cloud type\n"
"\"<%= zone.zoneType.code %>\" === \"vmware\"\n"
"\n"
"// Numeric comparison\n"
"parseInt(\"<%= instancia.maxMemory %>\") > 1073741824"

#: ../../provisioning/automation/conditional_workflows.rst:69
msgid "Variable References"
msgstr "Variable References"

#: ../../provisioning/automation/conditional_workflows.rst:71
msgid ""
"|morpheus| variables can be injected into the JavaScript expression using"
" ``<%= %>`` syntax:"
msgstr ""
"|morpheus| variables puede ser injected into the JavaScript expression "
"using ``<%= %>`` syntax:"

#: ../../provisioning/automation/conditional_workflows.rst:73
msgid ""
"// Check custom option value\n"
"\"<%= customOptions.environment %>\" === \"production\"\n"
"\n"
"// Check instance status\n"
"\"<%= instance.status %>\" === \"running\"\n"
"\n"
"// Check group membership\n"
"\"<%= instance.group.name %>\" === \"Web Tier\""
msgstr ""
"// Check custom option value\n"
"\"<%= customOptions.entorno %>\" === \"production\"\n"
"\n"
"// Check instancia status\n"
"\"<%= instancia.status %>\" === \"running\"\n"
"\n"
"// Check group membership\n"
"\"<%= instancia.group.name %>\" === \"Web Tier\""

#: ../../provisioning/automation/conditional_workflows.rst:85
msgid "Using Task Results"
msgstr "Using Tarea Results"

#: ../../provisioning/automation/conditional_workflows.rst:87
msgid "Results from prior Tasks in the Workflow can be referenced:"
msgstr "Results from prior Tareas in the Flujo de trabajo puede ser referenced:"

#: ../../provisioning/automation/conditional_workflows.rst:89
msgid ""
"// Check result from a previous task (by task code)\n"
"\"<%= results.healthCheck %>\" === \"healthy\"\n"
"\n"
"// Boolean from prior task\n"
"\"<%= results.validationTask %>\" === \"true\"\n"
"\n"
"// Check if result contains a value\n"
"\"<%= results.checkStatus %>\".indexOf(\"SUCCESS\") >= 0"
msgstr ""
"// Check result from a previous tarea (by tarea code)\n"
"\"<%= results.healthCheck %>\" === \"healthy\"\n"
"\n"
"// Boolean from prior tarea\n"
"\"<%= results.validationTask %>\" === \"true\"\n"
"\n"
"// Check if result contains a value\n"
"\"<%= results.checkStatus %>\".indexOf(\"SUCCESS\") >= 0"

#: ../../provisioning/automation/conditional_workflows.rst:101
msgid "Complex Conditions"
msgstr "Complex Conditions"

#: ../../provisioning/automation/conditional_workflows.rst:103
msgid "Multiple conditions can be combined:"
msgstr "Multiple conditions puede ser combined:"

#: ../../provisioning/automation/conditional_workflows.rst:105
msgid ""
"// AND condition\n"
"\"<%= customOptions.tier %>\" === \"web\" && \"<%= zone.name %>\" === "
"\"Production\"\n"
"\n"
"// OR condition\n"
"\"<%= instance.plan.name %>\".indexOf(\"large\") >= 0 || parseInt(\"<%= "
"instance.maxCores %>\") > 4\n"
"\n"
"// Negation\n"
"\"<%= instance.status %>\" !== \"suspended\""
msgstr ""
"// AND condition\n"
"\"<%= customOptions.tier %>\" === \"web\" && \"<%= zone.name %>\" === "
"\"Production\"\n"
"\n"
"// OR condition\n"
"\"<%= instancia.plan.name %>\".indexOf(\"large\") >= 0 || parseInt(\"<%= "
"instancia.maxCores %>\") > 4\n"
"\n"
"// Negation\n"
"\"<%= instancia.status %>\" !== \"suspended\""

#: ../../provisioning/automation/conditional_workflows.rst:117
msgid "Result Propagation"
msgstr "Resultado Propagation"

#: ../../provisioning/automation/conditional_workflows.rst:119
msgid "When a Conditional Workflow Task executes a sub-workflow:"
msgstr "When a Conditional Flujo de trabajo Tarea executes a sub-flujo de trabajo:"

#: ../../provisioning/automation/conditional_workflows.rst:121
msgid ""
"**Task Results:** Results from Tasks within the If/Else workflow are "
"accessible to subsequent Tasks in the parent Workflow via "
"``results.taskCode``"
msgstr ""
"**Tarea Results:** Resultados desde Tareas within el/la Si/Sino flujo de "
"trabajo son accessible a subsequent Tareas en el/la parent Flujo de "
"trabajo via ``results.taskCode``"

#: ../../provisioning/automation/conditional_workflows.rst:122
msgid "**Error Handling:** If a Task within the sub-workflow fails:"
msgstr "**Error Handling:** If a Tarea within the sub-flujo de trabajo fails:"

#: ../../provisioning/automation/conditional_workflows.rst:124
msgid ""
"If **Continue on Error** is set on the conditional task, the parent "
"Workflow continues"
msgstr ""
"If **Continue on Error** is set on the conditional tarea, the parent "
"Flujo de trabajo continues"

#: ../../provisioning/automation/conditional_workflows.rst:125
msgid "If not set, the parent Workflow fails"
msgstr "If not set, the parent Flujo de trabajo fails"

#: ../../provisioning/automation/conditional_workflows.rst:127
msgid ""
"**Output:** The conditional task itself does not produce a result value; "
"results come from the individual Tasks within the executed sub-workflow"
msgstr ""
"**Output:** El/La conditional tarea itself hace no produce un resultado "
"valor; resultados come desde el/la individual Tareas within el/la "
"executed sub-flujo de trabajo"

#: ../../provisioning/automation/conditional_workflows.rst:130
msgid "Best Practices"
msgstr "Mejores prácticas"

#: ../../provisioning/automation/conditional_workflows.rst:132
msgid ""
"**Keep conditions simple:** Complex logic should be in a preceding Script"
" Task that outputs a simple value for the conditional to evaluate"
msgstr ""
"**Keep conditions simple:** Complex logic debería ser in a preceding "
"Script Tarea that outputs a simple value for the conditional to evaluate"

#: ../../provisioning/automation/conditional_workflows.rst:133
msgid ""
"**Use task codes:** Reference prior task results by code rather than name"
" for stability"
msgstr ""
"**Use tarea codes:** Reference prior tarea results by code rather than "
"name for stability"

#: ../../provisioning/automation/conditional_workflows.rst:134
msgid ""
"**Test both branches:** Ensure both the If and Else workflows handle "
"their scenarios completely"
msgstr ""
"**Test both branches:** Ensure both the If and Else flujos de trabajo "
"handle their scenarios completely"

#: ../../provisioning/automation/conditional_workflows.rst:135
msgid ""
"**Handle null values:** Wrap variable references in null checks when "
"values may not be present:"
msgstr ""
"**Handle null values:** Wrap variable references en null checks cuando "
"valores puede no be present:"

#: ../../provisioning/automation/conditional_workflows.rst:137
msgid "(\"<%= customOptions.skipDeploy %>\" || \"false\") === \"true\""
msgstr "(\"<%= customOptions.skipDeploy %>\" || \"false\") === \"true\""

#: ../../provisioning/automation/conditional_workflows.rst:141
msgid ""
"**Use RESULT TYPE wisely:** When chaining tasks before a conditional, set"
" appropriate result types (Single Value, JSON) so values are accessible"
msgstr ""
"**Use RESULT TYPE wisely:** When chaining tareas before a conditional, "
"set appropriate result types (Single Value, JSON) so values are "
"accessible"

