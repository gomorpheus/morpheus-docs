#: ../../provisioning/apps/apps.rst:64 ../../provisioning/apps/apps.rst:74
msgid "App Status"
msgstr "App Estado"

#: ../../provisioning/apps/apps.rst:66
msgid ""
"App Status is determined by the status of the Instances within the App or"
" by the :redguilabel:`DELETE` action. All Instances in an App must be in "
"'Running' status for the App status to equal 'Running'."
msgstr ""
"App Estado es determined por el/la estado de el/la Instancias within "
"el/la App o por el/la :redguilabel:`DELETE` acción. Todos Instancias en "
"un App debe ser en 'Running' estado para el/la App estado a equal "
"'Running'."

