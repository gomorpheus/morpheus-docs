#: ../../library/options/option_lists.rst:507
msgid ""
"for(var x=0;x < data.length ; x++) {\n"
"\n"
"  var row = data[x];\n"
"  var a = {};\n"
"\n"
"  if(row.displayName != null) {\n"
"    a['name'] = row.displayName;\n"
"\n"
"  } else {\n"
"\n"
"    a['name'] = row.sAMAccountName;\n"
"\n"
"  }\n"
"\n"
"  a['value'] = row.sAMAccountName;\n"
"  results.push(a);\n"
"\n"
"}"
msgstr "for(var x=0;x < data.length ; x++) {\\n\\n  var row = data[x];\\n  var a = {};\\n\\n  if(row.displayName != null) {\\n    a['name'] = row.displayName;\\n\\n  } else {\\n\\n    a['name'] = row.sAMAccountName;\\n\\n  }\\n\\n  a['value'] = row.sAMAccountName;\\n  results.push(a);\\n\\n}"

