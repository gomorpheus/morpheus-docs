msgstr "Permitir que el valor de la entrada se actualice al editar una instancia (este atributo está oculto si MOSTRAR AL EDITAR no está seleccionado)"

#: ../../library/options/option_types.rst:38
msgid "DISPLAY VALUE ON DETAILS"
msgstr "MOSTRAR VALOR EN DETALLES"

#: ../../library/options/option_types.rst:39
