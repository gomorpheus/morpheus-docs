#: ../../library/templates/security_packages.rst:2
msgid "Security Packages"
msgstr "Paquetes de seguridad"

#: ../../library/templates/security_packages.rst:4
msgid ""
"The Security Packages Section is for uploading SCAP packages which can "
"then be consumed in Security Scan Jobs (|ProJob|)."
msgstr ""
"La sección de Paquetes de seguridad es para cargar paquetes SCAP que "
"luego pueden ser utilizados en Trabajos de escaneo de seguridad "
"(|ProJob|)."

#: ../../library/templates/security_packages.rst:7
msgid "Add a new Security Package"
msgstr "Agregar un nuevo paquete de seguridad"

#: ../../library/templates/security_packages.rst:9
msgid "Navigate to Library > Templates > Security Packages"
msgstr "Navegue a Biblioteca > Plantillas > Paquetes de seguridad"

#: ../../library/templates/security_packages.rst:10
msgid "Click :guilabel:`+ADD` > SCAP Package"
msgstr "Haga clic en :guilabel:`+AGREGAR` > Paquete SCAP"

#: ../../library/templates/security_packages.rst:11
msgid "Provide a name in addition to a URL to source the package"
msgstr "Proporcione un nombre además de una URL para obtener el paquete"

#: ../../library/templates/security_packages.rst:12
msgid "Click :guilabel:`SAVE CHANGES`"
msgstr "Haga clic en :guilabel:`GUARDAR CAMBIOS`"

#: ../../library/templates/security_packages.rst:14
msgid "Note"
msgstr "Nota"

#: ../../library/templates/security_packages.rst:14
msgid "Currently URL is the only source option for security packages"
msgstr "Actualmente URL es la única opción de fuente para paquetes de seguridad"

