msgstr "Seleccione :guilabel:`+ AGREGAR`"

#: ../../library/templates/scripts.rst:11
msgid "Enter the Following:"
msgstr "Ingrese lo siguiente:"

#: ../../library/templates/scripts.rst:13
msgid "NAME"
msgstr "NOMBRE"

#: ../../library/templates/scripts.rst:14
msgid "Name of the Script in |morpheus|"
msgstr "Name of the Script in |morpheus|"

#: ../../library/templates/scripts.rst:16
msgid "SCRIPT TYPE"
msgstr "SCRIPT TYPE"

#: ../../library/templates/scripts.rst:16
msgid "Bash"
msgstr "Bash"

#: ../../library/templates/scripts.rst:17
msgid "Powershell"
msgstr "Powershell"

