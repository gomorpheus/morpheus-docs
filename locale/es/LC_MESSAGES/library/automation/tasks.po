msgid ""
"Entire task output is stored in ``<%=results.taskCode%>`` or "
"``<%=results[\"Task Name\"]%>`` variable."
msgstr "Entire task output is stored in ``<%=results.taskCode%>`` or ``<%=results[\"Tarea Name\"]%>`` variable."

