#: ../../library/automation/scale_thresholds.rst:2
msgid "Scale Thresholds"
msgstr "Umbrales de escala"

#: ../../library/automation/scale_thresholds.rst:4
msgid ""
"Scale Thresholds are pre-configured settings for auto-scaling Instances. "
"When adding auto-scaling to an instance, existing Scale Thresholds can be"
" selected to determine auto-scaling rules."
msgstr "Los Umbrales de escala son configuraciones preconfiguradas para el escalado automático de Instancias. Al agregar escalado automático a una instancia, se pueden seleccionar Umbrales de escala existentes para determinar las reglas de escalado automático."

#: ../../library/automation/scale_thresholds.rst:7
msgid "Creating Scale Thresholds"
msgstr "Crear umbrales de escala"

#: ../../library/automation/scale_thresholds.rst:9
msgid "Navigate to |LibAutSca|"
msgstr "Navegue a |LibAutSca|"

#: ../../library/automation/scale_thresholds.rst:10
msgid "Select :guilabel:`+ ADD`"
msgstr "Seleccione :guilabel:`+ AGREGAR`"

#: ../../library/automation/scale_thresholds.rst:11
msgid "Populate the following:"
msgstr "Complete lo siguiente:"

#: ../../library/automation/scale_thresholds.rst:13
msgid "NAME"
msgstr "NOMBRE"

#: ../../library/automation/scale_thresholds.rst:14
msgid "Name of the Scale Threshold"
msgstr "Nombre del Umbral de escala"

#: ../../library/automation/scale_thresholds.rst:15
msgid "AUTO UPSCALE"
msgstr "ESCALADO AUTOMÁTICO ASCENDENTE"

#: ../../library/automation/scale_thresholds.rst:16
msgid "Enable to automatically upscale per Scale Threshold specifications"
msgstr "Habilitar para escalar automáticamente hacia arriba según las especificaciones del Umbral de escala"

#: ../../library/automation/scale_thresholds.rst:17
msgid "AUTO DOWNSCALE"
msgstr "ESCALADO AUTOMÁTICO DESCENDENTE"

#: ../../library/automation/scale_thresholds.rst:18
msgid "Enable to automatically downscale per Scale Threshold specifications"
msgstr "Habilitar para escalar automáticamente hacia abajo según las especificaciones del Umbral de escala"

#: ../../library/automation/scale_thresholds.rst:19
msgid "MIN COUNT"
msgstr "CONTEO MÍNIMO"

#: ../../library/automation/scale_thresholds.rst:20
msgid ""
"Minimum node count for Instance. Auto-scaling will not downscale below "
"MIN COUNT, and will auto upscale if the MIN COUNT is not met)"
msgstr "Conteo mínimo de nodos para la Instancia. El escalado automático no reducirá por debajo del CONTEO MÍNIMO, y escalará automáticamente hacia arriba si no se cumple el CONTEO MÍNIMO)"

#: ../../library/automation/scale_thresholds.rst:21
msgid "MAX COUNT"
msgstr "CONTEO MÁXIMO"

#: ../../library/automation/scale_thresholds.rst:22
msgid ""
"Maximum node count for Instance. Auto-scaling will not upscale past MAX "
"COUNT, and will auto downscale if MAX COUNT is exceeded."
msgstr "Conteo máximo de nodos para la Instancia. El escalado automático no escalará por encima del CONTEO MÁXIMO, y reducirá automáticamente si se excede el CONTEO MÁXIMO."

#: ../../library/automation/scale_thresholds.rst:23
msgid "ENABLE MEMORY THRESHOLD"
msgstr "HABILITAR UMBRAL DE MEMORIA"

#: ../../library/automation/scale_thresholds.rst:24
msgid "Check to set auto-scaling by specified memory utilization threshold (%)"
msgstr "Marque para establecer el escalado automático por umbral de utilización de memoria especificado (%)"

#: ../../library/automation/scale_thresholds.rst:25
msgid "MIN MEMORY"
msgstr "MEMORIA MÍNIMA"

#: ../../library/automation/scale_thresholds.rst:26
#, python-format
msgid "Enter MIN MEMORY % for triggering downscaling."
msgstr "Ingrese el % de MEMORIA MÍNIMA para activar la reducción de escala."

#: ../../library/automation/scale_thresholds.rst:27
msgid "MAX MEMORY"
msgstr "MEMORIA MÁXIMA"

#: ../../library/automation/scale_thresholds.rst:28
#, python-format
msgid "Enter MAX MEMORY % for triggering upscaling."
msgstr "Ingrese el % de MEMORIA MÁXIMA para activar el escalado ascendente."

#: ../../library/automation/scale_thresholds.rst:29
msgid "ENABLE DISK THRESHOLD"
msgstr "HABILITAR UMBRAL DE DISCO"

#: ../../library/automation/scale_thresholds.rst:30
msgid "Check to set auto-scaling by specified disk utilization threshold (%)"
msgstr "Marque para establecer el escalado automático por umbral de utilización de disco especificado (%)"

#: ../../library/automation/scale_thresholds.rst:31
msgid "MIN DISK"
msgstr "DISCO MÍNIMO"

#: ../../library/automation/scale_thresholds.rst:32
#, python-format
msgid "Enter MIN DISK % for triggering downscaling."
msgstr "Ingrese el % de DISCO MÍNIMO para activar la reducción de escala."

#: ../../library/automation/scale_thresholds.rst:33
msgid "MAX DISK"
msgstr "DISCO MÁXIMO"

#: ../../library/automation/scale_thresholds.rst:34
#, python-format
msgid "Enter MAX DISK % for triggering upscaling."
msgstr "Ingrese el % de DISCO MÁXIMO para activar el escalado ascendente."

#: ../../library/automation/scale_thresholds.rst:35
msgid "ENABLE CPU THRESHOLD"
msgstr "HABILITAR UMBRAL DE CPU"

#: ../../library/automation/scale_thresholds.rst:36
msgid ""
"Check to set auto-scaling by specified overall CPU utilization threshold "
"(%)"
msgstr "Marque para establecer el escalado automático por umbral de utilización general de CPU especificado (%)"

#: ../../library/automation/scale_thresholds.rst:37
msgid "MIN CPU"
msgstr "CPU MÍNIMO"

#: ../../library/automation/scale_thresholds.rst:38
#, python-format
msgid "Enter MIN CPU % for triggering downscaling."
msgstr "Ingrese el % de CPU MÍNIMO para activar la reducción de escala."

#: ../../library/automation/scale_thresholds.rst:39
msgid "MAX CPU"
msgstr "CPU MÁXIMO"

#: ../../library/automation/scale_thresholds.rst:40
#, python-format
msgid "Enter MAX CPU % for triggering upscaling."
msgstr "Ingrese el % de CPU MÁXIMO para activar el escalado ascendente."
