msgstr "Desde el \"Type\" campo, select Puppet Agent Install"

#: ../../integration_guides/Automation/puppet.rst:54
msgid ""
"Complete the fields as needed to target a specific Puppet Master and to "
"identify Puppet environment and node names"
msgstr ""
"Complete el campos según sea necesario to destino un específico Puppet "
"Master y to identify Puppet entorno y node names"

#: ../../integration_guides/Automation/puppet.rst:55
msgid "Save changes"
msgstr "Save cambios"

