#: ../../getting_started/guides/terraform_instances.rst:31
msgid ""
"# This spec template creates AWS subnets based on the count requested "
"utilizing the vpc cidr provided in var.vpc_cidr variable\n"
"\n"
"locals {\n"
"  bitCount = "
"sum([tonumber(local.subnet_options.cidrMask),-tonumber(split(\"/\",var.vpc_cidr)[1])])"
"\n"
"}\n"
"\n"
"resource \"aws_subnet\" \"main\" {\n"
"    count = tonumber(var.subnetCount)\n"
"    vpc_id     = aws_vpc.main.id\n"
"    cidr_block = cidrsubnet(var.vpc_cidr, local.bitCount, count.index)\n"
"\n"
"    tags = merge(\n"
"        local.default_tags,\n"
"        {\n"
"        Name = \"${var.vpc_name}-subnet-0${count.index}\"\n"
"        }\n"
"    )\n"
"}\n"
"\n"
"output \"aws_subnet\" {\n"
"  value = aws_subnet.main\n"
"  sensitive = true\n"
"}"
msgstr ""
"# This spec template creates AWS subnets basado en el count requested "
"utilizing el vpc cidr provided in var.vpc_cidr variable\n"
"\n"
"locals {\n"
"  bitCount = "
"sum([tonumber(local.subnet_options.cidrMask),-tonumber(split(\"/\",var.vpc_cidr)[1])])"
"\n"
"}\n"
"\n"
"recurso \"aws_subnet\" \"main\" {\n"
"    count = tonumber(var.subnetCount)\n"
"    vpc_id     = aws_vpc.main.id\n"
"    cidr_block = cidrsubnet(var.vpc_cidr, local.bitCount, count.index)\n"
"\n"
"    tags = merge(\n"
"        local.default_tags,\n"
"        {\n"
"        Name = \"${var.vpc_name}-subnet-0${count.index}\"\n"
"        }\n"
"    )\n"
"}\n"
"\n"
"salida \"aws_subnet\" {\n"
"  valor = aws_subnet.main\n"
"  sensitive = true\n"
"}"

#: ../../getting_started/guides/terraform_instances.rst:59
