"  tipo        = string\n"
"}\n"
"\n"
"variable \"secret_key\" {\n"
"  tipo        = string\n"
"}\n"
"\n"
"variable \"subnetCount\" {\n"
"  tipo = número\n"
"  predeterminado = \"<%=customOptions.subnetCount%>\"\n"
