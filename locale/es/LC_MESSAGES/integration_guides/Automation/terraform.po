#: ../../getting_started/guides/terraform_instances.rst:82
msgid ""
"terraform {\n"
"  required_providers {\n"
"    aws = {\n"
"      source = \"hashicorp/aws\"\n"
"      version = \">= 3.35.0\"\n"
"    }\n"
"  }\n"
"}\n"
"\n"
"provider \"aws\" {\n"
"  region     = local.vpc_options.region\n"
"  access_key = var.access_key\n"
"  secret_key = var.secret_key\n"
"\n"
"  assume_role {\n"
"    # The role ARN within Account B to AssumeRole into.\n"
"    role_arn = "
"\"arn:aws:iam::${local.vpc_options.aws_account}:role/OrganizationAccountAccessRole\""
"\n"
"  }\n"
"}"
msgstr ""
"terraform {\n"
"  required_providers {\n"
"    aws = {\n"
"      origen = \"hashicorp/aws\"\n"
"      versión = \">= 3.35.0\"\n"
"    }\n"
"  }\n"
"}\n"
"\n"
"proveedor \"aws\" {\n"
"  region     = local.vpc_options.region\n"
"  access_key = var.access_key\n"
"  secret_key = var.secret_key\n"
"\n"
"  assume_role {\n"
"    # El rol ARN dentro de Account B to AssumeRole en.\n"
"    role_arn = "
"\"arn:aws:iam::${local.vpc_options.aws_account}:role/OrganizationAccountAccessRole\""
"\n"
"  }\n"
"}"

