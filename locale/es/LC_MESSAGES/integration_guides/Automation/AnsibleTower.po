msgid "Note"
msgstr "Nota"

#: ../../integration_guides/Automation/AnsibleTower.rst:11
msgid ""
"This integration will not import data of the jobs which are not executed "
"from |morpheus|."
msgstr ""
"Esta integración no import datos of el jobs cual no son executed desde "
"|morpheus|."

