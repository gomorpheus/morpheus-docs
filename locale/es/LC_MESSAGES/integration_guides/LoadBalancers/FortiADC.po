#: ../../integration_guides/LoadBalancers/FortiADC.rst:2
msgid "FortiADC"
msgstr "FortiADC"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:5
msgid "Add FortiADC Load Balancer"
msgstr "Add FortiADC Load Balancer"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:7
msgid "To add a FortiADC Load Balancer Integration:"
msgstr "To add un FortiADC Load Balancer Integration:"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:9
msgid "Navigate to :menuselection:`Infrastructure --> Load Balancers`"
msgstr "Navegue un :menuselection:`Infrastructure --> Load Balancers`"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:10
msgid "Select :guilabel:`+ ADD`"
msgstr "Select :guilabel:`+ AGREGAR`"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:11
msgid ""
"Select **FortiADC** from the drop-down list. The NEW LOAD BALANCER panel "
"opens."
msgstr ""
"Select **FortiADC** desde el lista desplegable. The NEW LOAD BALANCER panel "
"opens."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:12
msgid "Configure the following:"
msgstr "Configure el following:"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:14
msgid "GROUP"
msgstr "GROUP"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:15
msgid "From the drop-down list, select the group for the load balancer."
msgstr "Desde el lista desplegable, select el grupo para el load balancer."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:16
msgid "CLOUD"
msgstr "CLOUD"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:17
msgid ""
"From the drop-down list, select the cloud that hosts the load balancer."
msgstr ""
"Desde el lista desplegable, select la nube que hosts el load balancer."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:18
msgid "NAME"
msgstr "NAME"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:19
msgid "Enter the load balancer name."
msgstr "Ingrese el load balancer nombre."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:20
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:21
msgid "Identifying information displayed on the load balancer list page."
msgstr ""
"Identifying información displayed on el load balancer página de lista."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:22
msgid "API URL"
msgstr "API URL"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:23
msgid ""
"Enter the URL of the FortiADC API. For example, ``http://10.30.21.55``."
msgstr ""
"Ingrese el URL of el FortiADC API. Por ejemplo, ``http://10.30.21.55``."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:24
msgid "API PORT"
msgstr "API PORT"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:25
msgid "Enter the FortiADC API port. For example, ``80``"
msgstr "Ingrese el FortiADC API puerto. Por ejemplo, ``80``"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:26
msgid "USERNAME"
msgstr "USERNAME"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:27
msgid "Enter FortiADC service account username."
msgstr "Enter FortiADC servicio cuenta nombre de usuario."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:28
msgid "PASSWORD"
msgstr "PASSWORD"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:29
msgid "Enter FortiADC service account password."
msgstr "Enter FortiADC servicio cuenta contraseña."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:30
msgid "VIRTUAL NAME"
msgstr "VIRTUAL NAME"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:31
#, python-brace-format
msgid ""
"Enter the naming pattern for new FortiADC Virtual Servers. If blank, "
"defaults to ``morph_lb_${loadBalancer.id}``."
msgstr ""
"Ingrese el naming pattern para nuevo FortiADC Virtual Servers. If blank, "
"defaults to ``morph_lb_${loadBalancer.id}``."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:32
msgid "SERVICE NAME"
msgstr "SERVICE NAME"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:33
#, python-brace-format
msgid ""
"Enter the naming pattern for new FortiADC Services. If blank, defaults to "
"``morph_service_${container.id}``."
msgstr ""
"Ingrese el naming pattern para nuevo FortiADC Services. If blank, defaults "
"to ``morph_service_${container.id}``."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:35
msgid "SERVER NAME"
msgstr "SERVER NAME"

#: ../../integration_guides/LoadBalancers/FortiADC.rst:35
#, python-brace-format
msgid ""
"Enter the naming pattern for new FortiADC Servers. If blank, defaults to "
"``morph_server_${server.id}``."
msgstr ""
"Ingrese el naming pattern para nuevo FortiADC Servers. If blank, defaults to"
" ``morph_server_${server.id}``."

#: ../../integration_guides/LoadBalancers/FortiADC.rst:37
msgid "Click :guilabel:`SAVE CHANGES`."
msgstr "Click :guilabel:`GUARDAR CHANGES`."
