#: ../../integration_guides/Clouds/advanced_options.rst:63
msgid "Folders"
msgstr "Folders"

#: ../../integration_guides/Clouds/advanced_options.rst:65
msgid "**Provisioning Command**"
msgstr "**Provisioning Command**"

#: ../../integration_guides/Clouds/advanced_options.rst:67
msgid "PROXY"
msgstr "PROXY"

#: ../../integration_guides/Clouds/advanced_options.rst:68
msgid ""
"Set a proxy for inbound communication from Instances to the |morpheus| "
"Appliance. Proxies can be added in the `Infrastructure > Networks > Proxies`"
" tab."
msgstr ""
"Set un proxy para inbound communication desde Instances to el |morpheus| "
"Appliance. Proxies se puede agregar in el `Infrastructure > Networks > "
"Proxies` pestaña."

#: ../../integration_guides/Clouds/advanced_options.rst:69
msgid "Bypass Proxy for Appliance URL"
msgstr "Bypass Proxy para Appliance URL"

#: ../../integration_guides/Clouds/advanced_options.rst:70
msgid ""
"Enable to bypass proxy settings (if added) for |morpheus| Agent "
"communication to the Appliance URL."
msgstr ""
"Enable to bypass proxy configuración (if agregado) para |morpheus| Agent "
"communication to el Appliance URL."

#: ../../integration_guides/Clouds/advanced_options.rst:71
msgid "NO PROXY"
msgstr "NO PROXY"

#: ../../integration_guides/Clouds/advanced_options.rst:72
msgid ""
"Include a list of IP addresses or name servers to exclude from proxy "
"traversal"
msgstr ""
"Include un lista of IP addresses o nombre servers to exclude desde proxy "
"traversal"

#: ../../integration_guides/Clouds/advanced_options.rst:74
msgid "USER DATA (LINUX)"
msgstr "USER DATA (LINUX)"

#: ../../integration_guides/Clouds/advanced_options.rst:74
msgid ""
"Add cloud-init user data. |morpheus| 4.1.0 and earlier assumes bash syntax. "
"|morpheus| 4.1.1 and later supports all User Data formats. Refer to "
"https://cloudinit.readthedocs.io/en/latest/topics/format.html for more "
"information."
msgstr ""
"Add cloud-init user datos. |morpheus| 4.1.0 y earlier assumes bash syntax. "
"|morpheus| 4.1.1 y later supports todos User Data formats. Refer to "
"https://cloudinit.readthedocs.io/en/latest/topics/format.html para más "
"información."

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:36
msgid ""
"Select an existing or create a new Group to add the Cloud to. The Cloud can "
"be added to additional Groups in a Groups `Clouds` tab."
msgstr ""
"Select un existente o create un nuevo Group to add el Cloud to. The Cloud se"
" puede agregar to adicional Groups in un Groups `Clouds` pestaña."

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:38
#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:74
msgid "Review and then Select :guilabel:`COMPLETE`"
