#: ../../integration_guides/Clouds/vmware/vmware_templates.rst:182
msgid "Update GRUB:"
msgstr "Update GRUB:"

#: ../../integration_guides/Clouds/vmware/vmware_templates.rst:184
msgid "update-grub"
msgstr "update-grub"

#: ../../integration_guides/Clouds/vmware/vmware_templates.rst:188
msgid "Update the ``70-persistent-net.rules`` file:"
msgstr "Update el ``70-persistent-net.rules`` archivo:"

#: ../../integration_guides/Clouds/vmware/vmware_templates.rst:190
#, python-brace-format
msgid ""
"cat << EOF > /etc/udev/rules.d/70-persistent-net.rules\n"
"SUBSYSTEM==\"net\", ACTION==\"add\", DRIVERS==\"?*\", "
"ATTR{dev_id}==\"0x0\", ATTR{type}==\"1\", NAME=\"eth0\"\n"
"EOF"
msgstr ""
"cat << EOF > /etc/udev/rules.d/70-persistent-net.rules\n"
"SUBSYSTEM==\"net\", ACTION==\"add\", DRIVERS==\"?*\", "
"ATTR{dev_id}==\"0x0\", ATTR{tipo}==\"1\", NAME=\"eth0\"\n"
"EOF"

#: ../../integration_guides/Clouds/vmware/vmware_templates.rst:196
msgid ""
