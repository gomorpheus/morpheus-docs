msgid ""
"Once the device UID is known (from the storage controller), the provisioning"
" script searches for the matching device in/dev/disk/by-id/"
msgstr ""
"Once el device UID es known (desde el storage controller), el provisioning "
"script searches para el matching device in/dev/disk/by-id/"

#: ../../integration_guides/Clouds/hpe_bare_metal/storage_management.rst:41
