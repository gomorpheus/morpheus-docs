#: ../../integration_guides/Networking/solarwinds.rst:2
msgid "SolarWinds IPAM"
msgstr "SolarWinds IPAM"

#: ../../integration_guides/Networking/solarwinds.rst:5
msgid "Features"
msgstr "Características"

#: ../../integration_guides/Networking/solarwinds.rst:7
msgid ""
"Automate static IP assignment across environments using Solarwinds IPAM"
msgstr "Automate static IP assignment across entornos using Solarwinds IPAM"

#: ../../integration_guides/Networking/solarwinds.rst:8
msgid ""
"Network pool sync: Network pools can be set on networks in |morpheus| for "
"automated IP allocation and record creation"
msgstr ""
"Network pool sync: Network pools se puede establecer on networks in "
"|morpheus| para automated IP allocation y registro creation"

#: ../../integration_guides/Networking/solarwinds.rst:9
msgid ""
"Optional Network Pool allocation and record sync. ``Inventory Existing`` "
"option syncs all individual IP records and corresponding status. Inventory "
"is not required for provisioning"
msgstr ""
"Optional Network Pool allocation y registro sync. ``Inventory Existing`` "
"opción syncs todos individual IP registros y corresponding estado. Inventory"
" no es requerido para provisioning"

#: ../../integration_guides/Networking/solarwinds.rst:10
msgid ""
"Grid and list displays with IP record overlays and color coding for static, "
"available, reserved and transient status"
msgstr ""
"Grid y lista displays con IP registro overlays y color coding para static, "
"disponible, reserved y transient estado"

#: ../../integration_guides/Networking/solarwinds.rst:11
msgid "Manual IP Host record creation from Network Pool detail pages"
msgstr ""
"Manual IP Host registro creation desde Network Pool página de detalless"

#: ../../integration_guides/Networking/solarwinds.rst:15
msgid "Adding SolarWinds to |morpheus|"
msgstr "Agregar SolarWinds to |morpheus|"

