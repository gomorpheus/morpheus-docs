#: ../../integration_guides/storage/isilon.rst:27
msgid "PROVISION GROUP"
msgstr "PROVISION GROUP"

#: ../../integration_guides/storage/isilon.rst:28
msgid "Select Provision Group"
msgstr "Select Provision Group"

#: ../../integration_guides/storage/isilon.rst:31
msgid "ROOT PATH"
msgstr "ROOT PATH"

#: ../../integration_guides/storage/isilon.rst:31
msgid "Enter Root Path"
msgstr "Enter Root Path"

#: ../../integration_guides/storage/isilon.rst:31
msgid "Example : ``\\``"
msgstr "Example : ``\\``"

#: ../../integration_guides/storage/isilon.rst:33
#: ../../integration_guides/storage/isilon.rst:90
msgid "Select :guilabel:`SAVE CHANGES`"
msgstr "Select :guilabel:`GUARDAR CHANGES`"

#: ../../integration_guides/storage/isilon.rst:35
msgid ""
"The Dell EMC Isilon Storage Server will be added and displayed in the "
"Buckets tab."
msgstr ""
"The Dell EMC Isilon Storage Server será be agregado y displayed in el "
"Buckets pestaña."

#: ../../integration_guides/storage/isilon.rst:37
msgid "Buckets, Files Shares and Storage Groups will be synced in."
msgstr "Buckets, Files Shares y Storage Groups será be synced in."

#: ../../integration_guides/storage/isilon.rst:40
msgid "Add Dell EMC Isilon File Share"
msgstr "Add Dell EMC Isilon File Share"

#: ../../integration_guides/storage/isilon.rst:42
msgid "To Add a Dell EMC Isilon File Share:"
msgstr "To Add un Dell EMC Isilon File Share:"

#: ../../integration_guides/storage/isilon.rst:46
msgid "In the FILE SHARES tab, Click the :guilabel:`+ ADD` button."
msgstr ""
"En el FILE SHARES pestaña, Haga clic en el :guilabel:`+ AGREGAR` botón."

#: ../../integration_guides/storage/isilon.rst:47
msgid "Select `Dell EMC Isilon Share` from the dropdown list"
msgstr "Select `Dell EMC Isilon Share` desde el lista desplegable"

#: ../../integration_guides/storage/isilon.rst:48
msgid "From the NEW FILE SHARE Wizard input the following:"
msgstr "Desde el NEW FILE SHARE Wizard entrada el following:"

#: ../../integration_guides/storage/isilon.rst:51
msgid "Name of the File Share in |morpheus|."
msgstr "Name of el File Share in |morpheus|."

#: ../../integration_guides/storage/isilon.rst:52
msgid "STORAGE SERVICE"
msgstr "STORAGE SERVICE"

#: ../../integration_guides/storage/isilon.rst:53
msgid ""
"Select existing Dell EMC Isilon Storage Server (configured in "
"`Infrastructure - Storage - Servers`)"
msgstr ""
"Select existente Dell EMC Isilon Storage Server (configurado in "
"`Infrastructure - Storage - Servers`)"

#: ../../integration_guides/storage/isilon.rst:55
msgid "SHARE PATH"
msgstr "SHARE PATH"

#: ../../integration_guides/storage/isilon.rst:55
msgid "Enter Dell EMC Isilon Share Path"
msgstr "Enter Dell EMC Isilon Share Path"

#: ../../integration_guides/storage/isilon.rst:56
msgid "Example: ``ecs-file-share-1``"
msgstr "Example: ``ecs-file-share-1``"

#: ../../integration_guides/storage/isilon.rst:57
msgid "Volume Size"
msgstr "Volume Size"

#: ../../integration_guides/storage/isilon.rst:58
msgid "Specify volume size for the File Share (in MB)"
msgstr "Specify volume tamaño para el File Share (in MB)"

#: ../../integration_guides/storage/isilon.rst:61
msgid "Allowed IP's"
msgstr "Allowed IP's"

#: ../../integration_guides/storage/isilon.rst:61
msgid "Specify IP Addresses to limit accessibility to the File Share"
msgstr "Specify IP Addresses to límite accessibility to el File Share"

#: ../../integration_guides/storage/isilon.rst:61
msgid "Leave blank for open access"
msgstr "Leave blank para open acceso"

#: ../../integration_guides/storage/isilon.rst:62
msgid ""
"Click the ``+`` symbol to the right of the first ALLOWED IPS field to add "
"multiple IP's"
msgstr ""
"Haga clic en el ``+`` symbol to el right of el primero ALLOWED IPS campo to "
"add múltiples IP's"

#: ../../integration_guides/storage/isilon.rst:63
msgid "NAMESPACE"
msgstr "NAMESPACE"

#: ../../integration_guides/storage/isilon.rst:64
msgid "Select Dell EMC Isilon Namespace (synced)"
msgstr "Select Dell EMC Isilon Namespace (synced)"

#: ../../integration_guides/storage/isilon.rst:65
msgid "STORAGE GROUP"
msgstr "STORAGE GROUP"

#: ../../integration_guides/storage/isilon.rst:66
msgid "Select Dell EMC Isilon Storage Group (synced)"
msgstr "Select Dell EMC Isilon Storage Group (synced)"

#: ../../integration_guides/storage/isilon.rst:67
msgid "Default Backup Target"
msgstr "Default Backup Target"

#: ../../integration_guides/storage/isilon.rst:68
msgid ""
"Sets this File Share as the default backup target when creating Backups. If "
"selected the option to update existing Backup configuration to use this File"
" Share will be presented."
msgstr ""
"Sets este File Share as el predeterminado backup destino cuando creating "
"Backups. If seleccionado el opción to update existente Backup configuración "
"to use este File Share será be presented."

#: ../../integration_guides/storage/isilon.rst:69
msgid "Archive Snapshots"
msgstr "Archive Snapshots"

#: ../../integration_guides/storage/isilon.rst:70
msgid ""
"Enabled to export VM snapshots to this File Share when creating VMware "
"Backups, after which the snapshot will be removed from the source Cloud."
msgstr ""
"Enabled to export VM snapshots to este File Share cuando creating VMware "
"Backups, después de cual el snapshot será be eliminado desde el origen "
"Cloud."

#: ../../integration_guides/storage/isilon.rst:71
msgid "Default Deployment Archive Target"
msgstr "Default Deployment Archive Target"

#: ../../integration_guides/storage/isilon.rst:72
msgid ""
"Sets this File Share as the default storage target when uploading Deployment"
" files in the `Deployments` section."
msgstr ""
"Sets este File Share as el predeterminado storage destino cuando uploading "
"Deployment archivos in el `Deployments` sección."

#: ../../integration_guides/storage/isilon.rst:74
msgid "Default Virtual Image Store"
msgstr "Default Virtual Image Store"

#: ../../integration_guides/storage/isilon.rst:74
msgid ""
"Sets this File Share as the default storage target when uploading Virtual "
"Images from the `Virtual Images` section, importing Images from Instance "
"Actions, creating Images with the `Image Builder` and when creating new "
"images from `Migrations`."
msgstr ""
"Sets este File Share as el predeterminado storage destino cuando uploading "
"Virtual Images desde el `Virtual Images` sección, importing Images desde "
"Instance Actions, creating Images con el `Image Builder` y cuando creating "
"nuevo images desde `Migrations`."

#: ../../integration_guides/storage/isilon.rst:88
msgid "RETENTION POLICY"
msgstr "RETENTION POLICY"

#: ../../integration_guides/storage/isilon.rst:77
msgid "None"
msgstr "None"

#: ../../integration_guides/storage/isilon.rst:78
msgid ""
"Files in the File Share will not be automatically deleted or backed up."
msgstr "Files in el File Share no be automáticamente eliminado o backed up."

#: ../../integration_guides/storage/isilon.rst:83
msgid "Backup Old Files"
msgstr "Backup Old Files"

#: ../../integration_guides/storage/isilon.rst:83
msgid ""
"This option will backup files after a set amount if time and remove them "
"from the File Share."
msgstr ""
"This opción será backup archivos después de un set amount if time y remove "
"them desde el File Share."

#: ../../integration_guides/storage/isilon.rst:81
#: ../../integration_guides/storage/isilon.rst:88
msgid "DAYS OLD"
msgstr "DAYS OLD"

#: ../../integration_guides/storage/isilon.rst:82
msgid ""
"Files older than the set number of days will be automatically backed up to "
"the selected Backup File Share."
msgstr ""
"Files older than el set número of days será be automáticamente backed up to "
"el seleccionado Backup File Share."

#: ../../integration_guides/storage/isilon.rst:83
msgid "BACKUP File Share"
msgstr "BACKUP File Share"

#: ../../integration_guides/storage/isilon.rst:84
msgid "Search for and select the File Share the files will be backed up to."
msgstr "Search para y select el File Share el archivos será be backed up to."

#: ../../integration_guides/storage/isilon.rst:88
msgid "DELETE OLD FILES"
msgstr "DELETE OLD FILES"

#: ../../integration_guides/storage/isilon.rst:88
msgid ""
"This option will delete files from this File Share after a set amount of "
"days."
msgstr ""
"This opción será delete archivos desde este File Share después de un set "
"amount of days."

#: ../../integration_guides/storage/isilon.rst:88
msgid ""
"Files older than the set number of days will be automatically deleted from "
"the File Share."
msgstr ""
"Files older than el set número of days será be automáticamente eliminado "
"desde el File Share."

#: ../../integration_guides/storage/isilon.rst:92
msgid "The File Share will be created and displayed in the File Shares tab."
msgstr "The File Share será creado y displayed in el File Shares pestaña."

#: ../../integration_guides/storage/isilon.rst:94
msgid ""
"To browse, upload, download, or delete files from this File Share, select "
"the name of the File Share."
msgstr ""
"To browse, upload, download, o delete archivos desde este File Share, select"
" el nombre of el File Share."

#: ../../integration_guides/storage/isilon.rst:96
msgid ""
"To edit the File Share, select the edit icon or select the name of the File "
"Share and select :guilabel:`ACTIONS - EDIT`."
msgstr ""
"To edit el File Share, select el edit icon o select el nombre of el File "
"Share y select :guilabel:`ACTIONS - EDITAR`."

#: ../../integration_guides/storage/isilon.rst:98
msgid ""
"Repointing a File Share that is in use may cause loss of file references. "
"Ensure data is mirrored first."
msgstr ""
"Repointing un File Share que es in use puede cause loss of archivo "
"references. Ensure datos es mirrored primero."

#: ../../integration_guides/storage/isilon.rst:100
msgid ""
"To delete a File Share, select the trash icon or select the name of the File"
" Share and select :guilabel:`DELETE`."
msgstr ""
"To delete un File Share, select el trash icon o select el nombre of el File "
"Share y select :guilabel:`ELIMINAR`."

#: ../../integration_guides/storage/isilon.rst:102
msgid ""
"When deleting a File Share, all Deployment Versions and Backups associated "
"with the File Share will be deleted."
msgstr ""
"When deleting un File Share, todos Deployment Versions y Backups asociado "
"con el File Share será be eliminado."
