"ui\")\n"
"input(type=\"imfile\" File=\"/var/log/morpheus/check-server/current\" Tag"
"=\"check-server\" ReadMode=\"2\" Severity=\"info\" StateFile=\"check-"
"server\")\n"
"input(type=\"imfile\" File=\"/var/log/morpheus/guacd/current\" "
"Tag=\"guacd\" ReadMode=\"2\" Severity=\"info\" StateFile=\"guacd\")\n"
"input(type=\"imfile\" File=\"/var/log/morpheus/elasticsearch/current\" "
"Tag=\"elasticsearch\" ReadMode=\"2\" Severity=\"info\" "
"StateFile=\"elasticsearch\")\n"
"input(type=\"imfile\" File=\"/var/log/morpheus/mysql/current\" "
"Tag=\"mysql\" ReadMode=\"2\" Severity=\"info\" StateFile=\"mysql\")\n"
"input(type=\"imfile\" File=\"/var/log/morpheus/nginx/current\" "
"Tag=\"nginx\" ReadMode=\"2\" Severity=\"info\" StateFile=\"nginx\")\n"
"input(type=\"imfile\" File=\"/var/log/morpheus/rabbitmq/current\" "
