#: ../../monitoring/logs.rst:146
msgid ""
"Below is what a suggested configuration looks like for the file "
"``/etc/logrotate.d/morpheus-nginx``:"
msgstr ""
"A continuación se muestra cómo se ve una configuración sugerida para el "
"archivo ``/etc/logrotate.d/morpheus-nginx``:"

#: ../../monitoring/logs.rst:148
#, python-brace-format
msgid ""
"/var/log/morpheus/nginx/morpheus*access.log {\n"
"        daily\n"
"        rotate 14\n"
"        compress\n"
"        delaycompress\n"
"        missingok\n"
"        notifempty\n"
"        create 644 morpheus-app morpheus-app\n"
"        postrotate\n"
"                [ ! -f /var/run/morpheus/nginx/nginx.pid ] || kill -USR1 "
"`cat /var/run/morpheus/nginx/nginx.pid`\n"
"        endscript\n"
"}"
msgstr ""
"/var/log/morpheus/nginx/morpheus*access.log {\n"
"        daily\n"
"        rotate 14\n"
"        compress\n"
"        delaycompress\n"
"        missingok\n"
"        notifempty\n"
"        create 644 morpheus-app morpheus-app\n"
"        postrotate\n"
"                [ ! -f /var/run/morpheus/nginx/nginx.pid ] || kill -USR1 "
"`cat /var/run/morpheus/nginx/nginx.pid`\n"
"        endscript\n"
"}"

