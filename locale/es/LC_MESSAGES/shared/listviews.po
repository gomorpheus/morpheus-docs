#: ../../shared/listviews.rst:2
msgid "Creating Views"
msgstr "Crear vistas"

#: ../../shared/listviews.rst:4
msgid "To create a list view:"
msgstr "Para crear una vista de lista:"

#: ../../shared/listviews.rst:6
msgid "Click the gear icon (:guilabel:`⚙`)"
msgstr "Haga clic en el icono de engranaje (:guilabel:`⚙`)"

#: ../../shared/listviews.rst:7
msgid ""
"Click on one or more columns from the \"Columns\" list to add or remove "
"an output field"
msgstr ""
"Haga clic en una o más columnas de la lista \"Columns\" para agregar o "
"eliminar un campo de salida"

#: ../../shared/listviews.rst:8
msgid "Click \"+ add view\""
msgstr "Haga clic en \"+ add view\""

#: ../../shared/listviews.rst:9
msgid "Provide a name and a description value for your new view"
msgstr "Proporcione un nombre y una descripción para su nueva vista"

#: ../../shared/listviews.rst:10
msgid ""
"If desired, mark the box to set the new view as your default view so it "
"appears automatically each time the invoices list page is accessed"
msgstr ""
"Si lo desea, marque la casilla para establecer la nueva vista como su "
"vista predeterminada para que aparezca automáticamente cada vez que se "
"acceda a la página de lista de facturas"

#: ../../shared/listviews.rst:11
msgid "Click :guilabel:`SAVE`"
msgstr "Haga clic en :guilabel:`GUARDAR`"

