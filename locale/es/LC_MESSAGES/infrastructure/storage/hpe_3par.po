msgid ""
"**CPG Groups** — Common Provisioning Groups are displayed under Storage "
"Groups"
msgstr ""
"**CPG Grupos** — Común Aprovisionamiento Grupos son mostrado bajo "
"Almacenamiento Grupos"

#: ../../infrastructure/storage/hpe_3par.rst:44
msgid "**Volumes** — Virtual volumes provisioned on the array"
msgstr "**Volumes** — Virtual volúmenes aprovisionado en el array"

#: ../../infrastructure/storage/hpe_3par.rst:45
msgid "**Hosts** — Registered hosts with Fibre Channel or iSCSI connectivity"
