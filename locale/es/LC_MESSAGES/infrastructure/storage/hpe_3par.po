#: ../../infrastructure/storage/hpe_3par.rst:114
msgid "Click :guilabel:`SAVE CHANGES`"
msgstr "Click :guilabel:`GUARDAR CAMBIOS`"

#: ../../infrastructure/storage/hpe_3par.rst:41
msgid ""
"Upon successful connection, |morpheus| will sync the following from the "
"array:"
msgstr ""
"Upon successful conexión, |morpheus| será sync lo siguiente desde el array:"

