#: ../../infrastructure/storage/hpe_3par.rst:73
msgid "NAME"
msgstr "NAME"

#: ../../infrastructure/storage/hpe_3par.rst:28
msgid "Name of the Storage Server in |morpheus|."
msgstr "Nombre del Almacenamiento Servidor en |morpheus|."

#: ../../infrastructure/storage/hpe_3par.rst:29
msgid "TYPE"
msgstr "TYPE"

#: ../../infrastructure/storage/hpe_3par.rst:30
