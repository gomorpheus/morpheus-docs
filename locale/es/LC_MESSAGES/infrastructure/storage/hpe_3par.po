#: ../../infrastructure/storage/hpe_3par.rst:34
msgid "USERNAME"
msgstr "USERNAME"

#: ../../infrastructure/storage/hpe_3par.rst:35
msgid "Administrative user account with API access."
msgstr "Administrative usuario account con API acceso."

