#: ../../infrastructure/vdi/allocations.rst:98
msgid "**Pool** — The parent VDI Pool"
msgstr "**Pool** — El parent VDI Pool"

#: ../../infrastructure/vdi/allocations.rst:99
msgid "**Instance** — The assigned |morpheus| Instance"
msgstr "**Instancia** — El asignado |morpheus| Instancia"

#: ../../infrastructure/vdi/allocations.rst:100
msgid "**User** — The assigned user (null if unassigned/available)"
msgstr "**Usuario** — El asignado usuario (null si unassigned/disponible)"

#: ../../infrastructure/vdi/allocations.rst:101
msgid "**Status** — Current allocation status"
msgstr "**Status** — Actual allocation estado"

#: ../../infrastructure/vdi/allocations.rst:102
msgid "**Persistent** — Whether this is a persistent allocation"
msgstr "**Persistent** — Whether este es un persistente allocation"

#: ../../infrastructure/vdi/allocations.rst:103
msgid "**Recyclable** — Whether the allocation can be recycled (reused)"
msgstr "**Recyclable** — Whether el allocation puede be recycled (reused)"

#: ../../infrastructure/vdi/allocations.rst:104
msgid "**Release Date** — When the allocation will be released (after timeout)"
msgstr ""
"**Release Date** — Cuando el allocation será be released (después de "
