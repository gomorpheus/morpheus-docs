msgid "Pool Sizing and Allocations"
msgstr "Pool Sizing y Allocations"

#: ../../infrastructure/vdi/allocations.rst:121
msgid "Allocations interact with pool sizing parameters:"
msgstr "Allocations interact con pool sizing parámetros:"

#: ../../infrastructure/vdi/allocations.rst:123
msgid ""
"**Minimum Idle** — Minimum number of available (unassigned) allocations "
"to maintain. |morpheus| proactively provisions instances to meet this "
"threshold."
msgstr ""
"**Minimum Idle** — Mínimo número de disponible (unassigned) allocations a"
" maintain. |morpheus| proactively aprovisiona instances a meet este "
"threshold."

#: ../../infrastructure/vdi/allocations.rst:124
msgid ""
"**Initial Pool Size** — Number of instances provisioned when the pool is "
"created."
msgstr ""
"**Initial Pool Size** — Número de instances aprovisionado cuando el pool "
"es creado."

#: ../../infrastructure/vdi/allocations.rst:125
msgid ""
"**Maximum Pool Size** — Hard cap on total allocations (reserved + "
"available)."
msgstr ""
"**Maximum Pool Size** — Hard cap en total allocations (reserved + "
"disponible)."

#: ../../infrastructure/vdi/allocations.rst:127
msgid ""
"When an allocation is released (non-persistent), the pool controller "
"checks if the available count has dropped below the minimum idle "
"threshold and provisions replacements."
msgstr ""
"Cuando un allocation es released (non-persistente), el pool controller "
"checks si el disponible cantidad tiene dropped a continuación el mínimo "
"idle threshold y aprovisiona replacements."

