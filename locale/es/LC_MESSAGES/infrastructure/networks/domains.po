#: ../../infrastructure/networks/domains.rst:73
#: ../../infrastructure/networks/domains.rst:82
msgid "In the *Domain* dropdown, select the Domain."
msgstr "En el *Dominio* dropdown, seleccionar el Dominio."

#: ../../infrastructure/networks/domains.rst:74
#: ../../infrastructure/networks/domains.rst:83
msgid "Save Changes"
msgstr "Guardar Cambios"

#: ../../infrastructure/networks/domains.rst:77
msgid "Setting the default domain on a Network"
msgstr "Setting el predeterminado domain en un Red"

#: ../../infrastructure/networks/domains.rst:79
msgid "Navigate to `Infrastructure > Network`."
msgstr "Navegue un `Infrastructure > Network`."

#: ../../infrastructure/networks/domains.rst:80
msgid "Edit the target Network."
msgstr "Editar el destino Red."

#: ../../infrastructure/networks/domains.rst:86
msgid "Selecting a Domain while provisioning an instance"
msgstr "Selecting un Dominio mientras provisioning un instance"

#: ../../infrastructure/networks/domains.rst:88
msgid ""
"While creating an instance, in the `Configure` section, expand the `DNS "
"Options`."
msgstr ""
"Mientras creating un instance, en el `Configure` sección, expand el `DNS "
"Opciones`."

#: ../../infrastructure/networks/domains.rst:89
msgid "Select Domain from the *Domain* dropdown."
msgstr "Seleccionar Dominio desde el *Dominio* dropdown."

