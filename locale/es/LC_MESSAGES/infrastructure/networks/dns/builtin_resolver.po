#: ../../infrastructure/networks/dns/builtin_resolver.rst:204
msgid ""
"For production internet-facing DNS, integrate with dedicated DNS "
"infrastructure (Route 53, PowerDNS, etc.)"
msgstr ""
"Para production internet-facing DNS, integrate con dedicated DNS "
"infrastructure (Route 53, PowerDNS, etc.)"
