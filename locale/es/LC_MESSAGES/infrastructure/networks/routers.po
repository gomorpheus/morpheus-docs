#: ../../infrastructure/networks/routers.rst:23
#: ../../infrastructure/networks/routers.rst:31
#: ../../infrastructure/networks/routers.rst:38
msgid "Navigate to Infrastructure > Networks > Routers tab"
msgstr "Navegue un Infrastructure > Networks > Routers pestaña"

#: ../../infrastructure/networks/routers.rst:24
msgid "Click :guilabel:`+ ADD`"
msgstr "Click :guilabel:`+ AGREGAR`"

#: ../../infrastructure/networks/routers.rst:25
msgid "Select the router type and complete the fields on the resulting modal"
msgstr "Seleccionar el router tipo y completo el campos en el resulting modal"

#: ../../infrastructure/networks/routers.rst:26
msgid "Once complete, click :guilabel:`ADD NETWORK ROUTER`"
msgstr "Una vez completado, click :guilabel:`ADD NETWORK ROUTER`"

#: ../../infrastructure/networks/routers.rst:29
msgid "Editing Existing Routers"
msgstr "Editing Existente Routers"

#: ../../infrastructure/networks/routers.rst:32
msgid "Click on the pencil icon for the appropriate router"
msgstr "Click en el pencil ícono para el appropriate router"

#: ../../infrastructure/networks/routers.rst:33
msgid "After editing router fields, click :guilabel:`SAVE`"
msgstr "Después de editing router campos, click :guilabel:`SAVE`"

#: ../../infrastructure/networks/routers.rst:36
msgid "Deleting Existing Routers"
msgstr "Deleting Existente Routers"

#: ../../infrastructure/networks/routers.rst:39
msgid "Click on the trash can icon for the appropriate router"
msgstr "Click en el trash puede ícono para el appropriate router"

#: ../../infrastructure/networks/routers.rst:40
msgid "Acknowledge the pop-up banner ensuring you wish to delete the router"
msgstr "Acknowledge el pop-up banner ensuring you wish a eliminar el router"
