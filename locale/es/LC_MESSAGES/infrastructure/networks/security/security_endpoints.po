#: ../../infrastructure/networks/security/security_endpoints.rst:4
msgid "Security Endpoints"
msgstr "Security Endpoints"

#: ../../infrastructure/networks/security/security_endpoints.rst:6
msgid ""
"``Infrastructure > Network > Integrations > (select Security Server) > "
"Firewall > Rules``"
msgstr ""
"``Infrastructure > Network > Integrations > (select Security Server) > "
