#: ../../infrastructure/networks/network_scopes.rst:4
msgid "Scopes"
msgstr "Scopes"

#: ../../infrastructure/networks/network_scopes.rst:6
msgid ""
"``Infrastructure > Network > Integrations > (select Network Server) > "
"Scopes``"
msgstr ""
"``Infrastructure > Network > Integrations > (select Network Server) > "
