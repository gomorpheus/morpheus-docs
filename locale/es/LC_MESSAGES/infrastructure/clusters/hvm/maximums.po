#: ../../infrastructure/clusters/hvm/maximums.rst:26
msgid "8"
msgstr "8"

#: ../../infrastructure/clusters/hvm/maximums.rst:27
msgid "Published limit"
msgstr "Límite publicado"

#: ../../infrastructure/clusters/hvm/maximums.rst:28
msgid ""
"HVM layout 2.0. The default ``virtSwitch0`` counts toward the total. See "
":doc:`virtual_switches`."
msgstr "Diseño HVM 2.0. El ``virtSwitch0`` predeterminado cuenta para el total. Consulte :doc:`virtual_switches`."

#: ../../infrastructure/clusters/hvm/maximums.rst:29
msgid "LUN-per-vDisk volumes per cluster"
msgstr "Volúmenes LUN-per-vDisk por clúster"

#: ../../infrastructure/clusters/hvm/maximums.rst:30
msgid "Approximately 800"
msgstr "Aproximadamente 800"

#: ../../infrastructure/clusters/hvm/maximums.rst:31
msgid "Operational threshold"
msgstr "Umbral operativo"

#: ../../infrastructure/clusters/hvm/maximums.rst:32
msgid ""
"Alletra LUN-per-vDisk mode. This is a performance/management threshold, "
"not a general GFS2 vDisk maximum. See :ref:`hvm-lun-per-vdisk-limits`."
msgstr "Modo Alletra LUN-per-vDisk. Este es un umbral de rendimiento/administración, no un máximo general de vDisk GFS2. Consulte :ref:`hvm-lun-per-vdisk-limits`."

#: ../../infrastructure/clusters/hvm/maximums.rst:35
msgid "Limits Not Published"
msgstr "Límites no publicados"

#: ../../infrastructure/clusters/hvm/maximums.rst:37
msgid ""
"The following requested maxima are not published in the evidence "
"maintained with this documentation. Contact HPE; do not derive values "
"from libvirt/QEMU defaults, form validation, or underlying server and "
"storage specifications."
msgstr "Los siguientes máximos solicitados no están publicados en la evidencia mantenida con esta documentación. Contacte a HPE; no derive valores de los valores predeterminados de libvirt/QEMU, validación de formularios o especificaciones subyacentes de servidor y almacenamiento."

