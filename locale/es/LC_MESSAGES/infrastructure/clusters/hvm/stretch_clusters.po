#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:26
msgid "Witness Deployment"
msgstr "Witness Deployment"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:28
msgid ""
"The witness node is a |morpheus| Distributed Worker deployed at a third "
"site, independent from both cluster sites."
msgstr ""
"El witness nodo es un |morpheus| Distributed Worker desplegado en un third "
"site, independent desde ambos cluster sites."

