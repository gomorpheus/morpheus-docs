#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:71
msgid "Cluster Deployment for Stretch"
msgstr "Cluster Deployment para Stretch"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:73
msgid ""
"Do NOT choose a witness during initial cluster creation. The witness must be"
" added after the cluster is deployed."
msgstr ""
"Do NOT elegir un witness durante initial cluster creation. El witness debe "
"be agregado después de el cluster es desplegado."

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:75
msgid ""
"Create the HVM cluster normally following the standard process (see "
":doc:`building_clusters`)"
msgstr ""
"Crear el HVM cluster normally siguiente el estándar proceso (ver "
":doc:`building_clusters`)"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:76
msgid ""
"After deployment completes, navigate to ``Infrastructure > Clusters > "
"[Cluster]``"
msgstr ""
"Después de despliegue completa, navigate a ``Infrastructure > Clusters > "
"[Cluster]``"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:77
msgid "Click :guilabel:`Edit`"
msgstr "Click :guilabel:`Editar`"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:78
msgid "Select the Witness Worker from the dropdown"
msgstr "Seleccionar el Witness Worker desde el dropdown"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:79
msgid "Click :guilabel:`Save Changes`"
msgstr "Click :guilabel:`Guardar cambios`"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:82
msgid "Adding HPE Clustered Datastore (Shared LUN)"
msgstr "Adding HPE Clustered Almacén de datos (Shared LUN)"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:84
msgid ""
"Adding a Shared LUN to the cluster activates the quorum service. Quorum is "
"not needed until shared storage is present."
msgstr ""
"Adding un Shared LUN al cluster activates el quorum servicio. Quorum es no "
"necesario hasta shared storage es present."

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:86
msgid ""
"Monitor host and worker logs for quorum status messages after adding shared "
"storage."
msgstr ""
"Monitor host y worker registros para quorum estado mensajes después de "
"adding shared storage."

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:89
msgid "Site Group Configuration"
msgstr "Site Group Configuration"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:91
msgid ""
"Site groups define which hosts belong to each physical site for arbitration "
"decisions."
msgstr ""
"Site groups define cual hosts belong a cada physical site para arbitration "
"decisions."

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:93
msgid ""
"Navigate to ``Infrastructure > Clusters > [Cluster] > Resources > Host / VM "
"Groups``"
msgstr ""
"Navegue un ``Infrastructure > Clusters > [Cluster] > Resources > Host / VM "
"Groups``"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:94
msgid "Click :guilabel:`Add`"
msgstr "Click :guilabel:`Agregar`"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:95
msgid "Create a Site Group with:"
msgstr "Crear un Site Grupo con:"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:97
msgid "**Site Name**: A name for the site (e.g., \"Site-A\")"
msgstr "**Site Name**: Un nombre para el site (e.g., \"Site-Un\")"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:98
msgid "**Servers**: Select the hosts at this site"
msgstr "**Servidores**: Seleccionar el hosts en este site"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:100
msgid "Repeat for the second site"
msgstr "Repeat para el second site"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:102
msgid ""
"Do NOT use ``siteWitness`` as a site group name. This name is reserved for "
"automatic witness assignment. The witness is automatically assigned to the "
"``siteWitness`` group when the first site group is created."
msgstr ""
"Do NOT usar ``siteWitness`` como un site group nombre. Este nombre es "
"reserved para automático witness assignment. El witness es automáticamente "
"asignado un el ``siteWitness`` group cuando el primero site group es creado."

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:105
msgid "Arbitration Behavior"
msgstr "Arbitration Behavior"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:107
msgid ""
"When a site failure occurs, the following arbitration logic is executed:"
msgstr ""
"Cuando un site fallo occurs, lo siguiente arbitration logic es executed:"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:110
msgid "Failure Detection"
msgstr "Fallo Detection"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:112
msgid ""
"A site is considered failed when ALL non-witness nodes at that site become "
"unreachable (60-second timeout)."
msgstr ""
"Un site es considered falló cuando ALL non-witness nodos en ese site become "
"unreachable (60-second timeout)."

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:115
msgid "Decision Logic"
msgstr "Decision Logic"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:117
msgid "The surviving site checks: can I reach the witness?"
msgstr "El surviving site checks: puede I reach el witness?"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:119
msgid ""
"**No** → The surviving site self-fences (cannot confirm it is the correct "
"winner)"
msgstr ""
"**No** → El surviving site self-fences (cannot confirmar it es el correct "
"winner)"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:120
msgid "**Yes** → Proceed with arbitration"
msgstr "**Yes** → Proceed con arbitration"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:122
msgid ""
"The alphabetically first site name always wins (deterministic tie-breaking)"
msgstr ""
"El alphabetically primero site nombre siempre wins (deterministic tie-"
"breaking)"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:125
msgid "Winner Actions"
msgstr "Winner Acciones"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:127
msgid "The winning site:"
msgstr "El winning site:"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:129
msgid "Adjusts Corosync votes to maintain quorum with remaining nodes"
msgstr "Adjusts Corosync votes a maintain quorum con remaining nodos"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:130
msgid "Issues ``fence_ack`` for nodes at the failed site"
msgstr "Issues ``fence_ack`` para nodos en el falló site"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:133
msgid "Loser Actions"
msgstr "Loser Acciones"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:135
msgid "The losing site:"
msgstr "El losing site:"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:137
msgid "Self-fences (stops DLM and Corosync)"
msgstr "Self-fences (detiene DLM y Corosync)"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:140
msgid "Recovery"
msgstr "Recovery"

#: ../../infrastructure/clusters/hvm/stretch_clusters.rst:142
