#: ../../infrastructure/clusters/hvm/storage_operations.rst:2
msgid "Storage Lifecycle"
msgstr "Storage Lifecycle"

#: ../../infrastructure/clusters/hvm/storage_operations.rst:4
msgid ""
"This section covers Day-2 storage operations on an HVM 1.3 cluster, "
"including adding and removing datastores, managing iSCSI targets, and "
"expanding storage capacity."
msgstr ""
"Este sección covers Day-2 storage operaciones en un HVM 1.3 cluster, "
"incluyendo adding y removing datastores, managing iSCSI targets, y expanding"
" storage capacidad."

#: ../../infrastructure/clusters/hvm/storage_operations.rst:7
msgid "Adding a New Datastore"
msgstr "Adding un Nuevo Almacén de datos"

#: ../../infrastructure/clusters/hvm/storage_operations.rst:9
msgid ""
"New HPE Clustered Datastores (Shared LUNs) can be added to a running cluster"
" without downtime."
msgstr ""
"Nuevo HPE Clustered Almacenes de datos (Shared LUNs) se puede agregar a un "
"ejecutando cluster sin downtime."

#: ../../infrastructure/clusters/hvm/storage_operations.rst:12
msgid "Prerequisites"
msgstr "Requisitos previos"

#: ../../infrastructure/clusters/hvm/storage_operations.rst:14
msgid ""
"A shared storage LUN is provisioned and accessible to all cluster hosts via "
"iSCSI or Fibre Channel"
msgstr ""
"Un shared storage LUN es aprovisionado y accessible a todos cluster hosts "
"via iSCSI o Fibre Channel"

#: ../../infrastructure/clusters/hvm/storage_operations.rst:15
msgid ""
"The iSCSI target for the LUN has been added to the cluster (see `Adding "
"iSCSI Targets`_ below)"
msgstr ""
"El iSCSI destino para el LUN tiene been agregado al cluster (ver `Adding "
"iSCSI Targets`_ a continuación)"

#: ../../infrastructure/clusters/hvm/storage_operations.rst:16
msgid ""
"All hosts can see the block device (verify with ``lsblk`` on each host)"
msgstr ""
"Todos hosts puede consulte la bloquear device (verificar con ``lsblk`` en "
"cada host)"

