#~ msgid ""
#~ "Ubuntu 22.04 uses ``netplan`` for "
#~ "networking and it is the responsibility"
#~ " of the customer to establish "
#~ "recommended networking configurations prior to"
#~ " provisioning an |mvm| cluster. To "
#~ "configure a static IP address, change"
#~ " into the directory holding the "
#~ "config files (``cd /etc/netplan``) and "
