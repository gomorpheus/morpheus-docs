#~ msgid "Adding External Kubernetes Clusters"
#~ msgstr "Adding Externo Kubernetes Clusters"

#~ msgid ""
#~ "|morpheus| supports the management and "
#~ "consumption of Kubernetes clusters provisioned"
#~ " outside of |morpheus|. These are "
#~ "referred to as External Kubernetes "
#~ "Clusters in |morpheus| UI. This could"
#~ " be used, for example, to onboard "
#~ "and manage OpenShift clusters. In order"
#~ " to fully integrate the Kubernetes "
#~ "cluster with the |morpheus| feature set,"
#~ " you may need to create a "
#~ "service account for |morpheus|. Without "
#~ "first taking that step, some features"
#~ " may not work fully, such as "
#~ "listing all namespaces. The process for"
#~ " creating a service account and "
#~ "integrating the Cluster with |morpheus| "
#~ "is described here."
#~ msgstr ""
#~ "|morpheus| soporta el gestión y "
#~ "consumption de Kubernetes clusters "
#~ "aprovisionado outside de |morpheus|. Estos "
#~ "son referred a como Externo Kubernetes"
#~ " Clústeres en |morpheus| UI. Este "
#~ "podría be utilizado, por ejemplo, a "
#~ "onboard y manage OpenShift clusters. "
#~ "Para fully integrate el Kubernetes "
#~ "cluster con el |morpheus| función "
#~ "establecer, you puede necesita a crear"
#~ " un servicio account para |morpheus|. "
#~ "Sin primero taking ese paso, algunos "
#~ "funciones puede no funcionar fully, como"
#~ " listing todos espacios de nombres. "
#~ "El proceso para creating un servicio "
#~ "account y integrating el Clúster con "
#~ "|morpheus| es descrito aquí."

#~ msgid "First, create the Service Account within the Kubernetes cluster:"
#~ msgstr "Primero, crear el Servicio Account dentro de el Kubernetes cluster:"

#~ msgid "kubectl create serviceaccount morpheus"
#~ msgstr "kubectl crear serviceaccount morpheus"

#~ msgid "Next, create the Role Binding:"
#~ msgstr "Siguiente, crear el Rol Binding:"

#~ msgid ""
#~ "kubectl create clusterrolebinding morpheus-admin \\\n"
#~ "--clusterrole=cluster-admin --serviceaccount=default:morpheus \\\n"
#~ "--namespace=default"
#~ msgstr ""
#~ "kubectl crear clusterrolebinding morpheus-admin \\\n"
#~ "--clusterrole=cluster-admin "
#~ "--serviceaccount=predeterminado:morpheus \\\n"
#~ "--namespace=predeterminado"

#~ msgid ""
#~ "With those items created, we can "
#~ "gather the API URL and the API "
#~ "token which will be used to add"
#~ " the existing cluster to |morpheus| "
#~ "in the next step:"
#~ msgstr ""
#~ "Con esos elementos creado, we puede "
#~ "gather el API URL y el API "
#~ "token cual será be utilizado para "
#~ "agregar el existente cluster a "
#~ "|morpheus| en el siguiente paso:"

#~ msgid ""
#~ "kubectl config view --minify | grep "
#~ "server | cut -f 2- -d \":\" "
#~ "| tr -d \" \""
#~ msgstr ""
#~ "kubectl config ver --minify | grep "
#~ "server | cut -f 2- -d \":\" "
#~ "| tr -d \" \""

#~ msgid ""
#~ "SECRET_NAME=$(kubectl get secrets | grep ^morpheus | cut -f1 -d ' ')\n"
#~ "kubectl describe secret $SECRET_NAME | "
#~ "grep -E '^token' | cut -f2 -d':'"
#~ " | tr -d \" \""
#~ msgstr ""
#~ "SECRET_NAME=$(kubectl obtener secrets | grep"
#~ " ^morpheus | cut -f1 -d ' ')"
#~ "\n"
#~ "kubectl describe secret $SECRET_NAME | "
#~ "grep -E '^token' | cut -f2 -d':'"
#~ " | tr -d \" \""

