#: ../../infrastructure/servers/server_devices.rst:73
msgid "Note"
msgstr ""

#: ../../infrastructure/servers/server_devices.rst:39
msgid ""
"Attaching a device may require the VM to be powered off, depending on the"
" device type and hypervisor capabilities."
msgstr ""
"Attaching un device puede requerir el VM a be powered off, dependiendo de"
" el device tipo y hypervisor capabilities."

