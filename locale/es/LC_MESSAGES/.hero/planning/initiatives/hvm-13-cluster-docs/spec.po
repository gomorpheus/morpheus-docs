msgid "Key Changes from 1.2"
msgstr ""

#: ../../.hero/planning/initiatives/hvm-13-cluster-docs/spec.md:19
msgid "**Pacemaker removed** — replaced by Morpheus agent's own quorum/fencing"
msgstr ""

#: ../../.hero/planning/initiatives/hvm-13-cluster-docs/spec.md:20
msgid "**GFS2 renamed** — now \"HPE Clustered Datastore (Shared LUN)\" in UI"
msgstr ""

#: ../../.hero/planning/initiatives/hvm-13-cluster-docs/spec.md:21
msgid ""
"**New quorum system** — agent-based with cross-verification, heartbeat "
"failover"
msgstr ""

#: ../../.hero/planning/initiatives/hvm-13-cluster-docs/spec.md:22
msgid ""
"**Stretch cluster support** — multi-site with witness nodes, "
"deterministic arbitration"
msgstr ""

#: ../../.hero/planning/initiatives/hvm-13-cluster-docs/spec.md:23
msgid "**Layout 1.3** — Ubuntu 24.04, no Pacemaker installed on new clusters"
