#: ../../.hero/knowledge/context/dev-workflow/spec.md:9
msgid "CLI Commands"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:11
msgid "These are run in the terminal, not as slash commands:"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:12
msgid "`hero status` — workspace state and active specs"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:13
msgid "`hero search <query>` — find specs by keyword"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:14
msgid ""
"`hero snapshot` — render the project-shape rollup (surfaces, stages, "
"recent activity, risks)"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:15
msgid "`hero sync import` — import issues from tracker as spec scaffolds"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:16
msgid "`hero sync pull <slug>` — sync spec status from tracker"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:17
msgid "`hero note <slug>` — quick note capture"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:18
msgid "`hero check` — health check"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:19
msgid ""
"`hero peer list` — list registered sibling repos with reachability + "
"manifest status"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:20
msgid ""
"`hero peer show <alias>` — inspect one peer (manifest contents, in-flight"
" handoffs)"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:21
msgid ""
"`hero peer call <alias> --mode=advisory \"...\"` — ask peer's Hero a "
"question (no writes on peer)"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:22
msgid ""
"`hero peer call <alias> --mode=spec-out \"...\"` — have peer's Hero "
"design a spec natively on its side"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:23
msgid "`hero handoff <spec> <alias>` — async-drop a local spec on peer's queue"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:24
msgid ""
"`hero handoff status` / `hero handoff accept <spec>` — track handoffs "
"across the boundary"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:25
msgid ""
"`hero admin repos add <alias> <path>` — register a sibling repo as a peer"
" (one-time setup)"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:27
msgid "Build"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:29
msgid "make build\n"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:33
msgid "Test"
msgstr ""

#: ../../.hero/knowledge/context/dev-workflow/spec.md:35
msgid "make test\n"
msgstr ""

