#: ../../tools/boot_scripts.rst:54
msgid "**Basic Linux Installation:**"
msgstr "**Instalación básica de Linux:**"

#: ../../tools/boot_scripts.rst:56
#, python-brace-format
msgid ""
"#!ipxe\n"
"kernel http://${morpheus-appliance}/images/vmlinuz\n"
"initrd http://${morpheus-appliance}/images/initrd.img\n"
"imgargs vmlinuz inst.repo=http://${morpheus-appliance}/repo inst.ks=http"
"://${morpheus-appliance}/preseed/ks.cfg\n"
"boot"
msgstr ""
"#!ipxe\n"
"kernel http://${morpheus-appliance}/images/vmlinuz\n"
"initrd http://${morpheus-appliance}/images/initrd.img\n"
"imgargs vmlinuz inst.repo=http://${morpheus-appliance}/repo inst.ks=http"
"://${morpheus-appliance}/preseed/ks.cfg\n"
"boot"

#: ../../tools/boot_scripts.rst:64
msgid "**Ubuntu Cloud Image:**"
msgstr "**Imagen de Ubuntu Cloud:**"

#: ../../tools/boot_scripts.rst:66
#, python-brace-format
msgid ""
"#!ipxe\n"
"set base-url http://${morpheus-appliance}/images/ubuntu\n"
"kernel ${base-url}/vmlinuz\n"
"initrd ${base-url}/initrd\n"
"imgargs vmlinuz auto=true url=http://${morpheus-"
"appliance}/preseed/ubuntu.seed\n"
"boot"
msgstr ""
"#!ipxe\n"
"set base-url http://${morpheus-appliance}/images/ubuntu\n"
"kernel ${base-url}/vmlinuz\n"
"initrd ${base-url}/initrd\n"
"imgargs vmlinuz auto=true url=http://${morpheus-"
"appliance}/preseed/ubuntu.seed\n"
"boot"

#: ../../tools/boot_scripts.rst:75
msgid "**Menu-Based Selection:**"
msgstr "**Selección basada en menú:**"

#: ../../tools/boot_scripts.rst:77
#, python-brace-format
msgid ""
"#!ipxe\n"
"menu Boot Options\n"
"item centos CentOS Stream 9\n"
"item ubuntu Ubuntu 22.04 LTS\n"
"item shell iPXE Shell\n"
"choose os && goto ${os}\n"
"\n"
":centos\n"
"kernel http://${morpheus-appliance}/images/centos/vmlinuz\n"
"initrd http://${morpheus-appliance}/images/centos/initrd.img\n"
"boot\n"
"\n"
":ubuntu\n"
"kernel http://${morpheus-appliance}/images/ubuntu/vmlinuz\n"
"initrd http://${morpheus-appliance}/images/ubuntu/initrd\n"
"boot\n"
"\n"
":shell\n"
"shell"
msgstr ""
"#!ipxe\n"
"menu Boot Options\n"
"item centos CentOS Stream 9\n"
"item ubuntu Ubuntu 22.04 LTS\n"
