"\n"
":shell\n"
"shell"

#: ../../tools/boot_scripts.rst:100
msgid "Editing a Boot Script"
msgstr "Editar un Script de arranque"

#: ../../tools/boot_scripts.rst:103
msgid ""
"Click the pencil icon on the script row or click the script name to view,"
" then click :guilabel:`EDIT`"
msgstr ""
"Haga clic en el icono de lápiz en la fila del script o haga clic en el "
"nombre del script para ver, luego haga clic en :guilabel:`EDIT`"

#: ../../tools/boot_scripts.rst:104
msgid "Modify the script content or metadata"
msgstr "Modifique el contenido del script o los metadatos"

#: ../../tools/boot_scripts.rst:108
msgid "Deleting a Boot Script"
msgstr "Eliminar un Script de arranque"

#: ../../tools/boot_scripts.rst:111
msgid "Click the trash icon on the script row"
msgstr "Haga clic en el icono de papelera en la fila del script"

#: ../../tools/boot_scripts.rst:112
msgid "Confirm deletion"
msgstr "Confirme la eliminación"

#: ../../tools/boot_scripts.rst:114
msgid "Warning"
msgstr "Advertencia"

#: ../../tools/boot_scripts.rst:114
msgid ""
"Do not delete boot scripts that are actively referenced by PXE "
"configurations or Image Builds. Verify no active workflows depend on the "
"script before removal."
msgstr ""
"No elimine scripts de arranque que estén activamente referenciados por "
"configuraciones PXE o Construcciones de imágenes. Verifique que ningún "
"flujo de trabajo activo dependa del script antes de eliminarlo."

#: ../../tools/boot_scripts.rst:117
msgid "Integration with PXE Boot"
msgstr "Integración con arranque PXE"

#: ../../tools/boot_scripts.rst:119
msgid ""
"Boot scripts work in conjunction with the |morpheus| PXE boot "
"infrastructure:"
msgstr ""
"Los scripts de arranque funcionan en conjunto con la infraestructura de "
"arranque PXE de |morpheus|:"

#: ../../tools/boot_scripts.rst:121
msgid "The DHCP server directs booting servers to the |morpheus| TFTP/HTTP server"
msgstr ""
"El servidor DHCP dirige los servidores en arranque al servidor TFTP/HTTP "
"de |morpheus|"

#: ../../tools/boot_scripts.rst:122
msgid "The boot loader (iPXE) requests the configured boot script"
msgstr "El cargador de arranque (iPXE) solicita el script de arranque configurado"

#: ../../tools/boot_scripts.rst:123
msgid "|morpheus| serves the boot script content"
msgstr "|morpheus| sirve el contenido del script de arranque"

#: ../../tools/boot_scripts.rst:124
msgid ""
"The booting server executes the iPXE commands (download kernel, initrd, "
"boot)"
msgstr ""
"El servidor en arranque ejecuta los comandos iPXE (descargar kernel, "
"initrd, arrancar)"

#: ../../tools/boot_scripts.rst:125
msgid ""
"The server proceeds with OS installation using the specified "
"preseed/kickstart configuration"
msgstr ""
"El servidor procede con la instalación del SO usando la configuración "
"preseed/kickstart especificada"

#: ../../tools/boot_scripts.rst:127
msgid ""
"For PXE infrastructure setup, see the Boot section of the Infrastructure "
"documentation."
msgstr ""
"Para la configuración de infraestructura PXE, consulte la sección Boot de"
" la documentación de Infraestructura."

#: ../../tools/boot_scripts.rst:130
msgid "API"
msgstr "API"

#: ../../tools/boot_scripts.rst:132
msgid "Boot scripts can be managed via the |morpheus| API:"
msgstr ""
"Los scripts de arranque pueden gestionarse a través de la API de "
"|morpheus|:"

#: ../../tools/boot_scripts.rst:134
#, python-brace-format
msgid ""
"# List boot scripts\n"
"curl \"$MORPHEUS_API_URL/api/boot-scripts\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Create a boot script\n"
"curl -X POST \"$MORPHEUS_API_URL/api/boot-scripts\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\n"
"    \"bootScript\": {\n"
"      \"fileName\": \"myboot.ipxe\",\n"
"      \"description\": \"Custom boot script\",\n"
"      \"content\": \"#!ipxe\\nkernel http://server/vmlinuz\\nboot\"\n"
"    }\n"
"  }'"
msgstr ""
"# List boot scripts\n"
"curl \"$MORPHEUS_API_URL/api/boot-scripts\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Create a boot script\n"
"curl -X POST \"$MORPHEUS_API_URL/api/boot-scripts\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\n"
"    \"bootScript\": {\n"
"      \"fileName\": \"myboot.ipxe\",\n"
"      \"description\": \"Custom boot script\",\n"
"      \"content\": \"#!ipxe\\nkernel http://server/vmlinuz\\nboot\"\n"
"    }\n"
"  }'"

