#: ../../tools/ai/morpheus_mcp_server.rst:224
msgid "For a monitoring dashboard that should never modify resources:"
msgstr "Para a monitoring dashboard que should never modify resources:"

#: ../../tools/ai/morpheus_mcp_server.rst:226
#, python-brace-format
msgid ""
"{\n"
"  \"mcpServers\": {\n"
"    \"morpheus-monitor\": {\n"
"      \"url\": \"https://your-morpheus-host/api/mcp\",\n"
"      \"headers\": {\n"
"        \"Authorization\": \"Bearer your-api-token\",\n"
"        \"X-Mcp-Tool-Categories\": \"monitoring,logs,health,reports\",\n"
"        \"X-Mcp-Read-Only-Tools\": \"true\"\n"
"      }\n"
"    }\n"
"  }\n"
"}"
msgstr ""
"{\n  \"mcpServers\": {\n    \"morpheus-monitor\": {\n      \"url\": "
"\"https://your-morpheus-host/api/mcp\",\n      \"headers\": {\n        "
"\"Authorization\": \"Bearer your-api-token\",\n        "
"\"X-Mcp-Tool-Categories\": \"monitoring,logs,health,reports\",\n        "
"\"X-Mcp-Read-Only-Tools\": \"true\"\n      }\n    }\n  }\n}"

#: ../../tools/ai/morpheus_mcp_server.rst:242
msgid "Security Considerations"
msgstr "Consideraciones de seguridad"

#: ../../tools/ai/morpheus_mcp_server.rst:244
msgid ""
"All tool calls execute with the authenticated user's permissions — the "
"MCP server cannot bypass RBAC"
msgstr ""
"All tool calls execute with the authenticated usuario's permisos — the MCP "
"server cannot bypass RBAC"

#: ../../tools/ai/morpheus_mcp_server.rst:245
msgid ""
"Write operations in the built-in AI chat require user confirmation; "
"external MCP clients bypass this (the client's LLM handles confirmation)"
msgstr ""
"Write operations in the built-in AI chat require usuario confirmation; "
"external MCP clients bypass this (the client's LLM handles confirmation)"

#: ../../tools/ai/morpheus_mcp_server.rst:246
msgid "Use ``X-Mcp-Read-Only-Tools: true`` for untrusted or automated clients"
msgstr ""
"Use ``X-Mcp-Read-Only-Tools: true`` para untrusted o automated clients"

#: ../../tools/ai/morpheus_mcp_server.rst:247
msgid "API tokens used for MCP should be scoped to the minimum required role"
msgstr ""
"API tokens used for MCP debería ser scoped to the minimum required role"

#: ../../tools/ai/morpheus_mcp_server.rst:248
msgid "Sessions are isolated per user — no cross-user data leakage"
msgstr "Sessions are isolated per usuario — no cross-usuario data leakage"

