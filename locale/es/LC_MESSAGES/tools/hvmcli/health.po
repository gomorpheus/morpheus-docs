msgid "health"
msgstr "health"

#: ../../tools/hvmcli/health.rst:4
msgid "Run host readiness and health checks."
msgstr "Ejecutar verificaciones de preparación y salud del host."

#: ../../tools/hvmcli/health.rst:7
msgid "Commands"
msgstr "Comandos"

#: ../../tools/hvmcli/health.rst:13
msgid "Command"
msgstr "Comando"

#: ../../tools/hvmcli/health.rst:14
msgid "Description"
msgstr "Descripción"

#: ../../tools/hvmcli/health.rst:15
msgid "``check``"
msgstr "``check``"

#: ../../tools/hvmcli/health.rst:16
msgid "Run host readiness checks"
msgstr "Ejecutar verificaciones de preparación del host"

#: ../../tools/hvmcli/health.rst:17
msgid "``watch``"
msgstr "``watch``"

#: ../../tools/hvmcli/health.rst:18
msgid "Continuously run health checks at a polling interval"
msgstr "Ejecutar verificaciones de salud de forma continua en un intervalo de sondeo"

#: ../../tools/hvmcli/health.rst:21
msgid "health check"
msgstr "health check"

#: ../../tools/hvmcli/health.rst:23
msgid ""
"Run a comprehensive set of host readiness checks including cluster state,"
" VM health, NTP sync, resource availability, gateway reachability, agent "
"status, uplink state, iSCSI connectivity, and multipath configuration."
msgstr "Ejecutar un conjunto integral de verificaciones de preparación del host, incluidos estado del clúster, salud de las VM, sincronización NTP, disponibilidad de recursos, accesibilidad del gateway, estado del agente, estado de uplinks, conectividad iSCSI y configuración multipath."

#: ../../tools/hvmcli/health.rst:25
msgid "sudo hvmcli health check"
msgstr "sudo hvmcli health check"

#: ../../tools/hvmcli/health.rst:29
msgid "sudo hvmcli health check --json"
msgstr "sudo hvmcli health check --json"

#: ../../tools/hvmcli/health.rst:33
msgid "The check covers:"
msgstr "La verificación abarca:"

#: ../../tools/hvmcli/health.rst:35
msgid "**Cluster** — Cluster membership and quorum state"
msgstr "**Cluster** — Membresía del clúster y estado de quorum"

#: ../../tools/hvmcli/health.rst:36
msgid "**VMs** — VM health and consistency"
msgstr "**VMs** — Salud y coherencia de las VM"

#: ../../tools/hvmcli/health.rst:37
msgid "**NTP** — Time synchronization status"
msgstr "**NTP** — Estado de sincronización horaria"

#: ../../tools/hvmcli/health.rst:38
msgid "**Resources** — CPU, memory, and disk availability"
msgstr "**Resources** — Disponibilidad de CPU, memoria y disco"

#: ../../tools/hvmcli/health.rst:39
msgid "**Gateway** — Network gateway reachability"
msgstr "**Gateway** — Accesibilidad del gateway de red"

#: ../../tools/hvmcli/health.rst:40
msgid "**Agent** — Morpheus agent connectivity"
msgstr "**Agent** — Conectividad del agente Morpheus"

#: ../../tools/hvmcli/health.rst:41
msgid "**Uplinks** — Physical NIC link state"
msgstr "**Uplinks** — Estado del enlace de las NIC físicas"

#: ../../tools/hvmcli/health.rst:42
msgid "**iSCSI** — iSCSI session health (if configured)"
msgstr "**iSCSI** — Salud de la sesión iSCSI (si está configurada)"

#: ../../tools/hvmcli/health.rst:43
msgid "**Multipath** — Multipath path availability (if configured)"
msgstr "**Multipath** — Disponibilidad de rutas multipath (si está configurada)"

#: ../../tools/hvmcli/health.rst:46
msgid "health watch"
msgstr "health watch"

#: ../../tools/hvmcli/health.rst:48
msgid "Continuously run health checks at a specified interval."
msgstr "Ejecutar verificaciones de salud de forma continua en un intervalo especificado."

#: ../../tools/hvmcli/health.rst:50
msgid "sudo hvmcli health watch --interval 30"
msgstr "sudo hvmcli health watch --interval 30"

#: ../../tools/hvmcli/health.rst:54
msgid "Options:"
msgstr "Opciones:"

#: ../../tools/hvmcli/health.rst:56
msgid "``--interval <seconds>`` — Polling interval in seconds (default: 60)"
msgstr "``--interval <seconds>`` — Intervalo de sondeo en segundos (predeterminado: 60)"

#: ../../tools/hvmcli/health.rst:58
msgid "Tip"
msgstr "Consejo"

#: ../../tools/hvmcli/health.rst:58
msgid ""
"Use ``health watch`` during maintenance operations to continuously "
"monitor host health and detect issues early."
msgstr "Use ``health watch`` durante operaciones de mantenimiento para monitorear continuamente la salud del host y detectar problemas a tiempo."

