#: ../../tools/hvmcli/getting_started.rst:2
msgid "Getting Started"
msgstr "Primeros pasos"

#: ../../tools/hvmcli/getting_started.rst:5
msgid "Installation"
msgstr "Instalación"

#: ../../tools/hvmcli/getting_started.rst:7
msgid ""
"``hvmcli`` is pre-installed on all HPE HVM hosts. No manual installation "
"is required."
msgstr "``hvmcli`` viene preinstalado en todos los hosts HPE HVM. No se requiere instalación manual."

#: ../../tools/hvmcli/getting_started.rst:9
msgid "To verify the installed version:"
msgstr "Para verificar la versión instalada:"

#: ../../tools/hvmcli/getting_started.rst:11
msgid "sudo hvmcli version"
msgstr "sudo hvmcli version"

#: ../../tools/hvmcli/getting_started.rst:15
msgid "hvmcli 1.0.0 (build 20260719)"
msgstr ""

#: ../../tools/hvmcli/getting_started.rst:20
msgid "Usage"
msgstr "Uso"

#: ../../tools/hvmcli/getting_started.rst:22
msgid "The general syntax for ``hvmcli`` commands is:"
msgstr "La sintaxis general de los comandos ``hvmcli`` es:"

#: ../../tools/hvmcli/getting_started.rst:24
msgid "sudo hvmcli <namespace> <command> [options]"
msgstr "sudo hvmcli <namespace> <command> [options]"

#: ../../tools/hvmcli/getting_started.rst:28
msgid "For example:"
msgstr "Por ejemplo:"

#: ../../tools/hvmcli/getting_started.rst:30
msgid ""
"sudo hvmcli vm list\n"
"sudo hvmcli node list\n"
"sudo hvmcli virtswitch list"
msgstr "sudo hvmcli vm list\\nsudo hvmcli node list\\nsudo hvmcli virtswitch list"

#: ../../tools/hvmcli/getting_started.rst:36
msgid "To get help on any namespace:"
msgstr "Para obtener ayuda sobre cualquier espacio de nombres:"

#: ../../tools/hvmcli/getting_started.rst:38
msgid "sudo hvmcli <namespace> help"
msgstr "sudo hvmcli <namespace> help"

#: ../../tools/hvmcli/getting_started.rst:43
msgid "Global Options"
msgstr "Opciones globales"

#: ../../tools/hvmcli/getting_started.rst:45
msgid "The following options are available for all commands:"
msgstr "Las siguientes opciones están disponibles para todos los comandos:"

#: ../../tools/hvmcli/getting_started.rst:51
msgid "Option"
msgstr "Opción"

#: ../../tools/hvmcli/getting_started.rst:52
#: ../../tools/hvmcli/getting_started.rst:113
msgid "Description"
msgstr "Descripción"

#: ../../tools/hvmcli/getting_started.rst:53
msgid "``--json``"
msgstr "``--json``"

#: ../../tools/hvmcli/getting_started.rst:54
msgid "Output results in JSON format. Useful for scripting and automation."
msgstr "Mostrar resultados en formato JSON. Útil para scripts y automatización."

#: ../../tools/hvmcli/getting_started.rst:55
msgid "``--debug``"
msgstr "``--debug``"

#: ../../tools/hvmcli/getting_started.rst:56
msgid "Enable verbose debug logging to stderr for troubleshooting."
msgstr "Habilitar logging de depuración detallado en stderr para solución de problemas."

#: ../../tools/hvmcli/getting_started.rst:57
msgid "``--help``"
msgstr "``--help``"

#: ../../tools/hvmcli/getting_started.rst:58
msgid "Show help for the current namespace or command."
msgstr "Mostrar ayuda del espacio de nombres o comando actual."

#: ../../tools/hvmcli/getting_started.rst:61
msgid "JSON Output"
msgstr "Salida JSON"

#: ../../tools/hvmcli/getting_started.rst:63
msgid ""
"All commands support ``--json`` output for automation and integration "
"with other tools. JSON responses follow a standard envelope format:"
msgstr "Todos los comandos admiten salida ``--json`` para automatización e integración con otras herramientas. Las respuestas JSON siguen un formato de sobre estándar:"

#: ../../tools/hvmcli/getting_started.rst:65
#, python-brace-format
msgid ""
"{\n"
"  \"errorCode\": 0,\n"
"  \"messages\": \"\",\n"
"  \"data\": { ... }\n"
"}"
msgstr ""

#: ../../tools/hvmcli/getting_started.rst:73
msgid "``errorCode``: ``0`` indicates success, non-zero indicates an error."
msgstr "``errorCode``: ``0`` indica éxito; un valor distinto de cero indica un error."

#: ../../tools/hvmcli/getting_started.rst:74
msgid "``messages``: Empty on success, contains error description on failure."
msgstr "``messages``: Vacío en caso de éxito; contiene la descripción del error en caso de fallo."

#: ../../tools/hvmcli/getting_started.rst:75
msgid "``data``: The command-specific response payload."
msgstr "``data``: Carga útil de respuesta específica del comando."

#: ../../tools/hvmcli/getting_started.rst:78
msgid "Namespace Availability"
msgstr "Disponibilidad de espacios de nombres"

#: ../../tools/hvmcli/getting_started.rst:80
msgid "Not all namespaces are available on every HVM version:"
msgstr "No todos los espacios de nombres están disponibles en todas las versiones de HVM:"

#: ../../tools/hvmcli/getting_started.rst:86
#: ../../tools/hvmcli/getting_started.rst:112
msgid "Namespace"
msgstr "Espacio de nombres"

#: ../../tools/hvmcli/getting_started.rst:87
msgid "HVM OS (Ubuntu 24.04)"
msgstr "HVM OS (Ubuntu 24.04)"

#: ../../tools/hvmcli/getting_started.rst:88
msgid "HVM OS (Ubuntu 26.04+)"
msgstr "HVM OS (Ubuntu 26.04+)"

#: ../../tools/hvmcli/getting_started.rst:89
#: ../../tools/hvmcli/getting_started.rst:120
msgid "``virtswitch``"
msgstr "``virtswitch``"

#: ../../tools/hvmcli/getting_started.rst:90
#: ../../tools/hvmcli/getting_started.rst:93
#: ../../tools/hvmcli/getting_started.rst:96
msgid "Hidden"
msgstr "Oculto"

#: ../../tools/hvmcli/getting_started.rst:91
#: ../../tools/hvmcli/getting_started.rst:94
#: ../../tools/hvmcli/getting_started.rst:97
msgid "Available"
msgstr "Disponible"

#: ../../tools/hvmcli/getting_started.rst:92
#: ../../tools/hvmcli/getting_started.rst:140
msgid "``deploy``"
msgstr "``deploy``"

#: ../../tools/hvmcli/getting_started.rst:95
msgid "``tui``"
msgstr "``tui``"

#: ../../tools/hvmcli/getting_started.rst:99
msgid "All other namespaces are available on both versions."
msgstr "Todos los demás espacios de nombres están disponibles en ambas versiones."

#: ../../tools/hvmcli/getting_started.rst:101
msgid "Note"
msgstr "Nota"

#: ../../tools/hvmcli/getting_started.rst:101
msgid ""
"The ``virtswitch`` namespace also requires **Cluster Layout 2.0**. It is "
"not available on clusters using earlier layout versions regardless of HVM"
" OS version."
msgstr "El espacio de nombres ``virtswitch`` también requiere **Cluster Layout 2.0**. No está disponible en clústeres que usen versiones de diseño anteriores, independientemente de la versión del SO HVM."

#: ../../tools/hvmcli/getting_started.rst:104
msgid "Namespaces"
msgstr "Espacios de nombres"

#: ../../tools/hvmcli/getting_started.rst:106
msgid "``hvmcli`` is organized into the following namespaces:"
msgstr "``hvmcli`` está organizado en los siguientes espacios de nombres:"

#: ../../tools/hvmcli/getting_started.rst:114
msgid "``vm``"
msgstr "``vm``"

#: ../../tools/hvmcli/getting_started.rst:115
msgid "Manage virtual machines (list, start, stop, restart)"
msgstr "Administrar máquinas virtuales (listar, iniciar, detener, reiniciar)"

#: ../../tools/hvmcli/getting_started.rst:116
msgid "``node``"
msgstr "``node``"

#: ../../tools/hvmcli/getting_started.rst:117
msgid "Manage the physical node (configuration, backup, reboot)"
msgstr "Administrar el nodo físico (configuración, backup, reinicio)"

#: ../../tools/hvmcli/getting_started.rst:118
msgid "``interfaces``"
msgstr "``interfaces``"

#: ../../tools/hvmcli/getting_started.rst:119
msgid "List network interfaces and manage SR-IOV virtual functions"
msgstr "Enumerar interfaces de red y administrar funciones virtuales SR-IOV"

#: ../../tools/hvmcli/getting_started.rst:121
msgid "Manage Virtual Switches (create, edit, delete, import)"
msgstr "Administrar Virtual Switches (crear, editar, eliminar, importar)"

#: ../../tools/hvmcli/getting_started.rst:122
msgid "``network``"
msgstr "``network``"

#: ../../tools/hvmcli/getting_started.rst:123
msgid "List virtual networks and run connectivity tests"
msgstr "Enumerar redes virtuales y ejecutar pruebas de conectividad"

#: ../../tools/hvmcli/getting_started.rst:124
msgid "``storage``"
msgstr "``storage``"

#: ../../tools/hvmcli/getting_started.rst:125
msgid "Manage storage pools, iSCSI, Fibre Channel, and multipath"
msgstr "Administrar pools de almacenamiento, iSCSI, Fibre Channel y multipath"

#: ../../tools/hvmcli/getting_started.rst:126
msgid "``cluster``"
msgstr "``cluster``"

#: ../../tools/hvmcli/getting_started.rst:127
msgid "Show cluster state and quorum information"
msgstr "Mostrar el estado del clúster y la información de quorum"

#: ../../tools/hvmcli/getting_started.rst:128
msgid "``hardware``"
msgstr "``hardware``"

#: ../../tools/hvmcli/getting_started.rst:129
msgid "Inspect host hardware (CPU, memory, PCI, boot volume, IPMI)"
msgstr "Inspeccionar hardware del host (CPU, memoria, PCI, volumen de arranque, IPMI)"

#: ../../tools/hvmcli/getting_started.rst:130
msgid "``software``"
msgstr "``software``"

#: ../../tools/hvmcli/getting_started.rst:131
msgid "Inspect installed packages and manage OS updates"
msgstr "Inspeccionar paquetes instalados y administrar actualizaciones del SO"

#: ../../tools/hvmcli/getting_started.rst:132
msgid "``logs``"
msgstr "``logs``"

#: ../../tools/hvmcli/getting_started.rst:133
msgid "View node, cluster, and agent logs"
msgstr "Ver logs del nodo, clúster y agente"

#: ../../tools/hvmcli/getting_started.rst:134
msgid "``health``"
msgstr "``health``"

#: ../../tools/hvmcli/getting_started.rst:135
msgid "Run host readiness and health checks"
msgstr "Ejecutar verificaciones de preparación y salud del host"

#: ../../tools/hvmcli/getting_started.rst:136
msgid "``top``"
msgstr "``top``"

#: ../../tools/hvmcli/getting_started.rst:137
msgid "Real-time host and VM resource monitoring"
msgstr "Monitoreo en tiempo real de recursos del host y las VM"

#: ../../tools/hvmcli/getting_started.rst:138
msgid "``security``"
msgstr "``security``"

#: ../../tools/hvmcli/getting_started.rst:139
msgid "Security compliance operations (FIPS 140)"
msgstr "Operaciones de cumplimiento de seguridad (FIPS 140)"

#: ../../tools/hvmcli/getting_started.rst:141
msgid "Deploy VME Manager or Worker virtual machines"
msgstr "Implementar máquinas virtuales VME Manager o Worker"

