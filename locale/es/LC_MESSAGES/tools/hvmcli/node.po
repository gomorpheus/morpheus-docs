#: ../../tools/hvmcli/node.rst:70
msgid "node configure"
msgstr "node configure"

#: ../../tools/hvmcli/node.rst:72
msgid ""
"Configure various node settings. Each setting is specified with its own "
"flag."
msgstr "Configurar diversos ajustes del nodo. Cada ajuste se especifica con su propio indicador."

#: ../../tools/hvmcli/node.rst:74
msgid "**NTP Configuration:**"
msgstr "**Configuración de NTP:**"

#: ../../tools/hvmcli/node.rst:76
msgid "sudo hvmcli node configure --ntp \"time.google.com,ntp.ubuntu.com\""
msgstr "sudo hvmcli node configure --ntp \"time.google.com,ntp.ubuntu.com\""

#: ../../tools/hvmcli/node.rst:80
msgid "**DNS Configuration:**"
msgstr "**Configuración de DNS:**"

#: ../../tools/hvmcli/node.rst:82
msgid ""
"sudo hvmcli node configure --dns \"10.0.0.1,10.0.0.2\" --dns-search "
"\"example.com\""
msgstr "sudo hvmcli node configure --dns \"10.0.0.1,10.0.0.2\" --dns-search \"example.com\""

#: ../../tools/hvmcli/node.rst:86
msgid "**Hostname:**"
msgstr "**Hostname:**"

#: ../../tools/hvmcli/node.rst:88
msgid "sudo hvmcli node configure --hostname hvm-node-01"
msgstr "sudo hvmcli node configure --hostname hvm-node-01"

#: ../../tools/hvmcli/node.rst:92
msgid "**HTTP Proxy:**"
msgstr "**HTTP Proxy:**"

#: ../../tools/hvmcli/node.rst:94
msgid ""
"sudo hvmcli node configure --proxy \"http://proxy.example.com:8080\" "
"--no-proxy \"localhost,127.0.0.1\""
msgstr "sudo hvmcli node configure --proxy \"http://proxy.example.com:8080\" --no-proxy \"localhost,127.0.0.1\""

#: ../../tools/hvmcli/node.rst:98
msgid "**Locale, Keymap, and Timezone:**"
msgstr "**Locale, layout de teclado y zona horaria:**"

#: ../../tools/hvmcli/node.rst:100
msgid ""
"sudo hvmcli node configure --locale en_US.UTF-8\n"
"sudo hvmcli node configure --keymap us\n"
"sudo hvmcli node configure --timezone America/New_York"
msgstr "sudo hvmcli node configure --locale en_US.UTF-8\\nsudo hvmcli node configure --keymap us\\nsudo hvmcli node configure --timezone America/New_York"

#: ../../tools/hvmcli/node.rst:106
msgid "**Log Forwarding:**"
msgstr "**Reenvío de logs:**"

#: ../../tools/hvmcli/node.rst:108
msgid ""
"sudo hvmcli node configure --log-forwarding "
"\"syslog://logserver.example.com:514\""
msgstr "sudo hvmcli node configure --log-forwarding \"syslog://logserver.example.com:514\""

