msgstr ""

#: ../../tools/hvmcli/vm.rst:50
msgid "vm start"
msgstr "vm start"

#: ../../tools/hvmcli/vm.rst:52
msgid "Start a stopped virtual machine."
msgstr "Iniciar una máquina virtual detenida."

#: ../../tools/hvmcli/vm.rst:54
msgid "sudo hvmcli vm start --name my-vm"
msgstr ""

#: ../../tools/hvmcli/vm.rst:58 ../../tools/hvmcli/vm.rst:77
#: ../../tools/hvmcli/vm.rst:93 ../../tools/hvmcli/vm.rst:106
msgid "Options:"
msgstr "Opciones:"

#: ../../tools/hvmcli/vm.rst:60
msgid "``--name <vm>`` — Name of the virtual machine to start (required)"
msgstr "``--name <vm>`` — Nombre de la máquina virtual que se iniciará (obligatorio)"

#: ../../tools/hvmcli/vm.rst:63
msgid "vm stop"
msgstr "vm stop"

#: ../../tools/hvmcli/vm.rst:65
msgid ""
"Stop a running virtual machine. By default performs a graceful ACPI "
"shutdown."
msgstr "Detener una máquina virtual en ejecución. De forma predeterminada, realiza un apagado ACPI controlado."

#: ../../tools/hvmcli/vm.rst:67
msgid "sudo hvmcli vm stop --name my-vm"
msgstr ""

#: ../../tools/hvmcli/vm.rst:71
msgid "Force an immediate power-off (equivalent to pulling the power cord):"
msgstr "Forzar un apagado inmediato (equivalente a desconectar el cable de alimentación):"

#: ../../tools/hvmcli/vm.rst:73
msgid "sudo hvmcli vm stop --name my-vm --force"
msgstr ""

#: ../../tools/hvmcli/vm.rst:79
msgid "``--name <vm>`` — Name of the virtual machine to stop (required)"
msgstr "``--name <vm>`` — Nombre de la máquina virtual que se detendrá (obligatorio)"

#: ../../tools/hvmcli/vm.rst:80
msgid "``--force`` — Force immediate power-off without graceful shutdown"
msgstr "``--force`` — Forzar apagado inmediato sin apagado controlado"

#: ../../tools/hvmcli/vm.rst:82
msgid "Warning"
msgstr "Advertencia"

#: ../../tools/hvmcli/vm.rst:82
msgid ""
"Using ``--force`` may cause data loss or filesystem corruption if the "
"guest OS has pending writes."
msgstr "Usar ``--force`` puede provocar pérdida de datos o corrupción del sistema de archivos si el SO invitado tiene escrituras pendientes."

#: ../../tools/hvmcli/vm.rst:85
msgid "vm restart"
msgstr "vm restart"

#: ../../tools/hvmcli/vm.rst:87
msgid "Restart a virtual machine (stop then start)."
msgstr "Reiniciar una máquina virtual (detener y luego iniciar)."

#: ../../tools/hvmcli/vm.rst:89
msgid "sudo hvmcli vm restart --name my-vm"
msgstr ""

#: ../../tools/hvmcli/vm.rst:95
msgid "``--name <vm>`` — Name of the virtual machine to restart (required)"
msgstr "``--name <vm>`` — Nombre de la máquina virtual que se reiniciará (obligatorio)"

#: ../../tools/hvmcli/vm.rst:98
msgid "vm reboot"
msgstr "vm reboot"

#: ../../tools/hvmcli/vm.rst:100
msgid "Send a reboot signal to the virtual machine's guest OS."
msgstr "Enviar una señal de reinicio al SO invitado de la máquina virtual."

#: ../../tools/hvmcli/vm.rst:102
msgid "sudo hvmcli vm reboot --name my-vm"
msgstr ""

#: ../../tools/hvmcli/vm.rst:108
msgid "``--name <vm>`` — Name of the virtual machine to reboot (required)"
msgstr "``--name <vm>`` — Nombre de la máquina virtual que se reiniciará (obligatorio)"

