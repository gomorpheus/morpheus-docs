#: ../../tools/translate/README.md:1
msgid "AI Translation Pipeline"
msgstr "Pipeline de traducción con IA"

#: ../../tools/translate/README.md:3
msgid ""
"Translates Sphinx documentation `.po` files into target languages using "
"AI models, constrained by the official Morpheus UI glossary for "
"terminology consistency."
msgstr "Traduce archivos de documentación Sphinx `.po` a idiomas de destino usando modelos de IA, restringido por el glosario oficial de la interfaz de Morpheus para garantizar la coherencia terminológica."

#: ../../tools/translate/README.md:5
msgid "Prerequisites"
msgstr "Requisitos previos"

#: ../../tools/translate/README.md:7
msgid "pip3 install openai anthropic sphinx-intl\n"
msgstr ""

#: ../../tools/translate/README.md:11
msgid "Set your API key:"
msgstr "Configure su clave de API:"

#: ../../tools/translate/README.md:12
msgid ""
"export OPENAI_API_KEY=sk-...\n"
"# or\n"
"export ANTHROPIC_API_KEY=sk-ant-...\n"
msgstr ""

#: ../../tools/translate/README.md:18
msgid "Workflow"
msgstr "Flujo de trabajo"

#: ../../tools/translate/README.md:20
msgid "1. Extract glossary from UI translations"
msgstr "1. Extraer el glosario de las traducciones de la interfaz"

#: ../../tools/translate/README.md:22
msgid "python3 tools/translate/extract_glossary.py\n"
msgstr ""

#: ../../tools/translate/README.md:26
msgid ""
"This parses `../morpheus-ui/morpheus-ui/grails-"
"app/i18n/messages_es_ES.properties` and outputs "
"`tools/translate/glossary.json` with 4,000+ term mappings."
msgstr "Esto analiza `../morpheus-ui/morpheus-ui/grails-app/i18n/messages_es_ES.properties` y genera `tools/translate/glossary.json` con más de 4000 mapeos de términos."

#: ../../tools/translate/README.md:28
msgid "2. Extract translatable strings (if not done)"
msgstr "2. Extraer cadenas traducibles (si no se ha hecho)"

#: ../../tools/translate/README.md:30
msgid ""
"make gettext\n"
"make intl-update\n"
msgstr ""

#: ../../tools/translate/README.md:35
msgid "3. Translate a section"
msgstr "3. Traducir una sección"

#: ../../tools/translate/README.md:37
msgid ""
"# Dry run to see what would be translated\n"
"python3 tools/translate/translate_po.py "
"locale/es/LC_MESSAGES/getting_started --dry-run\n"
"\n"
"# Translate a single file\n"
"python3 tools/translate/translate_po.py "
"locale/es/LC_MESSAGES/getting_started/getting_started.po -v\n"
"\n"
"# Translate an entire section\n"
"python3 tools/translate/translate_po.py "
"locale/es/LC_MESSAGES/getting_started -v --report "
"report_getting_started.json\n"
"\n"
"# Translate all Spanish locale files\n"
"python3 tools/translate/translate_po.py locale/es/LC_MESSAGES -v --report"
" report_full.json\n"
msgstr ""

#: ../../tools/translate/README.md:51
msgid "4. Build the translated docs"
msgstr "4. Compilar la documentación traducida"

#: ../../tools/translate/README.md:53
msgid "make html-es\n"
msgstr ""

#: ../../tools/translate/README.md:57
msgid "Options"
msgstr "Opciones"

#: ../../tools/translate/README.md
msgid "Flag"
msgstr "Bandera"

#: ../../tools/translate/README.md
msgid "Description"
msgstr "Descripción"

#: ../../tools/translate/README.md
msgid "`--lang LANG`"
msgstr "`--lang LANG`"

#: ../../tools/translate/README.md
msgid "Target language (default: `es`)"
msgstr "Idioma de destino (predeterminado: `es`)"

#: ../../tools/translate/README.md
msgid "`--glossary PATH`"
msgstr "`--glossary PATH`"

#: ../../tools/translate/README.md
msgid "Path to glossary JSON"
msgstr "Ruta al glosario JSON"

#: ../../tools/translate/README.md
msgid "`--model MODEL`"
msgstr "`--model MODEL`"

#: ../../tools/translate/README.md
msgid "AI model: `gpt-4o` (default), `claude-sonnet-4-20250514`"
msgstr "Modelo de IA: `gpt-4o` (predeterminado), `claude-sonnet-4-20250514`"

#: ../../tools/translate/README.md
msgid "`--batch-size N`"
msgstr "`--batch-size N`"

#: ../../tools/translate/README.md
msgid "Entries per API call (default: 20)"
msgstr "Entradas por llamada a la API (predeterminado: 20)"

#: ../../tools/translate/README.md
msgid "`--dry-run`"
msgstr "`--dry-run`"

#: ../../tools/translate/README.md
msgid "Preview without making API calls"
msgstr "Vista previa sin realizar llamadas a la API"

#: ../../tools/translate/README.md
msgid "`--resume`"
msgstr "`--resume`"

#: ../../tools/translate/README.md
msgid "Skip already-translated entries (default: on)"
msgstr "Omitir entradas ya traducidas (predeterminado: activado)"

#: ../../tools/translate/README.md
msgid "`--no-resume`"
msgstr "`--no-resume`"

#: ../../tools/translate/README.md
msgid "Re-translate all entries"
msgstr "Retraducir todas las entradas"

#: ../../tools/translate/README.md
msgid "`--report PATH`"
msgstr "`--report PATH`"

#: ../../tools/translate/README.md
msgid "Write JSON report to file"
msgstr "Escribir informe JSON en un archivo"

#: ../../tools/translate/README.md
msgid "`--verbose` / `-v`"
msgstr "`--verbose` / `-v`"

#: ../../tools/translate/README.md
msgid "Detailed progress output"
msgstr "Salida de progreso detallada"

#: ../../tools/translate/README.md
msgid "`--section NAME`"
msgstr "`--section NAME`"

#: ../../tools/translate/README.md
msgid "Translate only one section subdirectory"
msgstr "Traducir solo un subdirectorio de sección"

#: ../../tools/translate/README.md:72
msgid "Multi-locale Support"
msgstr "Soporte multilingüe"

#: ../../tools/translate/README.md:74
msgid "To add a new language:"
msgstr "Para agregar un nuevo idioma:"

#: ../../tools/translate/README.md:76
msgid ""
"# 1. Generate .po files for the new locale\n"
"sphinx-intl update -p _build/gettext -l fr -d locale\n"
"\n"
"# 2. Extract glossary for the new language (if UI translations exist)\n"
"python3 tools/translate/extract_glossary.py "
"path/to/messages_fr.properties\n"
"\n"
"# 3. Translate\n"
"python3 tools/translate/translate_po.py locale/fr/LC_MESSAGES --lang fr "
"--glossary tools/translate/glossary_fr.json -v\n"
msgstr ""

#: ../../tools/translate/README.md:87
msgid "Glossary"
msgstr "Glosario"

#: ../../tools/translate/README.md:89
msgid ""
"The glossary (`glossary.json`) is extracted from the Morpheus UI i18n "
"properties file and ensures product terms match the UI exactly:"
msgstr "El glosario (`glossary.json`) se extrae del archivo de propiedades i18n de la interfaz de Morpheus y garantiza que los términos del producto coincidan exactamente con la interfaz:"

#: ../../tools/translate/README.md:91
msgid "Instance → Instancia"
msgstr "Instance → Instancia"

#: ../../tools/translate/README.md:92
msgid "Cloud → Nube"
msgstr "Cloud → Nube"

#: ../../tools/translate/README.md:93
msgid "Workflow → Flujo de trabajo"
msgstr "Workflow → Flujo de trabajo"

#: ../../tools/translate/README.md:94
msgid "Infrastructure → Infraestructura"
msgstr "Infrastructure → Infraestructura"

#: ../../tools/translate/README.md:95
msgid "etc."
msgstr "etc."

#: ../../tools/translate/README.md:97
msgid "How It Works"
msgstr "Cómo funciona"

#: ../../tools/translate/README.md:99
msgid "Parses `.po` files to find untranslated `msgid` entries"
msgstr "Analiza archivos `.po` para encontrar entradas `msgid` sin traducir"

#: ../../tools/translate/README.md:100
msgid "Batches entries (default: 20 per API call)"
msgstr "Agrupa entradas (predeterminado: 20 por llamada a la API)"

#: ../../tools/translate/README.md:101
msgid "Builds a prompt with relevant glossary terms + markup preservation rules"
msgstr "Construye un prompt con términos relevantes del glosario y reglas de preservación de marcado"

#: ../../tools/translate/README.md:102
msgid "Calls the AI model for translation"
msgstr "Llama al modelo de IA para la traducción"

#: ../../tools/translate/README.md:103
msgid "Writes translated `msgstr` values back to the `.po` file"
msgstr "Escribe los valores `msgstr` traducidos de vuelta en el archivo `.po`"

#: ../../tools/translate/README.md:104
msgid "Supports resume — re-running won't re-translate already-translated entries"
msgstr "Admite reanudación: volver a ejecutar no retraducirá entradas ya traducidas"

#: ../../tools/translate/README.md:106
msgid "Validation"
msgstr "Validación"

#: ../../tools/translate/README.md:108
msgid "After translation, validate with:"
msgstr "Después de la traducción, valide con:"

#: ../../tools/translate/README.md:110
#, python-brace-format
msgid ""
"# Check .po file syntax\n"
"find locale/es -name \"*.po\" -exec msgfmt --check {} \\;\n"
"\n"
"# Build and check for warnings\n"
"make html-es\n"
msgstr ""

