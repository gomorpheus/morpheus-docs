"<p>{{{i18n \"com.bertramlabs.plugins.accounts.password.email.message\"}}}</p>\n"
"<a href={{{url}}}>{{{i18n \"com.bertramlabs.plugins.accounts.password.email.linkLabel\"}}}</a>\n"
"<p>{{{i18n \"com.bertramlabs.plugins.accounts.password.email.signature\"}}} </p>\n"
"<!-- available hbs variables are user.displayName and user.username -->"
msgstr ""
"<p>{{{i18n \"com.bertramlabs.plugins.cuentas.contraseña.correo electrónico.greeting\"}}}</p>\n"
"<p>{{{i18n \"com.bertramlabs.plugins.cuentas.contraseña.correo electrónico.message\"}}}</p>\n"
"<a href={{{url}}}>{{{i18n \"com.bertramlabs.plugins.cuentas.contraseña.correo electrónico.linkLabel\"}}}</a>\n"
"<p>{{{i18n \"com.bertramlabs.plugins.cuentas.contraseña.correo electrónico.signature\"}}} </p>\n"
"<!-- available hbs variables are user.displayName and user.username -->"

