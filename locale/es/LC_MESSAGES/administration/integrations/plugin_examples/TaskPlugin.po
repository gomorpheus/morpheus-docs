msgid "Task Plugin"
msgstr "Tarea Plugin"

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:3
msgid "Add custom Tasks types to Morpheus"
msgstr "Agregar personalizado Tareas tipos a Morpheus"

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:6
msgid "Setup"
msgstr "Setup"

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:8
msgid ""
"Tasks (called Jobs in the UI) are useful components of your provisioning "
"workflow. This plugin allows you to create custom Tasks"
msgstr ""
"Tareas (llamado Jobs en el UI) son useful components de su aprovisionamiento"
" flujo de trabajo. Este plugin le permite crear personalizado Tareas"

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:10
msgid ""
"Create a new class that implements ``com.morpheusdata.core.TaskProvider``"
msgstr ""
"Crear a nuevo class ese implements ``com.morpheusdata.core.TaskProvider``"

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:11
msgid ""
"Create a new class that extends "
"``com.morpheusdata.core.AbstractTaskService``."
msgstr ""
"Crear a nuevo class ese extends "
"``com.morpheusdata.core.AbstractTaskService``."

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:13
msgid ""
"This service defines methods for task execution in a variety of contexts, "
"described below."
msgstr ""
"Este service define methods para tarea execution en a variety de contexts, "
"descrito a continuación."

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:16
msgid "Options"
msgstr "Opciones"

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:18
msgid ""
"``OptionType`` is an easy way to create configuration for your new Task. "
"Simply provide a list of ``com.morpheusdata.model.OptionType`` to the "
"``TaskProvider.getOptionTypes`` method."
msgstr ""
"``OptionType`` es un easy way a crear configuración para su nuevo Tarea. "
"Simply provide a lista de ``com.morpheusdata.model.OptionType`` a el "
"``TaskProvider.getOptionTypes`` method."

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:20
#, python-brace-format
msgid ""
"@Override\n"
"List<OptionType> getOptionTypes() {\n"
"        OptionType optionType = new OptionType(\n"
"                        name: 'myTask',\n"
"                        code: 'myTaskText',\n"
"                        fieldName: 'myTask',\n"
"                        optionSource: true,\n"
"                        displayOrder: 0,\n"
"                        fieldLabel: 'Text to Reverse',\n"
"                        required: true,\n"
"                        inputType: OptionType.InputType.TEXT\n"
"        )\n"
"        return [optionType]\n"
"}"
msgstr ""
"@Override\n"
"Lista<OptionType> getOptionTypes() {\n"
" OptionType optionType = nuevo OptionType(\n"
" nombre: 'myTarea',\n"
" code: 'myTareaText',\n"
" fieldName: 'myTarea',\n"
" optionSource: true,\n"
" displayOrder: 0,\n"
" fieldLabel: 'Text a Reverse',\n"
" requerido: true,\n"
" inputType: OptionType.InputType.TEXT\n"
" )\n"
" return [optionType]\n"
"}"

