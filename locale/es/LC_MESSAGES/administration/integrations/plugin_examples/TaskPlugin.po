msgstr "Tarea Logo"

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:49
#, python-brace-format
msgid ""
"A custom logo can be used in the Morpheus UI by placing an image at "
"``src/assets/images/{task-code}.png``. Recommended file size is 180 x 60 px."
msgstr ""
"Un personalizado logo puede ser usado en el Morpheus UI por placing un image"
" en ``src/assets/images/{task-code}.png``. Recomendado file size es 180 x 60"
" px."
