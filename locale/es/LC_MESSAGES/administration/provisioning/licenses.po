#: ../../administration/provisioning/licenses.rst:122
msgid "Licenses can be managed via the |morpheus| API:"
msgstr "Licencias puede ser gestionado a través de el |morpheus| API:"

#: ../../administration/provisioning/licenses.rst:124
#, python-brace-format
msgid ""
"# List licenses\n"
"curl \"$MORPHEUS_API_URL/api/provisioning-licenses\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Create a license\n"
"curl -X POST \"$MORPHEUS_API_URL/api/provisioning-licenses\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\n"
"    \"license\": {\n"
"      \"licenseType\": \"win\",\n"
"      \"name\": \"Windows Server 2022 Datacenter\",\n"
"      \"licenseKey\": \"XXXXX-XXXXX-XXXXX-XXXXX-XXXXX\",\n"
"      \"licenseVersion\": \"2022\",\n"
"      \"copies\": 50,\n"
"      \"description\": \"Datacenter license for production\"\n"
"    }\n"
"  }'"
msgstr ""
"# Lista licencias\n"
"curl \"$MORPHEUS_API_URL/api/aprovisionamiento-licencias\" \\\n"
" -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Crear a licencia\n"
"curl -X POST \"$MORPHEUS_API_URL/api/aprovisionamiento-licencias\" \\\n"
" -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
" -H \"Content-Tipo: application/json\" \\\n"
" -d '{\n"
" \"licencia\": {\n"
" \"licenciaType\": \"win\",\n"
" \"nombre\": \"Windows Servidor 2022 Datacenter\",\n"
" \"licenciaKey\": \"XXXXX-XXXXX-XXXXX-XXXXX-XXXXX\",\n"
" \"licenciaVersion\": \"2022\",\n"
" \"copies\": 50,\n"
" \"description\": \"Datacenter licencia para production\"\n"
" }\n"
" }'"
