msgid "**NONE** — No encryption; the response is sent in plaintext"
msgstr "**NONE** — No encryption; el response es sent en plaintext"

#: ../../administration/identity_sources/custom_external.rst:41
#: ../../administration/identity_sources/custom_iam_api.rst:43
msgid "**AES** — Advanced Encryption Standard"
msgstr "**AES** — Advanced Encryption Standard"

