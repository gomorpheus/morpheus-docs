#: ../../administration/logging/appliance_logs.rst:17
msgid "``/var/log/morpheus/morpheus-ui/current``"
msgstr ""

#: ../../administration/logging/appliance_logs.rst:18
msgid "Main application log (current)"
msgstr "Log principal de aplicación (actual)"

#: ../../administration/logging/appliance_logs.rst:19
msgid "``/var/log/morpheus/morpheus-ui/``"
msgstr ""

#: ../../administration/logging/appliance_logs.rst:20
msgid "Rotated application logs"
msgstr "Logs de aplicación rotados"

#: ../../administration/logging/appliance_logs.rst:21
msgid "``/var/log/morpheus/nginx/``"
msgstr ""

#: ../../administration/logging/appliance_logs.rst:22
msgid "Reverse proxy access and error logs"
msgstr "Logs de acceso y error del proxy inverso"

#: ../../administration/logging/appliance_logs.rst:23
msgid "``/var/log/morpheus/mysql/``"
msgstr ""

#: ../../administration/logging/appliance_logs.rst:24
msgid "Embedded MySQL logs (if using embedded DB)"
msgstr "Logs MySQL integrados (si se usa DB integrada)"

