#: ../../tools/ai/morpheus_mcp_server.rst:583
msgid "Important"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:40
msgid ""
"Your Morpheus appliance **must have a valid, signed SSL certificate** "
"configured for external MCP clients to connect. Self-signed or untrusted "
"certificates will cause TLS verification failures in MCP clients (Claude "
"Desktop, VS Code, etc.) that cannot be easily bypassed. See :ref:`SSL "
"Certificates` for configuration details."
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:43
msgid "Authentication"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:45
msgid ""
"External clients authenticate using the same mechanisms as the Morpheus "
"REST API:"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:47
msgid ""
"**Bearer Token** — ``Authorization: Bearer <your-api-token>`` header "
"(recommended)"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:48
msgid "**Access Token** — ``?access_token=<token>`` query parameter"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:49
msgid ""
"**Execution Token** — ``Authorization: Execution <token>`` header (for "
"task/job contexts)"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:51
msgid ""
"All tool executions enforce the authenticated user's role permissions. A "
"user can only access tools and resources their Morpheus role allows."
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:54
msgid "Connecting External Clients"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:56
msgid "**Claude Desktop, Cursor, VS Code, or any MCP-compatible client:**"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:58
#, python-brace-format
msgid ""
"{\n"
"  \"mcpServers\": {\n"
"    \"morpheus\": {\n"
"      \"url\": \"https://your-morpheus-host/api/mcp\",\n"
"      \"headers\": {\n"
"        \"Authorization\": \"Bearer your-api-token-here\"\n"
"      }\n"
"    }\n"
"  }\n"
"}"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:71
msgid "**Custom scripts (Python, Node, etc.):**"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:73
msgid ""
"Any HTTP client that supports the MCP Streamable HTTP transport can "
"connect. Send a ``POST`` to ``/api/mcp`` with a JSON-RPC 2.0 "
"``initialize`` message to start a session, then use the returned ``Mcp-"
"Session-Id`` header on subsequent requests."
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:76
msgid "Session Management"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:78
msgid "Sessions are created on successful ``initialize`` handshake"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:79
msgid ""
"The server returns a ``Mcp-Session-Id`` response header — include this on"
" all subsequent requests"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:80
msgid "Sessions expire after **1 hour** of inactivity"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:81
msgid ""
"Use ``DELETE /api/mcp`` with the session header to explicitly terminate a"
" session"
msgstr ""

