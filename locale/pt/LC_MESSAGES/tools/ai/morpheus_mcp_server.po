#: ../../tools/ai/morpheus_mcp_server.rst:433
msgid "Sessions are isolated per user — no cross-user data leakage"
msgstr "As sessões são isoladas por usuário — sem vazamento de dados entre usuários"

#: ../../tools/ai/morpheus_mcp_server.rst:436
msgid "Exposing to External MCP Clients"
msgstr "Expondo a Clientes MCP Externos"

#: ../../tools/ai/morpheus_mcp_server.rst:438
msgid ""
"This section provides step-by-step instructions for connecting external "
"MCP clients to your Morpheus appliance."
msgstr "Esta seção fornece instruções passo a passo para conectar clientes MCP externos ao seu appliance Morpheus."

#: ../../tools/ai/morpheus_mcp_server.rst:441
msgid "Generate a Morpheus API Token"
msgstr "Gerar um Token de API Morpheus"

#: ../../tools/ai/morpheus_mcp_server.rst:443
msgid "To authenticate external MCP clients, you need a Morpheus API token."
msgstr "Para autenticar clientes MCP externos, você precisa de um token de API Morpheus."

#: ../../tools/ai/morpheus_mcp_server.rst:445
msgid "**Via the Morpheus UI:**"
msgstr "**Via a UI do Morpheus:**"

#: ../../tools/ai/morpheus_mcp_server.rst:447
msgid "Navigate to **User Settings > API Keys** tab"
msgstr "Navegue até a aba **User Settings > API Keys**"

#: ../../tools/ai/morpheus_mcp_server.rst:448
msgid "Click **+ADD**"
msgstr "Clique em **+ADD**"

#: ../../tools/ai/morpheus_mcp_server.rst:449
msgid "Provide a descriptive name (e.g., ``mcp-claude-desktop``)"
msgstr "Forneça um nome descritivo (ex.: ``mcp-claude-desktop``)"

#: ../../tools/ai/morpheus_mcp_server.rst:450
msgid "Select the appropriate **Client ID**"
msgstr "Selecione o **Client ID** apropriado"

#: ../../tools/ai/morpheus_mcp_server.rst:451
msgid "Click **Save** and copy the generated key"
msgstr "Clique em **Save** e copie a chave gerada"

#: ../../tools/ai/morpheus_mcp_server.rst:453
msgid "**Via curl:**"
msgstr "**Via curl:**"

#: ../../tools/ai/morpheus_mcp_server.rst:455
msgid ""
"curl -X POST \"https://your-morpheus-host/oauth/token\" \\\n"
"  -H \"Content-Type: application/x-www-form-urlencoded\" \\\n"
"  -d \"grant_type=password&scope=write&client_id=morph-"
"api&username=YOUR_USER&password=YOUR_PASS\""
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:461
msgid ""
"The response contains an ``access_token`` field that you use as your "
"Bearer token."
msgstr "A resposta contém um campo ``access_token`` que você usa como seu Bearer token."

