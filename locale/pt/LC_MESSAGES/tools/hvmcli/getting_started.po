msgid "Usage"
msgstr "Uso"

#: ../../tools/hvmcli/getting_started.rst:22
msgid "The general syntax for ``hvmcli`` commands is:"
msgstr "A sintaxe geral dos comandos ``hvmcli`` é:"

#: ../../tools/hvmcli/getting_started.rst:24
msgid "sudo hvmcli <namespace> <command> [options]"
msgstr ""

#: ../../tools/hvmcli/getting_started.rst:28
msgid "For example:"
msgstr "Por exemplo:"

#: ../../tools/hvmcli/getting_started.rst:30
msgid ""
"sudo hvmcli vm list\n"
"sudo hvmcli node list\n"
"sudo hvmcli virtswitch list"
msgstr ""

#: ../../tools/hvmcli/getting_started.rst:36
msgid "To get help on any namespace:"
msgstr "Para obter ajuda sobre qualquer namespace:"

#: ../../tools/hvmcli/getting_started.rst:38
msgid "sudo hvmcli <namespace> help"
msgstr ""

