msgid "Namespaces"
msgstr "Namespaces"

#: ../../tools/hvmcli/getting_started.rst:106
msgid "``hvmcli`` is organized into the following namespaces:"
msgstr "O ``hvmcli`` está organizado nos seguintes namespaces:"

#: ../../tools/hvmcli/getting_started.rst:114
msgid "``vm``"
msgstr "``vm``"

#: ../../tools/hvmcli/getting_started.rst:115
msgid "Manage virtual machines (list, start, stop, restart)"
msgstr "Gerenciar máquinas virtuais (list, start, stop, restart)"

#: ../../tools/hvmcli/getting_started.rst:116
msgid "``node``"
msgstr "``node``"

#: ../../tools/hvmcli/getting_started.rst:117
msgid "Manage the physical node (configuration, backup, reboot)"
msgstr "Gerenciar o nó físico (configuração, backup, reboot)"

#: ../../tools/hvmcli/getting_started.rst:118
msgid "``interfaces``"
msgstr "``interfaces``"

#: ../../tools/hvmcli/getting_started.rst:119
msgid "List network interfaces and manage SR-IOV virtual functions"
msgstr "Listar interfaces de rede e gerenciar funções virtuais SR-IOV"

#: ../../tools/hvmcli/getting_started.rst:121
msgid "Manage Virtual Switches (create, edit, delete, import)"
msgstr "Gerenciar Virtual Switches (create, edit, delete, import)"

#: ../../tools/hvmcli/getting_started.rst:122
msgid "``network``"
msgstr "``network``"

#: ../../tools/hvmcli/getting_started.rst:123
msgid "List virtual networks and run connectivity tests"
msgstr "Listar redes virtuais e executar testes de conectividade"

#: ../../tools/hvmcli/getting_started.rst:124
msgid "``storage``"
msgstr "``storage``"

#: ../../tools/hvmcli/getting_started.rst:125
