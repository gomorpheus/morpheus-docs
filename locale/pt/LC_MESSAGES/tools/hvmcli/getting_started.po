msgid "``health``"
msgstr "``health``"

#: ../../tools/hvmcli/getting_started.rst:135
msgid "Run host readiness and health checks"
msgstr "Executar verificações de prontidão e integridade do Host"

#: ../../tools/hvmcli/getting_started.rst:136
msgid "``top``"
msgstr "``top``"

#: ../../tools/hvmcli/getting_started.rst:137
