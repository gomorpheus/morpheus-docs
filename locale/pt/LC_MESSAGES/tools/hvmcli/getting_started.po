msgstr "Gerenciar storage pools, iSCSI, Fibre Channel e multipath"

#: ../../tools/hvmcli/getting_started.rst:126
msgid "``cluster``"
msgstr "``cluster``"

#: ../../tools/hvmcli/getting_started.rst:127
