#: ../../tools/hvmcli/deploy.rst:2
msgid "deploy"
msgstr "deploy"

#: ../../tools/hvmcli/deploy.rst:4
msgid ""
"Deploy VME (VM Essentials) Manager or Worker virtual machines on the HVM "
"host."
msgstr "Implantar máquinas virtuais VME (VM Essentials) Manager ou Worker no Host HVM."

#: ../../tools/hvmcli/deploy.rst:7
msgid "Commands"
msgstr "Comandos"

#: ../../tools/hvmcli/deploy.rst:13
msgid "Command"
msgstr "Comando"

#: ../../tools/hvmcli/deploy.rst:14
msgid "Description"
msgstr "Descrição"

#: ../../tools/hvmcli/deploy.rst:15
msgid "``manager``"
msgstr "``manager``"

#: ../../tools/hvmcli/deploy.rst:16
msgid "Deploy, manage, or check status of the VME Manager VM"
msgstr "Implantar, gerenciar ou verificar o status da VM VME Manager"

#: ../../tools/hvmcli/deploy.rst:17
msgid "``worker``"
msgstr "``worker``"

#: ../../tools/hvmcli/deploy.rst:18
msgid "Deploy, manage, or check status of a VME Worker VM"
msgstr "Implantar, gerenciar ou verificar o status de uma VM VME Worker"

#: ../../tools/hvmcli/deploy.rst:21
msgid "deploy manager"
msgstr "deploy manager"

#: ../../tools/hvmcli/deploy.rst:23
msgid "Deploy or manage the VME Manager appliance virtual machine."
msgstr "Implantar ou gerenciar a máquina virtual do appliance VME Manager."

#: ../../tools/hvmcli/deploy.rst:25
msgid "**Deploy a new Manager VM:**"
msgstr "**Implantar uma nova VM Manager:**"

#: ../../tools/hvmcli/deploy.rst:27
msgid ""
"sudo hvmcli deploy manager \\\n"
"  --ip 10.1.1.100 \\\n"
"  --netmask 255.255.255.0 \\\n"
"  --gateway 10.1.1.1 \\\n"
"  --hostname vme-mgr \\\n"
"  --image file:///mnt/iso/morpheus.qcow2 \\\n"
"  --interface enp3s0 \\\n"
"  --admin-user morphadmin \\\n"
"  --admin-password-stdin"
msgstr ""

#: ../../tools/hvmcli/deploy.rst:39 ../../tools/hvmcli/deploy.rst:74
msgid "Options:"
msgstr "Opções:"

#: ../../tools/hvmcli/deploy.rst:41
msgid "``--ip <address>`` — Static IP address for the Manager VM"
msgstr "``--ip <address>`` — Endereço IP estático para a VM Manager"

#: ../../tools/hvmcli/deploy.rst:42
msgid "``--netmask <mask>`` — Subnet mask"
msgstr "``--netmask <mask>`` — Máscara de sub-rede"

#: ../../tools/hvmcli/deploy.rst:43
msgid "``--gateway <address>`` — Default gateway"
msgstr "``--gateway <address>`` — Gateway padrão"

#: ../../tools/hvmcli/deploy.rst:44
msgid "``--hostname <name>`` — Hostname for the VM"
msgstr "``--hostname <name>`` — Hostname da VM"

#: ../../tools/hvmcli/deploy.rst:45
msgid ""
"``--image <uri>`` — Path or URL to the QCOW2 image (``file://`` or "
"``http://``)"
msgstr "``--image <uri>`` — Caminho ou URL para a imagem QCOW2 (``file://`` ou ``http://``)"

#: ../../tools/hvmcli/deploy.rst:46
msgid "``--interface <nic>`` — Host interface for the VM network"
msgstr "``--interface <nic>`` — Interface do Host para a rede da VM"

#: ../../tools/hvmcli/deploy.rst:47
msgid "``--admin-user <username>`` — Administrator username for the appliance"
msgstr "``--admin-user <username>`` — Nome de usuário administrador do appliance"

#: ../../tools/hvmcli/deploy.rst:48
msgid ""
"``--admin-password-stdin`` — Read admin password from stdin (secure, no "
"shell history)"
msgstr "``--admin-password-stdin`` — Ler a senha de administrador do stdin (seguro, sem histórico do shell)"

#: ../../tools/hvmcli/deploy.rst:50
msgid "**Run pre-deployment checks:**"
msgstr "**Executar verificações pré-implantação:**"

#: ../../tools/hvmcli/deploy.rst:52
msgid ""
"sudo hvmcli deploy manager precheck \\\n"
"  --ip 10.1.1.100 \\\n"
"  --interface enp3s0 \\\n"
"  --image file:///mnt/iso/morpheus.qcow2 \\\n"
"  --json"
msgstr ""

#: ../../tools/hvmcli/deploy.rst:60
msgid "**Check Manager VM status:**"
msgstr "**Verificar o status da VM Manager:**"

#: ../../tools/hvmcli/deploy.rst:62
msgid ""
"sudo hvmcli deploy manager status\n"
"sudo hvmcli deploy manager status --json"
msgstr ""

#: ../../tools/hvmcli/deploy.rst:67
msgid "**View Manager deployment logs:**"
msgstr "**Visualizar logs de implantação do Manager:**"

#: ../../tools/hvmcli/deploy.rst:69
msgid ""
"sudo hvmcli deploy manager logs\n"
"sudo hvmcli deploy manager logs --lines 100 --diagnostics"
msgstr ""

#: ../../tools/hvmcli/deploy.rst:76
msgid "``--lines <n>`` — Number of log lines to display"
msgstr "``--lines <n>`` — Número de linhas de log a exibir"

#: ../../tools/hvmcli/deploy.rst:77
msgid "``--diagnostics`` — Include diagnostic information"
msgstr "``--diagnostics`` — Incluir informações de diagnóstico"

#: ../../tools/hvmcli/deploy.rst:80
msgid "deploy worker"
msgstr "deploy worker"

#: ../../tools/hvmcli/deploy.rst:82
msgid "Deploy or manage a VME Worker virtual machine."
msgstr "Implantar ou gerenciar uma máquina virtual VME Worker."

#: ../../tools/hvmcli/deploy.rst:84
msgid "**Deploy a new Worker VM:**"
msgstr "**Implantar uma nova VM Worker:**"

#: ../../tools/hvmcli/deploy.rst:86
msgid ""
"sudo hvmcli deploy worker \\\n"
"  --ip 10.1.1.110 \\\n"
"  --netmask 255.255.255.0 \\\n"
"  --gateway 10.1.1.1 \\\n"
"  --hostname vme-wkr1 \\\n"
"  --image file:///mnt/iso/morpheus.qcow2 \\\n"
"  --interface enp3s0 \\\n"
"  --worker-url https://10.1.1.100 \\\n"
"  --worker-key abc123 \\\n"
"  --apikey def456 \\\n"
"  --admin-password-stdin"
msgstr ""

#: ../../tools/hvmcli/deploy.rst:100
msgid "Additional options for Worker:"
msgstr "Opções adicionais para Worker:"

#: ../../tools/hvmcli/deploy.rst:102
msgid "``--worker-url <url>`` — URL of the Manager VM to register with"
msgstr "``--worker-url <url>`` — URL da VM Manager com a qual se registrar"

#: ../../tools/hvmcli/deploy.rst:103
msgid "``--worker-key <key>`` — Worker registration key from the Manager"
msgstr "``--worker-key <key>`` — Chave de registro do Worker do Manager"

#: ../../tools/hvmcli/deploy.rst:104
msgid "``--apikey <key>`` — API key for Manager authentication"
msgstr "``--apikey <key>`` — Chave de API para autenticação no Manager"

#: ../../tools/hvmcli/deploy.rst:106
msgid "**Check Worker VM status:**"
msgstr "**Verificar o status da VM Worker:**"

#: ../../tools/hvmcli/deploy.rst:108
msgid "sudo hvmcli deploy worker status --json"
msgstr ""

#: ../../tools/hvmcli/deploy.rst:112
msgid "Tip"
msgstr "Dica"

#: ../../tools/hvmcli/deploy.rst:112
msgid ""
"Always run ``deploy manager precheck`` before deploying to validate that "
"network connectivity, image accessibility, and host resources are "
"adequate."
msgstr "Sempre execute ``deploy manager precheck`` antes de implantar para validar se a conectividade de rede, a acessibilidade da imagem e os recursos do Host são adequados."

