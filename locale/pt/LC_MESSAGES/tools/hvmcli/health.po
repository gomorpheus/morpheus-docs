#: ../../tools/hvmcli/health.rst:21
msgid "health check"
msgstr "health check"

#: ../../tools/hvmcli/health.rst:23
msgid ""
"Run a comprehensive set of host readiness checks including cluster state,"
" VM health, NTP sync, resource availability, gateway reachability, agent "
"status, uplink state, iSCSI connectivity, and multipath configuration."
msgstr "Executar um conjunto abrangente de verificações de prontidão do Host, incluindo estado do cluster, integridade das VMs, sincronização NTP, disponibilidade de recursos, alcançabilidade do gateway, status do agente, estado do uplink, conectividade iSCSI e configuração multipath."

#: ../../tools/hvmcli/health.rst:25
msgid "sudo hvmcli health check"
msgstr ""

#: ../../tools/hvmcli/health.rst:29
msgid "sudo hvmcli health check --json"
msgstr ""

#: ../../tools/hvmcli/health.rst:33
msgid "The check covers:"
msgstr "A verificação cobre:"

#: ../../tools/hvmcli/health.rst:35
msgid "**Cluster** — Cluster membership and quorum state"
msgstr "**Cluster** — Associação ao cluster e estado de quorum"

#: ../../tools/hvmcli/health.rst:36
msgid "**VMs** — VM health and consistency"
msgstr "**VMs** — Integridade e consistência das VMs"

#: ../../tools/hvmcli/health.rst:37
msgid "**NTP** — Time synchronization status"
msgstr "**NTP** — Status de sincronização de tempo"

#: ../../tools/hvmcli/health.rst:38
msgid "**Resources** — CPU, memory, and disk availability"
msgstr "**Resources** — Disponibilidade de CPU, memória e disco"

#: ../../tools/hvmcli/health.rst:39
msgid "**Gateway** — Network gateway reachability"
msgstr "**Gateway** — Alcançabilidade do gateway de rede"

#: ../../tools/hvmcli/health.rst:40
msgid "**Agent** — Morpheus agent connectivity"
msgstr "**Agent** — Conectividade do agente Morpheus"

#: ../../tools/hvmcli/health.rst:41
msgid "**Uplinks** — Physical NIC link state"
msgstr "**Uplinks** — Estado do link das NICs físicas"

#: ../../tools/hvmcli/health.rst:42
msgid "**iSCSI** — iSCSI session health (if configured)"
msgstr "**iSCSI** — Integridade da sessão iSCSI (se configurada)"

#: ../../tools/hvmcli/health.rst:43
msgid "**Multipath** — Multipath path availability (if configured)"
msgstr "**Multipath** — Disponibilidade de caminhos multipath (se configurada)"

#: ../../tools/hvmcli/health.rst:46
msgid "health watch"
msgstr "health watch"

#: ../../tools/hvmcli/health.rst:48
msgid "Continuously run health checks at a specified interval."
msgstr "Executar continuamente verificações de integridade em um intervalo especificado."

#: ../../tools/hvmcli/health.rst:50
msgid "sudo hvmcli health watch --interval 30"
msgstr ""

#: ../../tools/hvmcli/health.rst:54
msgid "Options:"
msgstr "Opções:"

#: ../../tools/hvmcli/health.rst:56
msgid "``--interval <seconds>`` — Polling interval in seconds (default: 60)"
msgstr "``--interval <seconds>`` — Intervalo de polling em segundos (padrão: 60)"

#: ../../tools/hvmcli/health.rst:58
msgid "Tip"
msgstr "Dica"

#: ../../tools/hvmcli/health.rst:58
msgid ""
"Use ``health watch`` during maintenance operations to continuously "
"monitor host health and detect issues early."
msgstr "Use ``health watch`` durante operações de manutenção para monitorar continuamente a integridade do Host e detectar problemas cedo."

