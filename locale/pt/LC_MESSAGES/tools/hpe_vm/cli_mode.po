msgid "CLI (Non-Interactive) Mode"
msgstr ""

#: ../../tools/hpe_vm/cli_mode.rst:4
msgid ""
"In addition to the interactive TUI, ``hpe-vm`` supports a fully non-"
"interactive command-line mode for automated or scripted deployments."
msgstr ""

#: ../../tools/hpe_vm/cli_mode.rst:7
msgid "Usage"
msgstr ""

#: ../../tools/hpe_vm/cli_mode.rst:9
msgid ""
"sudo hpe-vm --install [options]        # Deploy VME Manager\n"
"sudo hpe-vm --install-worker [options]  # Deploy VME Worker"
msgstr ""

#: ../../tools/hpe_vm/cli_mode.rst:14
msgid ""
"If ``--install`` or ``--install-worker`` is specified, the TUI is not "
"launched. The deployment runs to completion and exits."
