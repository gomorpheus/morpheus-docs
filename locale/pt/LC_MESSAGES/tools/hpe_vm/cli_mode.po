msgstr "Mostrar informações de uso"

#: ../../tools/hpe_vm/cli_mode.rst:85
msgid "Example"
msgstr "Exemplo"

#: ../../tools/hpe_vm/cli_mode.rst:87
msgid "Deploy a VME Manager non-interactively:"
msgstr "Implantar um VME Manager de forma não interativa:"

#: ../../tools/hpe_vm/cli_mode.rst:89
msgid ""
"sudo hpe-vm --install \\\n"
"  --address 192.168.1.100 \\\n"
"  --netmask 255.255.255.0 \\\n"
"  --gateway 192.168.1.1 \\\n"
"  --dns 192.168.1.1 \\\n"
"  --hostname morpheus.example.com \\\n"
"  --applianceUrl https://morpheus.example.com \\\n"
"  --password 'SecurePass123!' \\\n"
"  --imageUrl file:///mnt/iso/hpe-vm-essentials-9.0.0-1.qcow2 \\\n"
"  --interface eno1 \\\n"
"  --size large"
msgstr ""

#: ../../tools/hpe_vm/cli_mode.rst:103
msgid "Deploy a VME Worker:"
msgstr "Implantar um VME Worker:"

#: ../../tools/hpe_vm/cli_mode.rst:105
msgid ""
"sudo hpe-vm --install-worker \\\n"
"  --address 192.168.1.101 \\\n"
"  --netmask 255.255.255.0 \\\n"
"  --gateway 192.168.1.1 \\\n"
"  --dns 192.168.1.1 \\\n"
"  --hostname worker01.example.com \\\n"
"  --workerUrl https://worker01.example.com \\\n"
"  --applianceUrl https://morpheus.example.com \\\n"
"  --password 'SecurePass123!' \\\n"
"  --imageUrl file:///mnt/iso/hpe-vm-essentials-9.0.0-1.qcow2 \\\n"
"  --interface eno1 \\\n"
"  --workerKey 'abc123-worker-key' \\\n"
"  --apikey 'xyz789-api-key'"
msgstr ""

#: ../../tools/hpe_vm/cli_mode.rst:122
msgid "Exit Codes"
msgstr "Códigos de Saída"

#: ../../tools/hpe_vm/cli_mode.rst:124
msgid "``0`` — Deployment completed successfully"
msgstr "``0`` — Implantação concluída com sucesso"

#: ../../tools/hpe_vm/cli_mode.rst:125
msgid "Non-zero — Deployment failed; check console output for error details"
msgstr "Diferente de zero — A implantação falhou; verifique a saída do console para detalhes do erro"

