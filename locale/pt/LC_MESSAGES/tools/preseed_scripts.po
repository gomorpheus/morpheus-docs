#: ../../tools/preseed_scripts.rst:187
msgid "API"
msgstr "API"

#: ../../tools/preseed_scripts.rst:189
msgid "Preseed scripts can be managed via the |morpheus| API:"
msgstr "Preseed scripts podem ser gerenciados via API do |morpheus|:"

#: ../../tools/preseed_scripts.rst:191
#, python-brace-format
msgid ""
"# List preseed scripts\n"
"curl \"$MORPHEUS_API_URL/api/preseed-scripts\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Create a preseed script\n"
"curl -X POST \"$MORPHEUS_API_URL/api/preseed-scripts\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\n"
"    \"preseedScript\": {\n"
"      \"fileName\": \"ubuntu-22.04.seed\",\n"
"      \"description\": \"Ubuntu 22.04 preseed for production\",\n"
"      \"content\": \"d-i debian-installer/locale string "
"en_US.UTF-8\\n...\"\n"
"    }\n"
"  }'"
msgstr ""

