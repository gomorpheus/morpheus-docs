#: ../../shared/morpheusTerminology.rst:4
msgid "RPC User"
msgstr ""

#: ../../shared/morpheusTerminology.rst:5
msgid ""
"The RPC user is a setting on Hosts used for authorization during Remote "
"Procedure Call (RPC) executions over winrm, ssh and guest tools. aka the "
"user |morpheus| uses to connect to remote hosts/vms/workloads. The RPC "
"user can be updated/set by editing a host record."
msgstr ""

