#: ../../backups/integrations/commvault.rst:24
msgid "Adding Commvault Integration"
msgstr "Adicionando Integração Commvault"

#: ../../backups/integrations/commvault.rst:26
msgid "Navigate to :menuselection:`Backups --> Services`"
msgstr "Navegue até :menuselection:`Backups --> Services`"

#: ../../backups/integrations/commvault.rst:27
msgid "Select :guilabel:`+ ADD`"
msgstr "Selecione :guilabel:`+ ADD`"

#: ../../backups/integrations/commvault.rst:28
msgid "Select Commvault"
msgstr "Selecione Commvault"

#: ../../backups/integrations/commvault.rst:29
msgid "Fill in the following:"
msgstr "Preencha o seguinte:"

#: ../../backups/integrations/commvault.rst:31
msgid "Name"
msgstr "Nome"

#: ../../backups/integrations/commvault.rst:32
msgid "Name of the Integration in |morpheus|"
msgstr "Nome da Integração no |morpheus|"

#: ../../backups/integrations/commvault.rst:33
msgid "Enabled"
msgstr "Ativado"

#: ../../backups/integrations/commvault.rst:34
msgid "Enable the Commvault integration"
msgstr "Ativar a integração Commvault"

#: ../../backups/integrations/commvault.rst:35
msgid "Host"
msgstr "Host"

#: ../../backups/integrations/commvault.rst:36
msgid "IP or Hostname of the Commvault server."
msgstr "IP ou Hostname do servidor Commvault."

#: ../../backups/integrations/commvault.rst:37
msgid "Port"
msgstr "Porta"

#: ../../backups/integrations/commvault.rst:38
