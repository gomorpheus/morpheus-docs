" 10"
msgstr "Número da porta configurada para acessar o servidor Veeam; deve ser 9398 para VEEAM 10"

#: ../../backups/integrations/veeam.rst:41
msgid "Username"
msgstr "Nome do Usuário"

#: ../../backups/integrations/veeam.rst:42
