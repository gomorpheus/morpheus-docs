#: ../../provisioning/automation/write_attributes.rst:4
msgid "Write Attributes Task"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:7
msgid "Overview"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:9
msgid ""
"The Write Attributes Task type writes a JSON payload of key-value pairs "
"to the attributes property of the target resource (Instance, server, or "
"container). This enables passing data between Tasks and Workflow phases, "
"storing computed values for later reference, and building dynamic "
"configuration state during provisioning."
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:11
msgid "Write Attributes Tasks are particularly useful for:"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:13
msgid ""
"Storing values from one Provisioning Workflow phase for use in another "
"phase"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:14
msgid "Passing computed configuration between Tasks"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:15
msgid "Building dynamic metadata that other Tasks or integrations can reference"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:16
msgid "Tagging resources with runtime-determined properties"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:19
msgid "Creating a Write Attributes Task"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:21
msgid "Navigate to :menuselection:`Library --> Automation` > Tasks"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:22
msgid "Click :guilabel:`+ ADD`"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:23
msgid "Select **Write Attributes** as the Task Type"
msgstr ""

