msgid "Configure:"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:26
msgid "**NAME:** Descriptive name for the task"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:27
msgid "**CODE:** Unique code for API, CLI, and variable references"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:28
msgid "**ATTRIBUTES:** JSON payload to write (see formats below)"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:30
msgid "Click :guilabel:`SAVE CHANGES`"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:33
msgid "JSON Payload Formats"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:36
msgid "Static Key-Value Pairs"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:38
msgid "Write a fixed set of attributes:"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:40
#, python-brace-format
msgid ""
"{\n"
"  \"my_key1\": \"my_value1\",\n"
"  \"my_key2\": \"my_value2\",\n"
"  \"environment\": \"production\",\n"
"  \"version\": \"2.1.0\"\n"
"}"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:50
msgid "Dynamic Values from Prior Task Results"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:52
msgid ""
"Reference outputs from previous Tasks using ``<%= results.taskCode %>`` "
"syntax. The referenced Task must have its **RESULT TYPE** set to \"Single"
" Value\":"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:54
#, python-brace-format
msgid ""
"{\n"
"  \"database_host\": \"<%=results.discoverDb%>\",\n"
"  \"api_endpoint\": \"<%=results.resolveEndpoint%>\",\n"
"  \"deployment_id\": \"<%=results.createDeployment%>\"\n"
"}"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:62
msgid "Note"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:62
msgid ""
"``taskCode`` refers to the **CODE** field value of the Task whose output "
"you're referencing, not its name."
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:65
msgid "Dynamic JSON Map from Prior Task"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:67
msgid ""
"When a prior Task returns a full JSON object (RESULT TYPE set to "
"\"JSON\"), pass it through using ``encodeAsJSON()``:"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:69
#, python-brace-format
msgid ""
"{\n"
"  \"instances\": <%=results.taskCode?.encodeAsJSON()%>\n"
"}"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:75
msgid "Important"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:75
msgid ""
"The ``encodeAsJSON()`` method is required for proper JSON serialization. "
"Without it, the JSON map may not be stored correctly."
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:78
msgid "Mixed Static and Dynamic Values"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:80
msgid "Combine static values with dynamic references:"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:82
#, python-brace-format
msgid ""
"{\n"
"  \"app_name\": \"myapp\",\n"
"  \"build_number\": \"<%=results.getBuild%>\",\n"
"  \"deployed_by\": \"<%=instance.createdByUsername%>\",\n"
"  \"deploy_time\": \"<%=new Date().format('yyyy-MM-dd HH:mm:ss')%>\"\n"
"}"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:92
msgid "Instance Variables"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:94
msgid "|morpheus| instance variables can be referenced directly:"
msgstr ""

#: ../../provisioning/automation/write_attributes.rst:96
#, python-brace-format
msgid ""
"{\n"
"  \"instance_name\": \"<%=instance.name%>\",\n"
"  \"cloud_name\": \"<%=zone.name%>\",\n"
"  \"group_name\": \"<%=instance.group.name%>\",\n"
"  \"ip_address\": \"<%=container.externalIp%>\"\n"
"}"
msgstr ""

