#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:2
msgid "NSX Advanced Load Balancer"
msgstr "NSX Advanced Load Balancer"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:5
msgid "Add NSX Advanced Load Balancer"
msgstr "Adicionar NSX Advanced Load Balancer"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:7
msgid "To add an NSX Advanced Load Balancer Integration:"
msgstr "Para adicionar uma Integração NSX Advanced Load Balancer:"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:9
msgid "Navigate to :menuselection:`Infrastructure --> Load Balancers`"
msgstr "Navegue até :menuselection:`Infrastructure --> Load Balancers`"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:10
msgid "Select :guilabel:`+ ADD`"
msgstr "Selecione :guilabel:`+ ADD`"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:11
msgid ""
"Select **NSX Advanced Load Balancer** from the drop-down list. The NEW "
"LOAD BALANCER panel opens."
msgstr "Selecione **NSX Advanced Load Balancer** na lista dropdown. O painel NEW LOAD BALANCER é aberto."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:12
msgid "Configure the following:"
msgstr "Configure o seguinte:"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:14
msgid "GROUP"
msgstr "GROUP"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:15
msgid "From the drop-down list, select the group for the load balancer."
msgstr "Na lista dropdown, selecione o grupo para o balanceador de carga."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:16
msgid "CLOUD"
msgstr "CLOUD"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:17
msgid "From the drop-down list, select the cloud that hosts the load balancer."
msgstr "Na lista dropdown, selecione a nuvem que hospeda o balanceador de carga."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:18
msgid "NAME"
msgstr "NAME"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:19
msgid "Enter the load balancer name."
msgstr "Informe o nome do balanceador de carga."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:20
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:21
msgid "Identifying information displayed on the load balancer list page."
msgstr "Informações de identificação exibidas na página de lista do balanceador de carga."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:22
msgid "NSX ALB CONTROLLER"
msgstr "NSX ALB CONTROLLER"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:23
msgid "Enter the NSX Advanced Load Balancer Controller URL."
msgstr "Informe a URL do NSX Advanced Load Balancer Controller."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:24
msgid "USERNAME"
msgstr "USERNAME"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:25
msgid "Enter the controller username."
msgstr "Informe o nome de usuário do controlador."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:26
msgid "PASSWORD"
msgstr "PASSWORD"

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:27
msgid "Enter the controller password."
msgstr "Informe a senha do controlador."

#: ../../integration_guides/LoadBalancers/NSXAdvanced.rst:29
msgid "Click :guilabel:`SAVE CHANGES`."
msgstr "Clique em :guilabel:`SAVE CHANGES`."

