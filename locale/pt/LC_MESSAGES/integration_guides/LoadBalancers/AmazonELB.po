#: ../../integration_guides/LoadBalancers/AmazonELB.rst:2
msgid "Amazon ELB"
msgstr "Amazon ELB"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:5
msgid "Add Amazon ELB Load Balancer"
msgstr "Adicionar Balanceador de Carga Amazon ELB"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:7
msgid "To add an Amazon ELB (Elastic Load Balancer) Integration:"
msgstr "Para adicionar uma Integração Amazon ELB (Elastic Load Balancer):"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:9
msgid "Navigate to :menuselection:`Infrastructure --> Load Balancers`"
msgstr "Navegue até :menuselection:`Infrastructure --> Load Balancers`"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:10
msgid "Select :guilabel:`+ ADD`"
msgstr "Selecione :guilabel:`+ ADD`"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:11
msgid ""
"Select **Amazon ELB** from the drop-down list. The NEW LOAD BALANCER "
"panel opens."
msgstr "Selecione **Amazon ELB** na lista dropdown. O painel NEW LOAD BALANCER é aberto."

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:12
msgid "Configure the following:"
msgstr "Configure o seguinte:"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:14
msgid "GROUP"
msgstr "GROUP"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:15
msgid "From the drop-down list, select the group for the load balancer."
msgstr "Na lista dropdown, selecione o grupo para o balanceador de carga."

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:16
msgid "CLOUD"
msgstr "CLOUD"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:17
msgid ""
"From the drop-down list, select the Amazon cloud that hosts the load "
"balancer."
msgstr "Na lista dropdown, selecione a nuvem Amazon que hospeda o balanceador de carga."

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:18
msgid "NAME"
msgstr "NAME"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:19
msgid "Enter the load balancer name."
msgstr "Informe o nome do balanceador de carga."

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:20
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:21
msgid "Identifying information displayed on the load balancer list page."
msgstr "Informações de identificação exibidas na página de lista do balanceador de carga."

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:22
msgid "VISIBILITY"
msgstr "VISIBILITY"

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:23
msgid "Define Multi-Tenant permissions."
msgstr "Definir permissões Multi-Tenant."

#: ../../integration_guides/LoadBalancers/AmazonELB.rst:25
msgid "Click :guilabel:`SAVE CHANGES`."
msgstr "Clique em :guilabel:`SAVE CHANGES`."

