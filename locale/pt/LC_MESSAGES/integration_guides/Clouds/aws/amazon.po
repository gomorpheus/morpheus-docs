msgstr ""

#: ../../integration_guides/Clouds/aws/amazon.rst:366
msgid ""
"**COSTING KEY:** The AWS Key ID for an IAM user with sufficient access "
"who is associated with the standard commercial account"
msgstr ""

#: ../../integration_guides/Clouds/aws/amazon.rst:367
msgid ""
"**COSTING SECRET:** The AWS Secret Key for an IAM user with sufficient "
"access who is associated with the standard commercial account"
msgstr ""

#: ../../integration_guides/Clouds/aws/amazon.rst:368
