msgid "CLIENT ID"
msgstr "CLIENT ID"

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:23
#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:61
msgid "Typically ``cf``"
