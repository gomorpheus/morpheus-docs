msgstr "URL da API"

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:21
msgid "Cloud Foundry API Url"
msgstr "URL da API do Cloud Foundry"

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:22
