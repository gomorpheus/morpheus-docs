msgstr "ID do Nó Chef"

#: ../../integration_guides/Automation/chef.rst:66
msgid "Defaults to instance name, configurable."
msgstr "Padrão para o nome da instância, configurável."

#: ../../integration_guides/Automation/chef.rst:67
