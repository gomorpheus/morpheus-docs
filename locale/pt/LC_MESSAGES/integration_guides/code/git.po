msgstr "Username/Password"

#: ../../integration_guides/code/git.rst:107
msgid "Basic HTTPS authentication"
msgstr "Autenticação HTTPS básica"

#: ../../integration_guides/code/git.rst:109
msgid "Personal Access Token"
msgstr "Personal Access Token"

#: ../../integration_guides/code/git.rst:109
msgid "GitHub, GitLab, Bitbucket HTTPS access"
msgstr "Acesso HTTPS ao GitHub, GitLab, Bitbucket"

#: ../../integration_guides/code/git.rst:111
msgid "SSH Key Pair"
msgstr "SSH Key Pair"

#: ../../integration_guides/code/git.rst:111
msgid "SSH-based Git access"
msgstr "Acesso Git baseado em SSH"

#: ../../integration_guides/code/git.rst:113
msgid "Stored Credential"
msgstr "Stored Credential"

#: ../../integration_guides/code/git.rst:113
msgid "Reusable credential from Trust section"
msgstr "Credencial reutilizável da seção Trust"

#: ../../integration_guides/code/git.rst:117
msgid "Removing a Git Integration"
msgstr "Removendo uma Integração Git"

#: ../../integration_guides/code/git.rst:120
msgid "Click the trash icon on the integration row"
msgstr "Clique no ícone de lixeira na linha da integração"

#: ../../integration_guides/code/git.rst:121
msgid "Confirm deletion"
msgstr "Confirme a exclusão"

#: ../../integration_guides/code/git.rst:123
msgid "Warning"
msgstr "Aviso"

#: ../../integration_guides/code/git.rst:123
msgid ""
"Removing a Git integration will break any Tasks, Spec Templates, or "
"Blueprints that reference it. Update those resources to use a different "
"source before removal."
msgstr "Remover uma integração Git interromperá quaisquer Tasks, Spec Templates ou Blueprints que a referenciem. Atualize esses recursos para usar uma origem diferente antes da remoção."

