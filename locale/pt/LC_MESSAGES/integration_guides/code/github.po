#: ../../integration_guides/code/github.rst:154
msgid "Removing a GitHub Integration"
msgstr "Removendo uma Integração GitHub"

#: ../../integration_guides/code/github.rst:156
msgid "Navigate to |ProCodInt|"
msgstr "Navegue até |ProCodInt|"

#: ../../integration_guides/code/github.rst:157
