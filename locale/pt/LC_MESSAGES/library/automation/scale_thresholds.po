msgstr "Marque para definir auto-scaling pelo limite de utilização de disco especificado (%)"

#: ../../library/automation/scale_thresholds.rst:31
msgid "MIN DISK"
msgstr "MIN DISK"

#: ../../library/automation/scale_thresholds.rst:32
#, python-format
msgid "Enter MIN DISK % for triggering downscaling."
msgstr "Enter MIN DISK % for triggering downscaling."

