#: ../../library/automation/scale_thresholds.rst:2
msgid "Scale Thresholds"
msgstr "Limites de Escala"

#: ../../library/automation/scale_thresholds.rst:4
msgid ""
"Scale Thresholds are pre-configured settings for auto-scaling Instances. "
"When adding auto-scaling to an instance, existing Scale Thresholds can be"
" selected to determine auto-scaling rules."
msgstr "Scale Thresholds são configurações pré-configuradas para auto-scaling de Instâncias. Ao adicionar auto-scaling a uma instância, Scale Thresholds existentes podem ser selecionados para determinar as regras de auto-scaling."

#: ../../library/automation/scale_thresholds.rst:7
msgid "Creating Scale Thresholds"
msgstr "Criando Scale Thresholds"

#: ../../library/automation/scale_thresholds.rst:9
msgid "Navigate to |LibAutSca|"
msgstr "Navegue até |LibAutSca|"

#: ../../library/automation/scale_thresholds.rst:10
msgid "Select :guilabel:`+ ADD`"
msgstr "Selecione :guilabel:`+ ADD`"

#: ../../library/automation/scale_thresholds.rst:11
msgid "Populate the following:"
msgstr "Preencha o seguinte:"

#: ../../library/automation/scale_thresholds.rst:13
msgid "NAME"
msgstr "NOME"

#: ../../library/automation/scale_thresholds.rst:14
msgid "Name of the Scale Threshold"
msgstr "Nome do Scale Threshold"

#: ../../library/automation/scale_thresholds.rst:15
msgid "AUTO UPSCALE"
msgstr "AUTO UPSCALE"

#: ../../library/automation/scale_thresholds.rst:16
msgid "Enable to automatically upscale per Scale Threshold specifications"
msgstr "Habilite para fazer upscale automaticamente conforme as especificações do Scale Threshold"

#: ../../library/automation/scale_thresholds.rst:17
msgid "AUTO DOWNSCALE"
msgstr "AUTO DOWNSCALE"

#: ../../library/automation/scale_thresholds.rst:18
msgid "Enable to automatically downscale per Scale Threshold specifications"
msgstr "Habilite para fazer downscale automaticamente conforme as especificações do Scale Threshold"

#: ../../library/automation/scale_thresholds.rst:19
msgid "MIN COUNT"
msgstr "MIN COUNT"

#: ../../library/automation/scale_thresholds.rst:20
msgid ""
"Minimum node count for Instance. Auto-scaling will not downscale below "
"MIN COUNT, and will auto upscale if the MIN COUNT is not met)"
msgstr "Contagem mínima de nós para a Instância. O auto-scaling não fará downscale abaixo de MIN COUNT e fará upscale automaticamente se o MIN COUNT não for atendido)"

#: ../../library/automation/scale_thresholds.rst:21
msgid "MAX COUNT"
msgstr "MAX COUNT"

#: ../../library/automation/scale_thresholds.rst:22
msgid ""
"Maximum node count for Instance. Auto-scaling will not upscale past MAX "
"COUNT, and will auto downscale if MAX COUNT is exceeded."
msgstr "Contagem máxima de nós para a Instância. O auto-scaling não fará upscale além de MAX COUNT e fará downscale automaticamente se MAX COUNT for excedido."

#: ../../library/automation/scale_thresholds.rst:23
msgid "ENABLE MEMORY THRESHOLD"
msgstr "ENABLE MEMORY THRESHOLD"

#: ../../library/automation/scale_thresholds.rst:24
msgid "Check to set auto-scaling by specified memory utilization threshold (%)"
msgstr "Marque para definir auto-scaling pelo limite de utilização de memória especificado (%)"

#: ../../library/automation/scale_thresholds.rst:25
msgid "MIN MEMORY"
msgstr "MIN MEMORY"

#: ../../library/automation/scale_thresholds.rst:26
#, python-format
msgid "Enter MIN MEMORY % for triggering downscaling."
msgstr "Enter MIN MEMORY % for triggering downscaling."

#: ../../library/automation/scale_thresholds.rst:27
msgid "MAX MEMORY"
msgstr "MAX MEMORY"

#: ../../library/automation/scale_thresholds.rst:28
#, python-format
msgid "Enter MAX MEMORY % for triggering upscaling."
msgstr "Enter MAX MEMORY % for triggering upscaling."

#: ../../library/automation/scale_thresholds.rst:29
msgid "ENABLE DISK THRESHOLD"
msgstr "ENABLE DISK THRESHOLD"

#: ../../library/automation/scale_thresholds.rst:30
