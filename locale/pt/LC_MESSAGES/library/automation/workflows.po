msgstr "As Tarefas são executadas imediatamente antes que o destino seja desligado"

#: ../../library/automation/workflows.rst:74
#: ../../library/automation/workflows.rst:78
msgid "Send an update on Instance power state to a CMDB"
msgstr "Enviar uma atualização sobre o estado de energia da Instância para um CMDB"

#: ../../library/automation/workflows.rst:76
msgid "Startup"
msgstr "Startup"

#: ../../library/automation/workflows.rst:77
msgid "Tasks are run immediately before the target is started"
msgstr "As Tarefas são executadas imediatamente antes que o destino seja iniciado"

