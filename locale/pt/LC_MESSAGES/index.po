#: ../../release_notes/current.rst
msgid "BMaaS / Bare Metal"
msgstr "BMaaS / Bare Metal"

#: ../../release_notes/current.rst:51
msgid ""
"PXE/Network Boot support: boot Bare Metal hosts via customer PXE "
