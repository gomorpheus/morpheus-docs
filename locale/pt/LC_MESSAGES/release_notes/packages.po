#: ../../release_notes/packages.rst:5
msgid "|morphver| Release Packages"
msgstr "Pacotes de Release |morphver|"

#: ../../release_notes/packages.rst:8
msgid "|morpheus| Appliance Packages"
msgstr "Pacotes do Appliance |morpheus|"

#: ../../release_notes/packages.rst:10
msgid ""
"The |morpheus| Appliance Package is the main install package used to "
"install and upgrade |morpheus| Appliances."
msgstr "O Pacote do Appliance |morpheus| é o pacote principal de instalação usado para instalar e atualizar Appliances |morpheus|."

#: ../../release_notes/packages.rst:13
msgid "|morpheus| Repository Packages"
msgstr "Pacotes do Repositório |morpheus|"

#: ../../release_notes/packages.rst:15
msgid ""
"The |morpheus| Repository Packages contain the Node and VM Node Packages "
"required to install and upgrade the |morpheus| agent and provision Docker"
" Hosts."
msgstr "Os Pacotes do Repositório |morpheus| contêm os Pacotes Node e VM Node necessários para instalar e atualizar o agente |morpheus| e provisionar Docker Hosts."

#: ../../release_notes/packages.rst:18
msgid "|morpheus| Supplemental Appliance Packages"
msgstr "Pacotes Suplementares do Appliance |morpheus|"

#: ../../release_notes/packages.rst:20
msgid ""
"The |morpheus| Supplemental Appliance Packages contain all of the "
"|morpheus| Repository Packages as well as additional packages required to"
" install |morpheus| Appliance Packages in environments that cannot access"
" |repo_host_url|"
msgstr "Os Pacotes Suplementares do Appliance |morpheus| contêm todos os Pacotes do Repositório |morpheus|, bem como pacotes adicionais necessários para instalar Pacotes do Appliance |morpheus| em ambientes que não podem acessar |repo_host_url|"

