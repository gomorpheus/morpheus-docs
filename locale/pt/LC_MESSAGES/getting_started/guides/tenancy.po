msgstr "Defina um NAME para o Grupo e clique em :guilabel:`SAVE CHANGES`"

#: ../../getting_started/guides/tenancy.rst:130
msgid "We'll now add the shared Cloud to the Group:"
msgstr "Agora adicionaremos a Nuvem compartilhada ao Grupo:"

#: ../../getting_started/guides/tenancy.rst:132
msgid "Click on the name of the Group to access the Group detail page"
msgstr "Clique no nome do Grupo para acessar a página de detalhes do Grupo"

#: ../../getting_started/guides/tenancy.rst:133
msgid "Click on the Clouds tab"
msgstr "Clique na guia Clouds"

#: ../../getting_started/guides/tenancy.rst:134
#: ../../getting_started/guides/tenancy.rst:149
msgid "Click :guilabel:`+ ADD`"
msgstr "Clique em :guilabel:`+ ADD`"

#: ../../getting_started/guides/tenancy.rst:135
msgid "Use the typeahead field to select the shared Cloud"
msgstr "Use o campo typeahead para selecionar a Nuvem compartilhada"

