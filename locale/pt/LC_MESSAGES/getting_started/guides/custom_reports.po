"            <span class=\"big-stat\">{{ header.0.dataMap.tfvars_items "
"}}</span>\n"
"            <div class=\"stat-label\">TF Vars</div>\n"
"         </div>\n"
"         <div class=\"stats-container\">\n"
"            <span class=\"big-stat\">{{ header.0.dataMap.secret_items "
"}}</span>\n"
"            <div class=\"stat-label\">Secret</div>\n"
