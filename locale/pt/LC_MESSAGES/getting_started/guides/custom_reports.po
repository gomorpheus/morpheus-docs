msgstr "Crie seu novo plugin."

#: ../../getting_started/guides/custom_reports.rst:416
msgid "gradle shadowJar"
msgstr ""

#: ../../getting_started/guides/custom_reports.rst:420
msgid ""
"Once the build process has completed, locate the JAR in the "
"``build/libs`` directory"
