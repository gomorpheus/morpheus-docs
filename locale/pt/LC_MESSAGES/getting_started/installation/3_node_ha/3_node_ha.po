#: ../../getting_started/installation/3_node_ha/3_node_ha.rst:2
msgid "3 Node HA Install Example"
msgstr "Exemplo de Instalação HA de 3 Nós"

#: ../../getting_started/installation/3_node_ha/3_node_ha.rst:4
msgid "Distributed App Nodes with Externalized MySQL Database"
msgstr "Nós de App Distribuídos com Banco de Dados MySQL Externalizado"

#: ../../getting_started/installation/3_node_ha/3_node_ha.rst:6
msgid ""
"A common and recommended HA Morpheus deployment consists of three app "
"nodes using embedded services and an external MySQL DB cluster (minimum "
"of 3 nodes)."
msgstr "Uma implementação HA recomendada e comum do Morpheus consiste em três nós de app usando serviços embutidos e um cluster de DB MySQL externo (mínimo de 3 nós)."

#: ../../getting_started/installation/3_node_ha/3_node_ha.rst:8
#: ../../getting_started/installation/3_node_ha/3_node_ha_morpheus_rb.rst:98
