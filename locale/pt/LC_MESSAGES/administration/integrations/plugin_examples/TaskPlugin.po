#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:16
msgid "Options"
msgstr ""

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:18
msgid ""
"``OptionType`` is an easy way to create configuration for your new Task. "
"Simply provide a list of ``com.morpheusdata.model.OptionType`` to the "
"``TaskProvider.getOptionTypes`` method."
msgstr ""

#: ../../administration/integrations/plugin_examples/TaskPlugin.rst:20
#, python-brace-format
msgid ""
"@Override\n"
"List<OptionType> getOptionTypes() {\n"
"        OptionType optionType = new OptionType(\n"
"                        name: 'myTask',\n"
"                        code: 'myTaskText',\n"
"                        fieldName: 'myTask',\n"
"                        optionSource: true,\n"
"                        displayOrder: 0,\n"
"                        fieldLabel: 'Text to Reverse',\n"
"                        required: true,\n"
"                        inputType: OptionType.InputType.TEXT\n"
"        )\n"
"        return [optionType]\n"
"}"
msgstr ""

