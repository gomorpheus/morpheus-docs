msgid "``rejected``"
msgstr ""

#: ../../administration/integrations/plugin_examples/ApprovalsPlugin.rst:53
msgid "``cancelled``"
msgstr ""

#: ../../administration/integrations/plugin_examples/ApprovalsPlugin.rst:56
msgid "Integration Logo"
msgstr "Logo da Integração"

#: ../../administration/integrations/plugin_examples/ApprovalsPlugin.rst:58
#, python-brace-format
msgid ""
"A custom logo can be used in the Morpheus UI by placing an image at "
"``src/assets/images/{plugin-code}.png``. Recommended file size is 180 x "
"60 px."
msgstr "Um logo personalizado pode ser usado na interface do Morpheus colocando uma imagem em ``src/assets/images/{plugin-code}.png``. O tamanho recomendado do arquivo é 180 x 60 px."

