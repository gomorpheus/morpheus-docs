#: ../../infrastructure/vdi/gateways.rst:146
msgid "API Reference"
msgstr "Referência da API"

#: ../../infrastructure/vdi/gateways.rst:148
msgid "VDI Gateways are manageable via the |morpheus| API:"
msgstr "VDI Gateways são gerenciáveis via a API |morpheus|:"

#: ../../infrastructure/vdi/gateways.rst:150
msgid "``GET /api/vdi-gateways`` — List all VDI Gateways"
msgstr "``GET /api/vdi-gateways`` — Listar todos os VDI Gateways"

#: ../../infrastructure/vdi/gateways.rst:151
msgid "``GET /api/vdi-gateways/:id`` — Get a specific gateway"
msgstr "``GET /api/vdi-gateways/:id`` — Obter um gateway específico"

#: ../../infrastructure/vdi/gateways.rst:152
