msgid "``/opt/morpheus-node/.quorum-nodes``"
msgstr "``/opt/morpheus-node/.quorum-nodes``"

#: ../../infrastructure/clusters/hvm/architecture.rst:147
msgid "Cluster member list"
msgstr "Lista de membros do Cluster"

#: ../../infrastructure/clusters/hvm/architecture.rst:148
msgid "``/opt/morpheus-node/.hb``"
msgstr "``/opt/morpheus-node/.hb``"

#: ../../infrastructure/clusters/hvm/architecture.rst:149
msgid "Heartbeat job configuration"
msgstr "Configuração do job de heartbeat"

#: ../../infrastructure/clusters/hvm/architecture.rst:150
msgid "``/opt/morpheus-node/.mounts``"
