msgstr "Tempo antes de um Host ser considerado offline"

#: ../../infrastructure/clusters/hvm/architecture.rst:125
msgid "APD threshold"
msgstr "Limite de APD"

#: ../../infrastructure/clusters/hvm/architecture.rst:126
msgid "~2 minutes (6 failed cycles)"
msgstr "~2 minutos (6 ciclos com falha)"

#: ../../infrastructure/clusters/hvm/architecture.rst:127
msgid "Time before VMs shut down on storage loss"
msgstr "Tempo antes das VMs serem desligadas por perda de Armazenamento"

#: ../../infrastructure/clusters/hvm/architecture.rst:128
msgid "Fence_ack cooldown"
msgstr "Cooldown de fence_ack"

#: ../../infrastructure/clusters/hvm/architecture.rst:130
msgid "Cooldown period after a fence acknowledgement"
msgstr "Período de cooldown após confirmação de fence"

#: ../../infrastructure/clusters/hvm/architecture.rst:131
msgid "DLM fence_wait delay"
msgstr "Atraso de fence_wait do DLM"

#: ../../infrastructure/clusters/hvm/architecture.rst:132
msgid "Up to 30s"
msgstr "Até 30s"

#: ../../infrastructure/clusters/hvm/architecture.rst:133
msgid "Maximum DLM delay waiting for fence resolution"
msgstr "Atraso máximo do DLM aguardando resolução de fence"

