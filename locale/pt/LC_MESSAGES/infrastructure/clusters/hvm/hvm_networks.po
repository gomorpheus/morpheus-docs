msgid "General Requirements"
msgstr "Requisitos Gerais"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:39
msgid "The |morpheus| appliance must run version 9.0.0 or later"
msgstr "O appliance |morpheus| deve executar a versão 9.0.0 ou posterior"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:40
msgid "A pre-existing Legacy or layout 1.3 HVM cluster must be available"
msgstr "Um cluster HVM Legacy ou layout 1.3 pré-existente deve estar disponível"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:41
msgid "All cluster hosts must be reachable from the |morpheus| appliance"
msgstr "Todos os hosts do cluster devem ser acessíveis a partir do appliance |morpheus|"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:42
msgid "Open vSwitch (OVS) must be installed and running on each host"
msgstr "O Open vSwitch (OVS) deve estar instalado e em execução em cada host"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:43
msgid "Deploy the plugin only on an HVM KVM-based cluster"
msgstr "Implante o plugin somente em um cluster HVM baseado em KVM"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:46
msgid "Standard Network Requirements"
msgstr "Requisitos de Rede Standard"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:48
msgid "An OVS Bridge Domain virtual switch must exist in the cluster"
msgstr "Um virtual switch OVS Bridge Domain deve existir no cluster"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:49
