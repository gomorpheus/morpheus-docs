#: ../../infrastructure/clusters/hvm/hvm_networks.rst:52
msgid "Aruba CX Integration Requirements"
msgstr "Requisitos de Integração Aruba CX"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:54
msgid "Aruba CX switches must be configured and reachable"
msgstr "Os switches Aruba CX devem estar configurados e acessíveis"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:55
msgid ""
"The Aruba CX Network Plugin (Generic Integration) must be installed and "
"configured in |morpheus|"
msgstr ""
"O Aruba CX Network Plugin (Generic Integration) deve estar instalado e "
"configurado no |morpheus|"

#: ../../infrastructure/clusters/hvm/hvm_networks.rst:58
msgid "Verifying the Plugin"
msgstr "Verificando o Plugin"

