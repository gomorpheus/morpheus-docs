#: ../../infrastructure/clusters/kubernetes/external.rst:36
msgid "Configured via layout (OpenEBS, Rook)"
msgstr "Configurado via layout (OpenEBS, Rook)"

#: ../../infrastructure/clusters/kubernetes/external.rst:37
msgid "Uses existing storage provisioners"
msgstr "Usa provisioners de armazenamento existentes"

#: ../../infrastructure/clusters/kubernetes/external.rst:38
msgid "Network runtime"
msgstr "Runtime de rede"

#: ../../infrastructure/clusters/kubernetes/external.rst:39
msgid "Configured via layout (Calico, Weave)"
msgstr "Configurado via layout (Calico, Weave)"

#: ../../infrastructure/clusters/kubernetes/external.rst:40
msgid "Uses existing CNI"
msgstr "Usa CNI existente"

#: ../../infrastructure/clusters/kubernetes/external.rst:41
msgid "Kubernetes version"
msgstr "Versão do Kubernetes"

#: ../../infrastructure/clusters/kubernetes/external.rst:42
msgid "Controlled by layout version"
msgstr "Controlada pela versão do layout"

#: ../../infrastructure/clusters/kubernetes/external.rst:43
msgid "Determined by external cluster"
msgstr "Determinada pelo cluster externo"

#: ../../infrastructure/clusters/kubernetes/external.rst:44
msgid "Workload deployment"
msgstr "Implantação de cargas de trabalho"

#: ../../infrastructure/clusters/kubernetes/external.rst:45
#: ../../infrastructure/clusters/kubernetes/external.rst:46
msgid "Full support"
msgstr "Suporte completo"

#: ../../infrastructure/clusters/kubernetes/external.rst:47
msgid "Monitoring"
msgstr "Monitoramento"

