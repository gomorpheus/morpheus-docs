#: ../../infrastructure/clusters/kubernetes/external.rst:32
msgid "Agent installation"
msgstr "Instalação do agente"

#: ../../infrastructure/clusters/kubernetes/external.rst:33
msgid "Automatic on all nodes"
msgstr "Automática em todos os nós"

#: ../../infrastructure/clusters/kubernetes/external.rst:34
