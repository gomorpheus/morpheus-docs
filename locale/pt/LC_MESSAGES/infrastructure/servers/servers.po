msgstr "**Name** — Nome ou identificador do dispositivo"

#: ../../infrastructure/servers/server_devices.rst:23
msgid "**Type** — Device type (GPU, PCIe, USB, etc.)"
msgstr "**Type** — Tipo do dispositivo (GPU, PCIe, USB, etc.)"

#: ../../infrastructure/servers/server_devices.rst:24
msgid "**Status** — Connection status (attached/detached)"
msgstr "**Status** — Status da conexão (attached/detached)"

#: ../../infrastructure/servers/server_devices.rst:27
msgid "Attaching a Device"
msgstr "Anexando um Dispositivo"

#: ../../infrastructure/servers/server_devices.rst:31
msgid "Select **Attach Device**"
msgstr "Selecione **Attach Device**"

#: ../../infrastructure/servers/server_devices.rst:32
msgid "In the device dialog, configure:"
msgstr "Na caixa de diálogo do dispositivo, configure:"

#: ../../infrastructure/servers/server_devices.rst:34
msgid "DEVICE"
msgstr "DEVICE"

#: ../../infrastructure/servers/server_devices.rst:35
