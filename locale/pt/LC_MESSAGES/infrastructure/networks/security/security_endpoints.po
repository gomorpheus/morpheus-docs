msgid "Endpoint Type"
msgstr "Tipo de Endpoint"

#: ../../infrastructure/networks/security/security_endpoints.rst:42
msgid "Description"
msgstr "Descrição"

#: ../../infrastructure/networks/security/security_endpoints.rst:43
msgid "IP Address"
msgstr "Endereço IP"

#: ../../infrastructure/networks/security/security_endpoints.rst:44
