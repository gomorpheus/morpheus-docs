#: ../../infrastructure/certificates/nsxt_certificates.rst:4
msgid "NSX-T Certificate Management"
msgstr ""

#: ../../infrastructure/certificates/nsxt_certificates.rst:7
msgid "Overview"
msgstr ""

#: ../../infrastructure/certificates/nsxt_certificates.rst:9
msgid ""
"|morpheus| provides integrated certificate management for VMware NSX-T "
"environments. NSX-T requires certificates for securing communications "
"between its management plane, control plane, and transport nodes. "
"|morpheus| can manage the lifecycle of these certificates, including "
"uploading certificates to NSX-T managers and associating them with NSX-T "
"services."
msgstr ""

#: ../../infrastructure/certificates/nsxt_certificates.rst:11
msgid ""
"This feature is available when an NSX-T integration has been configured "
"in |morpheus|."
msgstr ""

#: ../../infrastructure/certificates/nsxt_certificates.rst:14
msgid "Prerequisites"
msgstr ""

#: ../../infrastructure/certificates/nsxt_certificates.rst:16
msgid ""
"An active NSX-T integration configured in |morpheus| (Infrastructure > "
"Network > Integrations)"
msgstr ""

#: ../../infrastructure/certificates/nsxt_certificates.rst:17
msgid "NSX-T Manager version 2.5 or higher"
msgstr ""

#: ../../infrastructure/certificates/nsxt_certificates.rst:18
msgid "Appropriate NSX-T API permissions for certificate management"
msgstr ""

