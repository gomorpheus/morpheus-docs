#: ../../infrastructure/networks/dns/builtin_resolver.rst:186
msgid "**Zone Transfers:** Authenticate AXFR/IXFR requests between DNS servers"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:187
msgid "**Dynamic Updates:** Verify the identity of clients sending DNS updates"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:188
