#: ../../infrastructure/networks/dns/builtin_resolver.rst:153
msgid "Provisioning Integration"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:155
msgid ""
"The built-in DNS resolver integrates with the |morpheus| provisioning "
"workflow:"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:157
msgid ""
"**Automatic A Record Creation:** When an Instance is provisioned with an "
"IP assignment, an A record is created in the associated domain"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:158
msgid ""
"**PTR Record Creation:** If a reverse zone exists for the IP range, a PTR"
" record is automatically created"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:159
msgid ""
"**Record Cleanup:** DNS records are automatically removed when Instances "
"are terminated"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:160
msgid ""
"**Naming Policy Integration:** DNS records follow configured naming "
"policies for consistent naming"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:162
msgid "To enable automatic DNS for provisioning:"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:164
msgid ""
"Associate a domain with the built-in resolver in Infrastructure > Network"
" > Domains"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:165
msgid ""
"On the Cloud or Network configuration, select the domain for DNS "
"assignment"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:166
msgid ""
"Configure naming policies as needed (Administration > Provisioning > "
"Settings)"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:169
msgid "SOA Record Management"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:171
msgid "The SOA record for each zone is automatically managed:"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:173
msgid ""
"**Serial Number:** Auto-incremented on each zone change (YYYYMMDDNN "
"format)"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:174
msgid "**Refresh Interval:** How often secondary servers check for updates"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:175
msgid ""
"**Retry Interval:** How long secondary servers wait before retrying after"
" a failed refresh"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:176
msgid ""
"**Expire Time:** How long secondary servers serve data without a "
"successful refresh"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:177
msgid "**Minimum TTL:** Default TTL for negative caching (NXDOMAIN responses)"
msgstr ""

#: ../../infrastructure/networks/dns/builtin_resolver.rst:179
msgid "SOA parameters can be edited on the domain detail page."
msgstr ""

