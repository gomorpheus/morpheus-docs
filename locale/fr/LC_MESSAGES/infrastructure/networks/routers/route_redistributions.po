msgid "Advertise OSPF-learned routes to external BGP peers"
msgstr "Annoncer les routes apprises via OSPF aux pairs BGP externes"

#: ../../infrastructure/networks/routers/route_redistributions.rst:72
msgid "Static to OSPF"
msgstr "Static to OSPF"

#: ../../infrastructure/networks/routers/route_redistributions.rst:73
msgid "Include static routes in OSPF link-state advertisements"
