#: ../../infrastructure/networks/routers/bgp_neighbors.rst:102
msgid "Required Role Permissions"
msgstr "Permissions de rôle requises"

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:104
msgid ""
"Access to BGP neighbor management requires the ``Infrastructure: Network "
"Routers`` permission (``infrastructure-routers``) with ``read``, "
"``full``, or ``group`` access."
msgstr "L'accès à la gestion des voisins BGP nécessite la permission ``Infrastructure: Network Routers`` (``infrastructure-routers``) avec un accès ``read``, ``full`` ou ``group``."

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:107
msgid "API"
msgstr "API"

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:109
msgid ""
"BGP neighbors are managed through the |morpheus| API at the following "
"endpoints:"
msgstr "Les voisins BGP sont gérés via l'API |morpheus| aux points de terminaison suivants :"

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:111
msgid "``GET /api/networks/routers/:routerId/bgp-neighbors`` — List BGP neighbors"
msgstr "``GET /api/networks/routers/:routerId/bgp-neighbors`` — Liste des voisins BGP"

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:112
msgid ""
"``GET /api/networks/routers/:routerId/bgp-neighbors/:id`` — Get a "
"specific BGP neighbor"
msgstr "``GET /api/networks/routers/:routerId/bgp-neighbors/:id`` — Obtenir un voisin BGP spécifique"

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:113
msgid ""
"``POST /api/networks/routers/:routerId/bgp-neighbors`` — Create a BGP "
"neighbor"
msgstr "``POST /api/networks/routers/:routerId/bgp-neighbors`` — Créer un voisin BGP"

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:114
msgid ""
"``PUT /api/networks/routers/:routerId/bgp-neighbors/:id`` — Update a BGP "
"neighbor"
msgstr "``PUT /api/networks/routers/:routerId/bgp-neighbors/:id`` — Mettre à jour un voisin BGP"

#: ../../infrastructure/networks/routers/bgp_neighbors.rst:115
msgid ""
"``DELETE /api/networks/routers/:routerId/bgp-neighbors/:id`` — Delete a "
"BGP neighbor"
msgstr "``DELETE /api/networks/routers/:routerId/bgp-neighbors/:id`` — Supprimer un voisin BGP"

