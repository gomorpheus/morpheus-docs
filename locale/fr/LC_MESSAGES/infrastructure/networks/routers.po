msgstr "NSX Cloud Tier0 Gateway"

#: ../../infrastructure/networks/routers.rst:15
msgid "NSX Cloud Tier1 Gateway"
msgstr "NSX Cloud Tier1 Gateway"

#: ../../infrastructure/networks/routers.rst:16
msgid "NSX Tier0 Gateway"
msgstr "NSX Tier0 Gateway"

#: ../../infrastructure/networks/routers.rst:17
msgid "NSX Tier1 Gateway"
