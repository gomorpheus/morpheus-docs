msgstr "Accédez à ``Infrastructure > Clusters``"

#: ../../infrastructure/clusters/docker.rst:14
msgid "Select :guilabel:`+ ADD CLUSTER`"
msgstr "Sélectionnez :guilabel:`+ ADD CLUSTER`"

#: ../../infrastructure/clusters/docker.rst:15
msgid "Select ``Docker Cluster``"
msgstr "Sélectionnez ``Docker Cluster``"

#: ../../infrastructure/clusters/docker.rst:16
