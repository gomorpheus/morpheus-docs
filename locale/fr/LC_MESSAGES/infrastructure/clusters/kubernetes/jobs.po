#: ../../infrastructure/clusters/kubernetes/jobs.rst:104
msgid "Navigate to the cluster Workloads tab > Jobs subtab"
msgstr "Accédez à l'onglet Workloads du cluster > sous-onglet Jobs"

#: ../../infrastructure/clusters/kubernetes/jobs.rst:105
msgid "Select the Job to delete"
msgstr "Sélectionnez la tâche à supprimer"

#: ../../infrastructure/clusters/kubernetes/jobs.rst:106
msgid "Click :guilabel:`DELETE`"
msgstr "Cliquez sur :guilabel:`DELETE`"

#: ../../infrastructure/clusters/kubernetes/jobs.rst:107
