#: ../../infrastructure/clusters/kubernetes/storage.rst:46
msgid "**RECLAIM POLICY** — ``Retain``, ``Delete``, or ``Recycle``"
msgstr "**RECLAIM POLICY** — ``Retain``, ``Delete`` ou ``Recycle``"

#: ../../infrastructure/clusters/kubernetes/storage.rst:47
msgid "**STATUS** — ``Available``, ``Bound``, ``Released``, or ``Failed``"
msgstr "**STATUS** — ``Available``, ``Bound``, ``Released`` ou ``Failed``"

#: ../../infrastructure/clusters/kubernetes/storage.rst:48
msgid "**CLAIM** — The PVC bound to this volume (if any)"
msgstr "**CLAIM** — Le PVC lié à ce volume (le cas échéant)"

#: ../../infrastructure/clusters/kubernetes/storage.rst:49
msgid "**STORAGE CLASS** — Associated StorageClass"
msgstr "**STORAGE CLASS** — StorageClass associée"

#: ../../infrastructure/clusters/kubernetes/storage.rst:50
msgid "**NAMESPACE** — Namespace (if applicable)"
msgstr "**NAMESPACE** — Espace de noms (le cas échéant)"

