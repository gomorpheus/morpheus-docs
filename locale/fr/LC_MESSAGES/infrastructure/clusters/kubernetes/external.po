#: ../../infrastructure/clusters/kubernetes/external.rst:4
msgid "External Kubernetes Clusters"
msgstr "Clusters Kubernetes externes"

#: ../../infrastructure/clusters/kubernetes/external.rst:7
msgid "Overview"
msgstr "Vue d'ensemble"

#: ../../infrastructure/clusters/kubernetes/external.rst:9
msgid "|morpheus| supports two primary modes of Kubernetes cluster management:"
msgstr "|morpheus| prend en charge deux modes principaux de gestion des clusters Kubernetes :"

#: ../../infrastructure/clusters/kubernetes/external.rst:11
msgid ""
"**Provisioned Clusters** — Kubernetes clusters provisioned directly by "
"|morpheus| using MKS (Morpheus Kubernetes Service) layouts"
msgstr "**Clusters provisionnés** — Clusters Kubernetes provisionnés directement par |morpheus| à l'aide des dispositions MKS (Morpheus Kubernetes Service)"

#: ../../infrastructure/clusters/kubernetes/external.rst:12
msgid ""
"**External Clusters** — Pre-existing Kubernetes clusters provisioned "
"outside of |morpheus| and imported for management"
msgstr "**Clusters externes** — Clusters Kubernetes préexistants provisionnés en dehors de |morpheus| et importés pour gestion"

#: ../../infrastructure/clusters/kubernetes/external.rst:14
msgid ""
"This guide covers the differences between these approaches, the import "
"process for external clusters, and the feature parity between the two."
msgstr "Ce guide couvre les différences entre ces approches, le processus d'importation des clusters externes et la parité des fonctionnalités entre les deux."

#: ../../infrastructure/clusters/kubernetes/external.rst:17
msgid "Provisioned vs External Clusters"
msgstr "Clusters provisionnés vs clusters externes"

#: ../../infrastructure/clusters/kubernetes/external.rst:23
msgid "Feature"
msgstr "Fonctionnalité"

#: ../../infrastructure/clusters/kubernetes/external.rst:24
msgid "Provisioned (MKS)"
msgstr "Provisionné (MKS)"

#: ../../infrastructure/clusters/kubernetes/external.rst:25
msgid "External"
msgstr "Externe"

#: ../../infrastructure/clusters/kubernetes/external.rst:26
msgid "Cluster lifecycle"
msgstr "Cycle de vie du cluster"

#: ../../infrastructure/clusters/kubernetes/external.rst:27
msgid "Full (create, scale, upgrade, destroy)"
msgstr "Complet (créer, mettre à l'échelle, mettre à niveau, détruire)"

#: ../../infrastructure/clusters/kubernetes/external.rst:28
msgid "Monitor and consume only"
msgstr "Surveillance et consommation uniquement"

#: ../../infrastructure/clusters/kubernetes/external.rst:29
msgid "Node management"
msgstr "Gestion des nœuds"

#: ../../infrastructure/clusters/kubernetes/external.rst:30
msgid "Add/remove workers, resize"
msgstr "Ajouter/supprimer des workers, redimensionner"

#: ../../infrastructure/clusters/kubernetes/external.rst:31
msgid "View only"
msgstr "Affichage uniquement"

#: ../../infrastructure/clusters/kubernetes/external.rst:32
msgid "Agent installation"
msgstr "Installation de l'agent"

#: ../../infrastructure/clusters/kubernetes/external.rst:33
msgid "Automatic on all nodes"
msgstr "Automatique sur tous les nœuds"

#: ../../infrastructure/clusters/kubernetes/external.rst:34
msgid "Not required"
msgstr "Non requis"

#: ../../infrastructure/clusters/kubernetes/external.rst:35
msgid "Storage runtime"
msgstr "Runtime de stockage"

#: ../../infrastructure/clusters/kubernetes/external.rst:36
msgid "Configured via layout (OpenEBS, Rook)"
msgstr "Configuré via la disposition (OpenEBS, Rook)"

#: ../../infrastructure/clusters/kubernetes/external.rst:37
msgid "Uses existing storage provisioners"
msgstr "Utilise les provisionneurs de stockage existants"

#: ../../infrastructure/clusters/kubernetes/external.rst:38
msgid "Network runtime"
msgstr "Runtime réseau"

#: ../../infrastructure/clusters/kubernetes/external.rst:39
msgid "Configured via layout (Calico, Weave)"
msgstr "Configuré via la disposition (Calico, Weave)"

#: ../../infrastructure/clusters/kubernetes/external.rst:40
msgid "Uses existing CNI"
msgstr "Utilise le CNI existant"

#: ../../infrastructure/clusters/kubernetes/external.rst:41
msgid "Kubernetes version"
msgstr "Version Kubernetes"

#: ../../infrastructure/clusters/kubernetes/external.rst:42
msgid "Controlled by layout version"
msgstr "Contrôlée par la version de la disposition"

#: ../../infrastructure/clusters/kubernetes/external.rst:43
msgid "Determined by external cluster"
msgstr "Déterminée par le cluster externe"

#: ../../infrastructure/clusters/kubernetes/external.rst:44
msgid "Workload deployment"
msgstr "Déploiement des charges de travail"

#: ../../infrastructure/clusters/kubernetes/external.rst:45
#: ../../infrastructure/clusters/kubernetes/external.rst:46
msgid "Full support"
msgstr "Prise en charge complète"

#: ../../infrastructure/clusters/kubernetes/external.rst:47
msgid "Monitoring"
msgstr "Surveillance"

#: ../../infrastructure/clusters/kubernetes/external.rst:48
msgid "Full (nodes + workloads)"
msgstr "Complète (nœuds + charges de travail)"

#: ../../infrastructure/clusters/kubernetes/external.rst:49
msgid "Workloads + API-level metrics"
msgstr "Charges de travail + métriques au niveau API"

#: ../../infrastructure/clusters/kubernetes/external.rst:50
msgid "kubectl access"
msgstr "Accès kubectl"

#: ../../infrastructure/clusters/kubernetes/external.rst:51
#: ../../infrastructure/clusters/kubernetes/external.rst:52
msgid "Yes (Control tab)"
msgstr "Oui (onglet Control)"

#: ../../infrastructure/clusters/kubernetes/external.rst:53
msgid "Namespace management"
msgstr "Gestion des espaces de noms"

#: ../../infrastructure/clusters/kubernetes/external.rst:54
#: ../../infrastructure/clusters/kubernetes/external.rst:55
msgid "Full CRUD"
msgstr "CRUD complet"

#: ../../infrastructure/clusters/kubernetes/external.rst:56
msgid "Helm/Spec deployment"
msgstr "Déploiement Helm/Spec"

#: ../../infrastructure/clusters/kubernetes/external.rst:57
#: ../../infrastructure/clusters/kubernetes/external.rst:58
#: ../../infrastructure/clusters/kubernetes/external.rst:60
msgid "Yes"
msgstr "Oui"

#: ../../infrastructure/clusters/kubernetes/external.rst:59
msgid "RBAC management"
msgstr "Gestion RBAC"

#: ../../infrastructure/clusters/kubernetes/external.rst:61
msgid "Yes (requires sufficient permissions)"
msgstr "Oui (nécessite des autorisations suffisantes)"

#: ../../infrastructure/clusters/kubernetes/external.rst:62
msgid "Upgrade cluster"
msgstr "Mise à niveau du cluster"

#: ../../infrastructure/clusters/kubernetes/external.rst:63
msgid "Yes (via ACTIONS menu)"
msgstr "Oui (via le menu ACTIONS)"

#: ../../infrastructure/clusters/kubernetes/external.rst:64
msgid "No (managed externally)"
msgstr "Non (géré en externe)"

#: ../../infrastructure/clusters/kubernetes/external.rst:67
msgid "Importing an External Cluster"
msgstr "Importation d'un cluster externe"

#: ../../infrastructure/clusters/kubernetes/external.rst:70
msgid "Prerequisites"
msgstr "Prérequis"

#: ../../infrastructure/clusters/kubernetes/external.rst:72
msgid "Before importing an external cluster, prepare the following:"
msgstr "Avant d'importer un cluster externe, préparez les éléments suivants :"

#: ../../infrastructure/clusters/kubernetes/external.rst:74
msgid ""
"**Service Account** — Create a service account with cluster-admin "
"privileges:"
msgstr "**Compte de service** — Créez un compte de service avec les privilèges cluster-admin :"

#: ../../infrastructure/clusters/kubernetes/external.rst:76
msgid "kubectl create serviceaccount morpheus"
msgstr ""

#: ../../infrastructure/clusters/kubernetes/external.rst:80
msgid "**Cluster Role Binding** — Bind the service account to cluster-admin:"
msgstr "**Liaison de rôle de cluster** — Liez le compte de service à cluster-admin :"

#: ../../infrastructure/clusters/kubernetes/external.rst:82
msgid ""
"kubectl create clusterrolebinding morpheus-admin \\\n"
"  --clusterrole=cluster-admin \\\n"
"  --serviceaccount=default:morpheus \\\n"
"  --namespace=default"
msgstr ""

#: ../../infrastructure/clusters/kubernetes/external.rst:89
msgid "**API URL** — Retrieve the cluster API server URL:"
msgstr "**URL API** — Récupérez l'URL du serveur API du cluster :"

#: ../../infrastructure/clusters/kubernetes/external.rst:91
msgid ""
"kubectl config view --minify | grep server | cut -f 2- -d \":\" | tr -d "
"\" \""
msgstr ""

#: ../../infrastructure/clusters/kubernetes/external.rst:95
msgid "**API Token** — Retrieve the service account token:"
msgstr "**Jeton API** — Récupérez le jeton du compte de service :"

#: ../../infrastructure/clusters/kubernetes/external.rst:97
msgid ""
"SECRET_NAME=$(kubectl get secrets | grep ^morpheus | cut -f1 -d ' ')\n"
"kubectl describe secret $SECRET_NAME | grep -E '^token' | cut -f2 -d':' |"
" tr -d \" \""
msgstr ""

#: ../../infrastructure/clusters/kubernetes/external.rst:102
msgid "Note"
msgstr "Note"

#: ../../infrastructure/clusters/kubernetes/external.rst:102
msgid ""
"For Kubernetes 1.24+, tokens are no longer auto-created for service "
"accounts. Use ``kubectl create token morpheus`` or create a long-lived "
"token Secret manually."
msgstr "Pour Kubernetes 1.24+, les jetons ne sont plus créés automatiquement pour les comptes de service. Utilisez ``kubectl create token morpheus`` ou créez manuellement un Secret de jeton longue durée."

#: ../../infrastructure/clusters/kubernetes/external.rst:104
msgid ""
"**Kube Config** (alternative) — Export the kubeconfig YAML for the "
"cluster."
msgstr "**Kube Config** (alternative) — Exportez le YAML kubeconfig du cluster."

#: ../../infrastructure/clusters/kubernetes/external.rst:107
msgid "Import Process"
msgstr "Processus d'importation"

#: ../../infrastructure/clusters/kubernetes/external.rst:109
msgid "Navigate to ``Infrastructure > Clusters``"
msgstr "Accédez à ``Infrastructure > Clusters``"

#: ../../infrastructure/clusters/kubernetes/external.rst:110
msgid "Select :guilabel:`+ ADD CLUSTER`"
msgstr "Sélectionnez :guilabel:`+ ADD CLUSTER`"

#: ../../infrastructure/clusters/kubernetes/external.rst:111
msgid "Choose **External Kubernetes Cluster**"
msgstr "Choisissez **External Kubernetes Cluster**"

#: ../../infrastructure/clusters/kubernetes/external.rst:112
msgid "Select a Group and click :guilabel:`NEXT`"
msgstr "Sélectionnez un Groupe et cliquez sur :guilabel:`NEXT`"

#: ../../infrastructure/clusters/kubernetes/external.rst:113
msgid "Configure:"
msgstr "Configurez :"

#: ../../infrastructure/clusters/kubernetes/external.rst:115
msgid "CLOUD"
msgstr "CLOUD"

#: ../../infrastructure/clusters/kubernetes/external.rst:116
msgid ""
"Select a previously-integrated Cloud (or any Cloud for general "
"association)"
msgstr "Sélectionnez un Cloud intégré précédemment (ou tout Cloud pour une association générale)"

#: ../../infrastructure/clusters/kubernetes/external.rst:117
msgid "CLUSTER NAME"
msgstr "CLUSTER NAME"

#: ../../infrastructure/clusters/kubernetes/external.rst:118
msgid "Friendly name for the cluster in |morpheus|"
msgstr "Nom convivial du cluster dans |morpheus|"

#: ../../infrastructure/clusters/kubernetes/external.rst:119
msgid "RESOURCE NAME"
msgstr "RESOURCE NAME"

#: ../../infrastructure/clusters/kubernetes/external.rst:120
msgid "Prefix for Kubernetes hosts shown in |morpheus| UI"
msgstr "Préfixe pour les hôtes Kubernetes affichés dans l'interface |morpheus|"

#: ../../infrastructure/clusters/kubernetes/external.rst:121
msgid "LAYOUT"
msgstr "LAYOUT"

#: ../../infrastructure/clusters/kubernetes/external.rst:122
msgid "Select an External Kubernetes layout matching the cluster version"
msgstr "Sélectionnez une disposition External Kubernetes correspondant à la version du cluster"

#: ../../infrastructure/clusters/kubernetes/external.rst:123
msgid "API URL"
msgstr "API URL"

#: ../../infrastructure/clusters/kubernetes/external.rst:124
msgid "The cluster API server URL (from prerequisites)"
msgstr "L'URL du serveur API du cluster (issue des prérequis)"

#: ../../infrastructure/clusters/kubernetes/external.rst:125
msgid "API TOKEN"
msgstr "API TOKEN"

#: ../../infrastructure/clusters/kubernetes/external.rst:126
msgid "The service account token (from prerequisites)"
msgstr "Le jeton du compte de service (issue des prérequis)"

#: ../../infrastructure/clusters/kubernetes/external.rst:127
msgid "KUBE CONFIG"
msgstr "KUBE CONFIG"

#: ../../infrastructure/clusters/kubernetes/external.rst:128
msgid "Alternatively, paste the full kubeconfig YAML"
msgstr "Vous pouvez aussi coller le YAML kubeconfig complet"

#: ../../infrastructure/clusters/kubernetes/external.rst:130
msgid "Complete the wizard"
msgstr "Terminez l'assistant"

#: ../../infrastructure/clusters/kubernetes/external.rst:132
msgid ""
"|morpheus| will validate connectivity, sync namespaces, workloads, and "
"storage, and begin ongoing monitoring."
msgstr "|morpheus| validera la connectivité, synchronisera les espaces de noms, les charges de travail et le stockage, et commencera la surveillance continue."

#: ../../infrastructure/clusters/kubernetes/external.rst:135
msgid "Authentication Methods"
msgstr "Méthodes d'authentification"

#: ../../infrastructure/clusters/kubernetes/external.rst:137
msgid "External clusters support two authentication methods:"
msgstr "Les clusters externes prennent en charge deux méthodes d'authentification :"

#: ../../infrastructure/clusters/kubernetes/external.rst:139
msgid ""
"**API Token** — A bearer token from a Kubernetes service account. Simpler"
" but requires manual rotation."
msgstr "**Jeton API** — Un jeton bearer issu d'un compte de service Kubernetes. Plus simple mais nécessite une rotation manuelle."

#: ../../infrastructure/clusters/kubernetes/external.rst:140
msgid ""
"**Kube Config** — Full kubeconfig YAML supporting certificate-based auth,"
" OIDC, and other authentication providers."
msgstr "**Kube Config** — YAML kubeconfig complet prenant en charge l'authentification par certificat, OIDC et d'autres fournisseurs d'authentification."

#: ../../infrastructure/clusters/kubernetes/external.rst:142
msgid ""
"At least one of API Token or Kube Config is required. If both are "
"provided, the API Token takes precedence."
msgstr "Au moins un jeton API ou Kube Config est requis. Si les deux sont fournis, le jeton API a priorité."

#: ../../infrastructure/clusters/kubernetes/external.rst:145
msgid "Post-Import Capabilities"
msgstr "Capacités post-importation"

#: ../../infrastructure/clusters/kubernetes/external.rst:147
msgid "Once imported, external clusters support:"
msgstr "Une fois importés, les clusters externes prennent en charge :"

#: ../../infrastructure/clusters/kubernetes/external.rst:149
msgid ""
"**Workload visibility** — All Pods, Deployments, Services, etc. are "
"synced and viewable"
msgstr "**Visibilité des charges de travail** — Tous les Pods, Deployments, Services, etc. sont synchronisés et consultables"

#: ../../infrastructure/clusters/kubernetes/external.rst:150
msgid "**Namespace management** — Create, view, and manage namespaces"
msgstr "**Gestion des espaces de noms** — Créer, consulter et gérer les espaces de noms"

#: ../../infrastructure/clusters/kubernetes/external.rst:151
msgid "**kubectl access** — Execute commands from the Control tab"
msgstr "**Accès kubectl** — Exécuter des commandes depuis l'onglet Control"

#: ../../infrastructure/clusters/kubernetes/external.rst:152
msgid "**App deployment** — Deploy Helm charts and Kubernetes Spec blueprints"
msgstr "**Déploiement d'applications** — Déployer des graphiques Helm et des plans Kubernetes Spec"

#: ../../infrastructure/clusters/kubernetes/external.rst:153
msgid "**Storage management** — View and manage PVs, PVCs, and StorageClasses"
msgstr "**Gestion du stockage** — Consulter et gérer les PV, PVC et StorageClasses"

#: ../../infrastructure/clusters/kubernetes/external.rst:154
msgid "**RBAC** — View and manage roles, role bindings, and service accounts"
msgstr "**RBAC** — Consulter et gérer les rôles, liaisons de rôles et comptes de service"

#: ../../infrastructure/clusters/kubernetes/external.rst:155
msgid "**Monitoring** — Events and logs are collected and viewable"
msgstr "**Surveillance** — Les événements et journaux sont collectés et consultables"

#: ../../infrastructure/clusters/kubernetes/external.rst:158
msgid "Limitations of External Clusters"
msgstr "Limites des clusters externes"

#: ../../infrastructure/clusters/kubernetes/external.rst:160
msgid "Cannot add or remove worker nodes through |morpheus|"
msgstr "Impossible d'ajouter ou de supprimer des nœuds worker via |morpheus|"

#: ../../infrastructure/clusters/kubernetes/external.rst:161
msgid "Cannot upgrade the Kubernetes version through |morpheus|"
msgstr "Impossible de mettre à niveau la version Kubernetes via |morpheus|"

#: ../../infrastructure/clusters/kubernetes/external.rst:162
msgid "No agent-based host metrics (CPU, memory at the node level)"
msgstr "Pas de métriques d'hôte basées sur l'agent (CPU, mémoire au niveau du nœud)"

#: ../../infrastructure/clusters/kubernetes/external.rst:163
msgid "Cannot manage the underlying infrastructure (VMs, networks)"
msgstr "Impossible de gérer l'infrastructure sous-jacente (VM, réseaux)"

#: ../../infrastructure/clusters/kubernetes/external.rst:164
msgid "Cluster provisioning logs are not available"
msgstr "Les journaux de provisionnement du cluster ne sont pas disponibles"

#: ../../infrastructure/clusters/kubernetes/external.rst:167
msgid "Use Cases for External Clusters"
msgstr "Cas d'utilisation des clusters externes"

#: ../../infrastructure/clusters/kubernetes/external.rst:169
msgid ""
"**OpenShift integration** — Import managed OpenShift clusters for "
"workload deployment"
msgstr "**Intégration OpenShift** — Importer des clusters OpenShift gérés pour le déploiement de charges de travail"

#: ../../infrastructure/clusters/kubernetes/external.rst:170
msgid ""
"**EKS/GKE/AKS brought externally** — Import cloud-managed clusters not "
"provisioned through |morpheus|"
msgstr "**EKS/GKE/AKS apportés en externe** — Importer des clusters gérés par le cloud non provisionnés via |morpheus|"

#: ../../infrastructure/clusters/kubernetes/external.rst:171
msgid ""
"**On-premises clusters** — Import clusters built with kubeadm, Rancher, "
"or other tools"
msgstr "**Clusters sur site** — Importer des clusters construits avec kubeadm, Rancher ou d'autres outils"

#: ../../infrastructure/clusters/kubernetes/external.rst:172
msgid "**Development clusters** — Import minikube or kind clusters for testing"
msgstr "**Clusters de développement** — Importer des clusters minikube ou kind pour les tests"

#: ../../infrastructure/clusters/kubernetes/external.rst:173
msgid ""
"**Multi-cluster management** — Centralize visibility across heterogeneous"
" Kubernetes environments"
msgstr "**Gestion multi-cluster** — Centraliser la visibilité dans des environnements Kubernetes hétérogènes"

#: ../../infrastructure/clusters/kubernetes/external.rst:176
msgid "Troubleshooting"
msgstr "Dépannage"

#: ../../infrastructure/clusters/kubernetes/external.rst:178
msgid ""
"**Connection refused:** Verify the API URL is accessible from the "
"|morpheus| appliance over port 6443"
msgstr "**Connexion refusée :** Vérifiez que l'URL API est accessible depuis l'appliance |morpheus| sur le port 6443"

#: ../../infrastructure/clusters/kubernetes/external.rst:179
msgid ""
"**Unauthorized:** Ensure the API token or kubeconfig credentials are "
"valid and have cluster-admin permissions"
msgstr "**Non autorisé :** Assurez-vous que le jeton API ou les identifiants kubeconfig sont valides et disposent des autorisations cluster-admin"

#: ../../infrastructure/clusters/kubernetes/external.rst:180
msgid ""
"**Partial sync:** Some resources may not appear if the service account "
"lacks list permissions on specific resource types"
msgstr "**Synchronisation partielle :** Certaines ressources peuvent ne pas apparaître si le compte de service n'a pas les autorisations list sur des types de ressources spécifiques"

#: ../../infrastructure/clusters/kubernetes/external.rst:181
msgid ""
"**Namespace not visible:** The service account must have cluster-level "
"list permissions (not just namespace-scoped)"
msgstr "**Espace de noms non visible :** Le compte de service doit disposer d'autorisations list au niveau du cluster (pas seulement au niveau de l'espace de noms)"

