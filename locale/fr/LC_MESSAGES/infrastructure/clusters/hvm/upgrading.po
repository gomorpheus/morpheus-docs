msgstr "Comportement"

#: ../../infrastructure/clusters/hvm/upgrading.rst:102
msgid "Agent upgrade fails"
msgstr "Échec de la mise à niveau de l'agent"

#: ../../infrastructure/clusters/hvm/upgrading.rst:103
msgid "Update stops for that host; error is reported"
msgstr "La mise à jour s'arrête pour cet hôte ; une erreur est signalée"

#: ../../infrastructure/clusters/hvm/upgrading.rst:104
msgid "Maintenance mode fails (insufficient capacity)"
msgstr "Échec du mode maintenance (capacité insuffisante)"

#: ../../infrastructure/clusters/hvm/upgrading.rst:105
