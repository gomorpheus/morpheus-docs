#: ../../infrastructure/clusters/hvm/architecture.rst:133
msgid "Maximum DLM delay waiting for fence resolution"
msgstr "Délai DLM maximum en attente de la résolution du fence"

#: ../../infrastructure/clusters/hvm/architecture.rst:136
msgid "Persistence Files"
msgstr "Fichiers de persistance"

#: ../../infrastructure/clusters/hvm/architecture.rst:138
msgid ""
"The |morpheus| agent persists cluster state to the following files on "
