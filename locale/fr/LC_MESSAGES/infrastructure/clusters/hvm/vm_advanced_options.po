#: ../../infrastructure/clusters/hvm/vm_advanced_options.rst:59
#: ../../infrastructure/clusters/hvm/vm_advanced_options.rst:73
#: ../../infrastructure/clusters/hvm/vm_advanced_options.rst:132
#: ../../infrastructure/clusters/hvm/vm_advanced_options.rst:149
