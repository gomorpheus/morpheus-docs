#: ../../infrastructure/clusters/hvm/storage_operations.rst:383
msgid ""
"If the heartbeat datastore fails, VM failover detection is impaired until"
" a new heartbeat target is configured"
msgstr ""

#: ../../infrastructure/clusters/hvm/storage_operations.rst:384
msgid ""
"Monitor the heartbeat datastore's health in the Quorum panel "
"(``Infrastructure > Clusters > [Cluster] > Summary``)"
msgstr ""

#: ../../infrastructure/clusters/hvm/storage_operations.rst:387
msgid "Datastore Health Monitoring"
msgstr ""

