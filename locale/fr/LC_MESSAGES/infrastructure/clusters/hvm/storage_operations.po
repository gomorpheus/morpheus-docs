#: ../../infrastructure/clusters/hvm/storage_operations.rst:513
msgid "Navigate to the cluster detail page > Storage tab"
msgstr ""

#: ../../infrastructure/clusters/hvm/storage_operations.rst:514
msgid "Click :guilabel:`+ Add` to create a new HPE Clustered Datastore"
msgstr ""

#: ../../infrastructure/clusters/hvm/storage_operations.rst:515
msgid "Select the NVMe block device (e.g., ``/dev/nvme0n1``) as the block device"
msgstr ""

#: ../../infrastructure/clusters/hvm/storage_operations.rst:516
msgid "Complete the datastore creation as normal"
msgstr ""

