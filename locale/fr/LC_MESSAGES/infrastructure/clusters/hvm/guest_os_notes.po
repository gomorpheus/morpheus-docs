msgstr "Effacer l'identifiant machine : ``sudo truncate -s 0 /etc/machine-id``"

#: ../../infrastructure/clusters/hvm/guest_os_notes.rst:157
msgid "Remove persistent network rules if present"
msgstr "Supprimer les règles réseau persistantes si elles sont présentes"

