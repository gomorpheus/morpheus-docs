#: ../../infrastructure/clusters/clusters.rst:38
msgid "Ext Kubernetes"
msgstr "Ext Kubernetes"

#: ../../infrastructure/clusters/clusters.rst:38
msgid "Brings an existing (brownfield) Kubernetes cluster into |morpheus|"
msgstr "Intègre un cluster Kubernetes existant (brownfield) dans |morpheus|"

