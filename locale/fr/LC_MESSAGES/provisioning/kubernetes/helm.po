msgid "APP NAME"
msgstr "APP NAME"

#: ../../provisioning/kubernetes/helm.rst:57
msgid "Name for the deployed release. This becomes the Helm release name."
msgstr "Nom de la version déployée. Cela devient le nom de version Helm."

#: ../../provisioning/kubernetes/helm.rst:58
msgid "GROUP"
msgstr "GROUP"

#: ../../provisioning/kubernetes/helm.rst:59
