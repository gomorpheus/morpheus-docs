msgid "Verify network connectivity between |morpheus| appliance and Tower server"
msgstr ""

#: ../../provisioning/automation/ansible_tower_job.rst:144
msgid "Check Tower integration credentials"
msgstr "Vérifiez les identifiants de l'intégration Tower"

#: ../../provisioning/automation/ansible_tower_job.rst:145
msgid "Ensure the Tower API URL is correct and accessible"
msgstr "Assurez-vous que l'URL de l'API Tower est correcte et accessible"

