msgstr "Afficher le nom et la valeur de l'entrée lors de la modification d'une instance"

#: ../../library/options/forms.rst:120
msgid "ALLOW MULTIPLE SELECTIONS"
msgstr "AUTORISER LES SÉLECTIONS MULTIPLES"

#: ../../library/options/forms.rst:121
msgid ""
"For certain Input types which support multiple selections (Select List "
