msgstr "ISO"

#: ../../library/virtual_images/virtual_images.rst:124
msgid "PXE Boot"
msgstr "PXE Boot"

#: ../../library/virtual_images/virtual_images.rst:125
msgid "QCOW2"
msgstr "QCOW2"

#: ../../library/virtual_images/virtual_images.rst:126
msgid "RAW"
msgstr "RAW"

