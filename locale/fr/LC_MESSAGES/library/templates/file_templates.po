"#!/bin/bash\n"
"\n"
"global\n"
" maxconn 256\n"
" log /dev/log local0 warning\n"
" log-tag <%=logTag%>\n"
"\n"
"defaults\n"
" mode http\n"
" timeout connect 5000ms\n"
" timeout client 50000ms\n"
" timeout server 50000ms\n"
" log global\n"
"\n"
"frontend http-in\n"
" bind *:<%=container.externalPort%>\n"
" default_backend servers\n"
"\n"
"backend servers\n"
" # server server1 127.0.0.1:80 maxconn 32"
