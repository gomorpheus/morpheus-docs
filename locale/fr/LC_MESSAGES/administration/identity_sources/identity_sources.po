#: ../../integration_guides/IdentityManagement/saml.rst:25
msgid ""
"There are 4 sections with fields that need to be populated depending on "
"the desired configuration:"
msgstr "Il y a 4 sections avec des champs à renseigner selon la configuration souhaitée :"

#: ../../integration_guides/IdentityManagement/saml.rst:27
#: ../../integration_guides/IdentityManagement/saml.rst:33
msgid "SAML Configuration"
msgstr "Configuration SAML"

#: ../../integration_guides/IdentityManagement/saml.rst:28
#: ../../integration_guides/IdentityManagement/saml.rst:59
msgid "Role Mappings"
msgstr "Mappages de rôles"

#: ../../integration_guides/IdentityManagement/saml.rst:29
#: ../../integration_guides/IdentityManagement/saml.rst:75
msgid "Role Options"
msgstr "Options de rôles"

#: ../../integration_guides/IdentityManagement/saml.rst:30
#: ../../integration_guides/IdentityManagement/saml.rst:83
