msgid "Select :guilabel:`Edit`"
msgstr "Sélectionnez :guilabel:`Edit`"

#: ../../administration/provisioning/licenses.rst:82
msgid "Modify the editable fields:"
msgstr "Modifiez les champs modifiables :"

#: ../../administration/provisioning/licenses.rst:84
msgid "Name, Version, Copies, Description"
msgstr "Nom, Version, Copies, Description"

#: ../../administration/provisioning/licenses.rst:85
msgid "Virtual Images (add/remove associations)"
msgstr "Virtual Images (ajouter/supprimer des associations)"

#: ../../administration/provisioning/licenses.rst:86
