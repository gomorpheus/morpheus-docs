msgid "About this task"
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:7
msgid ""
"Perform the following procedure to import HPE ProLiant Bare Metal Servers"
" into |morpheus|."
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:10
msgid "Procedure"
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:12
msgid ""
"Navigate to :menuselection:`Infrastructure --> Compute`, then select the "
"**Bare Metal** tab."
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:13
msgid "Click the :guilabel:`+ ADD` button and select **HPE Bare Metal Import**."
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:14
msgid "Select the target HPE BMaaS Cloud from the drop-down list."
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:15
msgid "Configure the import settings:"
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:17
msgid ""
"**iLO IP Range** - Specify the iLO IP address range to scan for HPE "
"ProLiant servers"
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:18
msgid "**Credentials** - Provide the iLO credentials for server discovery"
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:20
msgid "Click :guilabel:`Import` to begin the server discovery process."
msgstr ""

#: ../../integration_guides/Clouds/hpe_bare_metal/importing_servers.rst:22
msgid ""
"After successful import, the discovered HPE ProLiant servers appear in "
"the Bare Metal tab and are available for provisioning through |morpheus|."
msgstr ""

