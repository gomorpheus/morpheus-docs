msgid "Review"
msgstr "Analyse"

#: ../../integration_guides/Clouds/upcloud/upcloud.rst:93
msgid "Confirm all settings are correct and select `COMPLETE`."
msgstr "Confirmez que tous les paramètres sont corrects et sélectionnez `COMPLETE`."

