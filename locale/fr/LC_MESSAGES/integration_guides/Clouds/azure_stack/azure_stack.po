msgstr "Comptes de stockage"

#: ../../integration_guides/Clouds/azure_stack/azure_stack.rst:167
msgid "Marketplace Catalog"
msgstr "Catalogue Marketplace"

#: ../../integration_guides/Clouds/azure_stack/azure_stack.rst:168
msgid "Availability Sets"
msgstr "Jeux de disponibilité"

