msgstr "USERNAME"

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:27
#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:65
msgid ""
"Enter Username. If using an API Key, enter ``apikey`` for username, and "
"the API Key as the password."
msgstr "Saisissez le nom d'utilisateur. Si vous utilisez une clé API, saisissez ``apikey`` comme nom d'utilisateur et la clé API comme mot de passe."

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:28
#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:66
msgid "PASSWORD"
msgstr "PASSWORD"

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:29
#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:67
msgid "Enter Password. If using an API Key, the API Key as the password."
msgstr "Saisissez le mot de passe. Si vous utilisez une clé API, utilisez la clé API comme mot de passe."

#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:30
#: ../../integration_guides/Clouds/cloudfoundry/cloudfoundry.rst:68
