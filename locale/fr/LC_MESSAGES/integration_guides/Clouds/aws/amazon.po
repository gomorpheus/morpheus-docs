"  \"Statement\": [\n"
"      {\n"
"          \"Effect\": \"Allow\",\n"
"          \"Action\": [\n"
"              \"s3:ListBucket\",\n"
"              \"s3:GetBucketPolicy\",\n"
"              \"cur:DescribeReportDefinitions\",\n"
"              \"cur:PutReportDefinition\"\n"
"          ],\n"
"          \"Resource\": \"*\"\n"
"      }\n"
"  ]\n"
"}"
msgstr ""

#: ../../integration_guides/Clouds/aws/amazon.rst:219
