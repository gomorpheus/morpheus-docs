#: ../../integration_guides/code/git.rst:117
msgid "Removing a Git Integration"
msgstr "Suppression d'une intégration Git"

#: ../../integration_guides/code/git.rst:120
msgid "Click the trash icon on the integration row"
msgstr "Cliquez sur l'icône de corbeille sur la ligne de l'intégration"

#: ../../integration_guides/code/git.rst:121
msgid "Confirm deletion"
msgstr "Confirmez la suppression"

#: ../../integration_guides/code/git.rst:123
msgid "Warning"
msgstr "Avertissement"

#: ../../integration_guides/code/git.rst:123
msgid ""
"Removing a Git integration will break any Tasks, Spec Templates, or "
"Blueprints that reference it. Update those resources to use a different "
"source before removal."
msgstr "La suppression d'une intégration Git interrompra toutes les tâches, modèles de spécifications ou plans qui y font référence. Mettez à jour ces ressources pour utiliser une source différente avant la suppression."

