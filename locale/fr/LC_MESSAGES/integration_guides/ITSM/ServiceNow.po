#: ../../integration_guides/ITSM/ServiceNow.rst:57
#: ../../integration_guides/ITSM/ServiceNow.rst:242
#: ../../integration_guides/ITSM/ServiceNow.rst:244
#: ../../integration_guides/ITSM/ServiceNow.rst:264
#: ../../integration_guides/ITSM/ServiceNow.rst:302
msgid "Important"
msgstr ""

#: ../../integration_guides/ITSM/ServiceNow.rst:13
msgid ""
"Only one |morpheus| appliance should be integrated with a single "
"ServiceNow instance at any given time. Integrating multiple appliances "
"with the same ServiceNow instance can cause issues with sharing "
"|morpheus| Catalog Items through to ServiceNow for ordering from the "
"ServiceNow console. Additional details on Catalog Item sharing are "
"included in this guide."
msgstr ""

