msgstr "**Summary** — Description de l'action demandée (détails de provisionnement, type d'instance, etc.)"

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:102
msgid "**Requester** — Mapped from the |morpheus| user who initiated the request"
msgstr "**Requester** — Mappé depuis l'utilisateur |morpheus| ayant initié la requête"

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:103
msgid "**Company** — Mapped from the Tenant or configured default"
msgstr "**Company** — Mappé depuis le Locataire ou la valeur par défaut configurée"

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:104
msgid "**Category/Type** — Configured based on the policy settings"
msgstr "**Category/Type** — Configuré en fonction des paramètres de la règle"

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:107
msgid "Managing Approval Requests"
msgstr "Gestion des requêtes d'approbation"

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:109
