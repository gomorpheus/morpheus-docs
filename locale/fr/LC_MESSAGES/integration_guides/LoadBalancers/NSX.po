#: ../../integration_guides/LoadBalancers/NSX.rst:2
msgid "NSX Load Balancer"
msgstr "Équilibreur de charge NSX"

#: ../../integration_guides/LoadBalancers/NSX.rst:5
msgid "Add NSX Load Balancer"
msgstr "Ajouter un équilibreur de charge NSX"

#: ../../integration_guides/LoadBalancers/NSX.rst:7
msgid "To add an NSX Load Balancer Integration:"
msgstr "Pour ajouter une intégration d'équilibreur de charge NSX :"

#: ../../integration_guides/LoadBalancers/NSX.rst:9
msgid "Navigate to :menuselection:`Infrastructure --> Load Balancers`"
msgstr "Accédez à :menuselection:`Infrastructure --> Load Balancers`"

#: ../../integration_guides/LoadBalancers/NSX.rst:10
msgid "Select :guilabel:`+ ADD`"
msgstr "Sélectionnez :guilabel:`+ ADD`"

#: ../../integration_guides/LoadBalancers/NSX.rst:11
msgid "Select **NSX** from the drop-down list. The NEW LOAD BALANCER panel opens."
msgstr "Sélectionnez **NSX** dans la liste déroulante. Le panneau NEW LOAD BALANCER s'ouvre."

#: ../../integration_guides/LoadBalancers/NSX.rst:12
msgid "Configure the following:"
msgstr "Configurez les éléments suivants :"

#: ../../integration_guides/LoadBalancers/NSX.rst:14
msgid "GROUP"
msgstr "GROUP"

#: ../../integration_guides/LoadBalancers/NSX.rst:15
msgid "From the drop-down list, select the group for the load balancer."
msgstr "Dans la liste déroulante, sélectionnez le groupe pour l'équilibreur de charge."

#: ../../integration_guides/LoadBalancers/NSX.rst:16
msgid "CLOUD"
msgstr "CLOUD"

#: ../../integration_guides/LoadBalancers/NSX.rst:17
msgid "From the drop-down list, select the cloud that hosts the load balancer."
msgstr "Dans la liste déroulante, sélectionnez le Cloud qui héberge l'équilibreur de charge."

#: ../../integration_guides/LoadBalancers/NSX.rst:18
msgid "NAME"
msgstr "NAME"

#: ../../integration_guides/LoadBalancers/NSX.rst:19
msgid "Enter the load balancer name."
msgstr "Saisissez le nom de l'équilibreur de charge."

#: ../../integration_guides/LoadBalancers/NSX.rst:20
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#: ../../integration_guides/LoadBalancers/NSX.rst:21
msgid "Identifying information displayed on the load balancer list page."
msgstr "Informations d'identification affichées sur la page de liste des équilibreurs de charge."

#: ../../integration_guides/LoadBalancers/NSX.rst:22
msgid "NSX MANAGER"
msgstr "NSX MANAGER"

#: ../../integration_guides/LoadBalancers/NSX.rst:23
msgid "Enter the NSX Manager URL or IP address."
msgstr "Saisissez l'URL ou l'adresse IP de NSX Manager."

#: ../../integration_guides/LoadBalancers/NSX.rst:24
msgid "USERNAME"
msgstr "USERNAME"

#: ../../integration_guides/LoadBalancers/NSX.rst:25
msgid "Enter the NSX Manager username."
msgstr "Saisissez le nom d'utilisateur de NSX Manager."

#: ../../integration_guides/LoadBalancers/NSX.rst:26
msgid "PASSWORD"
msgstr "PASSWORD"

#: ../../integration_guides/LoadBalancers/NSX.rst:27
msgid "Enter the NSX Manager password."
msgstr "Saisissez le mot de passe de NSX Manager."

#: ../../integration_guides/LoadBalancers/NSX.rst:29
msgid "Click :guilabel:`SAVE CHANGES`."
msgstr "Cliquez sur :guilabel:`SAVE CHANGES`."

