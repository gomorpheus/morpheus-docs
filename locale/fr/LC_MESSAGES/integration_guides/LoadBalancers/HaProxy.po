#: ../../integration_guides/LoadBalancers/HaProxy.rst:2
msgid "HaProxy"
msgstr "HaProxy"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:5
msgid "Add HaProxy Container Load Balancer"
msgstr "Ajouter un équilibreur de charge conteneur HaProxy"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:7
msgid "To add a HaProxy Container Load Balancer Integration:"
msgstr "Pour ajouter une intégration d'équilibreur de charge conteneur HaProxy :"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:9
msgid "Navigate to :menuselection:`Infrastructure --> Load Balancers`"
msgstr "Accédez à :menuselection:`Infrastructure --> Load Balancers`"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:10
msgid "Select :guilabel:`+ ADD`"
msgstr "Sélectionnez :guilabel:`+ ADD`"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:11
msgid ""
"Select **HaProxy Container** from the drop-down list. The NEW LOAD "
"BALANCER panel opens."
msgstr "Sélectionnez **HaProxy Container** dans la liste déroulante. Le panneau NEW LOAD BALANCER s'ouvre."

#: ../../integration_guides/LoadBalancers/HaProxy.rst:12
msgid "Configure the following:"
msgstr "Configurez les éléments suivants :"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:14
msgid "GROUP"
msgstr "GROUP"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:15
msgid "From the drop-down list, select the group for the load balancer."
msgstr "Dans la liste déroulante, sélectionnez le groupe pour l'équilibreur de charge."

#: ../../integration_guides/LoadBalancers/HaProxy.rst:16
msgid "CLOUD"
msgstr "CLOUD"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:17
msgid "From the drop-down list, select the cloud that hosts the load balancer."
msgstr "Dans la liste déroulante, sélectionnez le Cloud qui héberge l'équilibreur de charge."

#: ../../integration_guides/LoadBalancers/HaProxy.rst:18
msgid "NAME"
msgstr "NAME"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:19
msgid "Enter the load balancer name."
msgstr "Saisissez le nom de l'équilibreur de charge."

#: ../../integration_guides/LoadBalancers/HaProxy.rst:20
msgid "DESCRIPTION"
msgstr "DESCRIPTION"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:21
msgid "Identifying information displayed on the load balancer list page."
msgstr "Informations d'identification affichées sur la page de liste des équilibreurs de charge."

#: ../../integration_guides/LoadBalancers/HaProxy.rst:22
msgid "VISIBILITY"
msgstr "VISIBILITY"

#: ../../integration_guides/LoadBalancers/HaProxy.rst:23
msgid "Define Multi-Tenant permissions."
msgstr "Définissez les autorisations multi-locataires."

#: ../../integration_guides/LoadBalancers/HaProxy.rst:25
msgid "Click :guilabel:`SAVE CHANGES`."
msgstr "Cliquez sur :guilabel:`SAVE CHANGES`."

