#: ../../integration_guides/Networking/aci.rst:50
msgid ""
"For your ACI Integration to be available during provisioning, ACI needs "
"to be defined on a Cloud or multiple Clouds ``NETWORK MODE`` advanced "
"options."
msgstr "Pour que votre intégration ACI soit disponible lors du provisionnement, ACI doit être défini dans les options avancées ``NETWORK MODE`` d'un ou plusieurs clouds."

#: ../../integration_guides/Networking/aci.rst:52
msgid "Select an existing VMware vCenter Cloud"
msgstr "Sélectionnez un cloud VMware vCenter existant"

#: ../../integration_guides/Networking/aci.rst:53
msgid "Select :guilabel:`EDIT`"
msgstr "Sélectionnez :guilabel:`EDIT`"

#: ../../integration_guides/Networking/aci.rst:54
