msgid ""
"**USERNAME:** A username for the portaladmin, or the user who logs into "
"the web console"
msgstr "**USERNAME:** Un nom d'utilisateur pour portaladmin, ou l'utilisateur qui se connecte à la console web"

#: ../../integration_guides/Networking/stealth.rst:30
msgid "**PASSWORD:** A password for the account"
msgstr "**PASSWORD:** Un mot de passe pour le compte"

#: ../../integration_guides/Networking/stealth.rst:31
msgid "**MANAGER USERNAME:** A username for the manager account"
msgstr "**MANAGER USERNAME:** Un nom d'utilisateur pour le compte manager"

#: ../../integration_guides/Networking/stealth.rst:32
msgid "**MANAGER PASSWORD:** A password for the manager account"
msgstr "**MANAGER PASSWORD:** Un mot de passe pour le compte manager"

#: ../../integration_guides/Networking/stealth.rst:34
