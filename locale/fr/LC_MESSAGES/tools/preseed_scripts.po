"# Reference Morpheus appliance URL\n"
"<%=morpheus.applianceUrl%>\n"
"\n"
"# Reference PXE root password from settings\n"
"rootpw --iscrypted <%=morpheus.pxeRootPassword%>\n"
"\n"
"# Reference custom variables\n"
"<%=customOptions.myVar%>"
msgstr ""

#: ../../tools/preseed_scripts.rst:145
msgid ""
