#: ../../tools/catalog_item_types.rst:198
msgid "API"
msgstr ""

#: ../../tools/catalog_item_types.rst:200
msgid "Catalog Item Types can be managed via the |morpheus| API:"
msgstr ""

#: ../../tools/catalog_item_types.rst:202
#, python-brace-format
msgid ""
"# List catalog item types\n"
"curl \"$MORPHEUS_API_URL/api/catalog-item-types\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Create a catalog item type\n"
"curl -X POST \"$MORPHEUS_API_URL/api/catalog-item-types\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\n"
"    \"catalogItemType\": {\n"
"      \"name\": \"Web Server\",\n"
"      \"description\": \"Standard Nginx web server\",\n"
"      \"type\": \"instance\",\n"
"      \"visibility\": \"public\",\n"
"      \"enabled\": true,\n"
"      \"config\": \"{\\\"instance\\\":{\\\"type\\\":\\\"nginx\\\"}}\"\n"
"    }\n"
"  }'"
msgstr ""

