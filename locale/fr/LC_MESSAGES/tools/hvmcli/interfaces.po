#: ../../tools/hvmcli/interfaces.rst:2
msgid "interfaces"
msgstr "interfaces"

#: ../../tools/hvmcli/interfaces.rst:4
msgid "List network interfaces and manage SR-IOV virtual functions."
msgstr "Lister les interfaces réseau et gérer les fonctions virtuelles SR-IOV."

#: ../../tools/hvmcli/interfaces.rst:7
msgid "Commands"
msgstr "Commandes"

#: ../../tools/hvmcli/interfaces.rst:13
msgid "Command"
msgstr "Commande"

#: ../../tools/hvmcli/interfaces.rst:14
msgid "Description"
msgstr "Description"

#: ../../tools/hvmcli/interfaces.rst:15
msgid "``list``"
msgstr "``list``"

#: ../../tools/hvmcli/interfaces.rst:16
msgid "List network interfaces with optional filtering"
msgstr "Lister les interfaces réseau avec filtrage optionnel"

#: ../../tools/hvmcli/interfaces.rst:17
msgid "``vf``"
msgstr "``vf``"

#: ../../tools/hvmcli/interfaces.rst:18
msgid "Manage SR-IOV virtual functions (list, create, delete, set)"
msgstr "Gérer les fonctions virtuelles SR-IOV (lister, créer, supprimer, définir)"

#: ../../tools/hvmcli/interfaces.rst:21
msgid "interfaces list"
msgstr "interfaces list"

#: ../../tools/hvmcli/interfaces.rst:23
msgid "List all network interfaces on the host. By default shows all interfaces."
msgstr "Lister toutes les interfaces réseau sur l'hôte. Affiche toutes les interfaces par défaut."

#: ../../tools/hvmcli/interfaces.rst:25
msgid "sudo hvmcli interfaces list"
msgstr ""

#: ../../tools/hvmcli/interfaces.rst:29
msgid ""
"Interface  Type      MAC                Speed    Link  Driver       "
"Firmware  SR-IOV         Max VFs  Configured VFs  Manufacturer  LLDP\n"
"---------  --------  -----------------  -------  ----  ----------   "
"--------  -------------  -------  --------------  ------------  ----\n"
"ens1f0np0  Ethernet  b4:96:91:a0:12:34  25Gbps   up    mlx5_core   22.39"
"     supported      64       0               Mellanox      sw1/Eth1/1\n"
"ens2f0np0  Ethernet  b4:96:91:a0:12:35  25Gbps   up    mlx5_core   22.39"
"     supported      64       0               Mellanox      sw1/Eth1/2\n"
"enp3s0     Ethernet  52:54:00:86:9e:12  -        up    virtio_net  -"
"         not supported  0        0               Red Hat       -"
msgstr ""

#: ../../tools/hvmcli/interfaces.rst:37
msgid "Use ``--filter`` to show specific interface types:"
msgstr "Utilisez ``--filter`` pour afficher des types d'interfaces spécifiques :"

#: ../../tools/hvmcli/interfaces.rst:39
msgid ""
"sudo hvmcli interfaces list --filter ethernet\n"
"sudo hvmcli interfaces list --filter fc\n"
"sudo hvmcli interfaces list --filter network\n"
"sudo hvmcli interfaces list --filter data\n"
"sudo hvmcli interfaces list --filter sdn"
msgstr ""

#: ../../tools/hvmcli/interfaces.rst:47
msgid "Filter options:"
msgstr "Options de filtre :"

#: ../../tools/hvmcli/interfaces.rst:49
msgid "``ethernet`` — Physical Ethernet interfaces only"
msgstr "``ethernet`` — Interfaces Ethernet physiques uniquement"

#: ../../tools/hvmcli/interfaces.rst:50
msgid "``fc`` — Fibre Channel HBAs only"
msgstr "``fc`` — HBA Fibre Channel uniquement"

#: ../../tools/hvmcli/interfaces.rst:51
msgid "``network`` — Interfaces that are part of a Virtual Switch network"
msgstr "``network`` — Interfaces faisant partie d'un réseau Virtual Switch"

#: ../../tools/hvmcli/interfaces.rst:52
msgid "``general`` — General purpose interfaces"
msgstr "``general`` — Interfaces à usage général"

#: ../../tools/hvmcli/interfaces.rst:53
msgid "``data`` — Data network interfaces"
msgstr "``data`` — Interfaces réseau de données"

#: ../../tools/hvmcli/interfaces.rst:54
msgid "``sdn`` — SDN network interfaces"
msgstr "``sdn`` — Interfaces réseau SDN"

#: ../../tools/hvmcli/interfaces.rst:57
msgid "interfaces vf"
msgstr "interfaces vf"

#: ../../tools/hvmcli/interfaces.rst:59
msgid "Manage SR-IOV Virtual Functions (VFs) on supported interfaces."
msgstr "Gérer les fonctions virtuelles SR-IOV (VF) sur les interfaces prises en charge."

#: ../../tools/hvmcli/interfaces.rst:61
msgid "**List VFs on an interface:**"
msgstr "**Lister les VF sur une interface :**"

#: ../../tools/hvmcli/interfaces.rst:63
msgid "sudo hvmcli interfaces vf list --interface ens1f0np0"
msgstr ""

#: ../../tools/hvmcli/interfaces.rst:67
msgid "**Create VFs on an interface:**"
msgstr "**Créer des VF sur une interface :**"

#: ../../tools/hvmcli/interfaces.rst:69
msgid "sudo hvmcli interfaces vf create --interface ens1f0np0 --count 4"
msgstr ""

#: ../../tools/hvmcli/interfaces.rst:73
msgid "**Delete VFs from an interface:**"
msgstr "**Supprimer les VF d'une interface :**"

#: ../../tools/hvmcli/interfaces.rst:75
msgid "sudo hvmcli interfaces vf delete --interface ens1f0np0"
msgstr ""

#: ../../tools/hvmcli/interfaces.rst:79
msgid "**Set VF properties:**"
msgstr "**Définir les propriétés VF :**"

#: ../../tools/hvmcli/interfaces.rst:81
msgid ""
"sudo hvmcli interfaces vf set --interface ens1f0np0 --vf 0 --mac "
"00:11:22:33:44:55"
msgstr ""

#: ../../tools/hvmcli/interfaces.rst:85
msgid "Note"
msgstr "Note"

#: ../../tools/hvmcli/interfaces.rst:85
msgid ""
"SR-IOV must be enabled in the BIOS and the NIC must support virtual "
"functions. Use ``hvmcli interfaces list`` to check SR-IOV support status."
msgstr "SR-IOV doit être activé dans le BIOS et la carte réseau doit prendre en charge les fonctions virtuelles. Utilisez ``hvmcli interfaces list`` pour vérifier l'état de la prise en charge SR-IOV."

