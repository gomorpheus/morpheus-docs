#: ../../tools/hvmcli/getting_started.rst:53
msgid "``--json``"
msgstr "``--json``"

#: ../../tools/hvmcli/getting_started.rst:54
msgid "Output results in JSON format. Useful for scripting and automation."
msgstr "Afficher les résultats au format JSON. Utile pour le scripting et l'automatisation."

#: ../../tools/hvmcli/getting_started.rst:55
msgid "``--debug``"
msgstr "``--debug``"

#: ../../tools/hvmcli/getting_started.rst:56
msgid "Enable verbose debug logging to stderr for troubleshooting."
msgstr "Activer la journalisation de débogage détaillée vers stderr pour le dépannage."

#: ../../tools/hvmcli/getting_started.rst:57
msgid "``--help``"
msgstr "``--help``"

#: ../../tools/hvmcli/getting_started.rst:58
msgid "Show help for the current namespace or command."
msgstr "Afficher l'aide pour l'espace de noms ou la commande actuelle."

#: ../../tools/hvmcli/getting_started.rst:61
msgid "JSON Output"
msgstr "Sortie JSON"

#: ../../tools/hvmcli/getting_started.rst:63
msgid ""
"All commands support ``--json`` output for automation and integration "
"with other tools. JSON responses follow a standard envelope format:"
msgstr "Toutes les commandes prennent en charge la sortie ``--json`` pour l'automatisation et l'intégration avec d'autres outils. Les réponses JSON suivent un format d'enveloppe standard :"

#: ../../tools/hvmcli/getting_started.rst:65
#, python-brace-format
msgid ""
"{\n"
"  \"errorCode\": 0,\n"
"  \"messages\": \"\",\n"
"  \"data\": { ... }\n"
"}"
msgstr ""

#: ../../tools/hvmcli/getting_started.rst:73
msgid "``errorCode``: ``0`` indicates success, non-zero indicates an error."
msgstr "``errorCode`` : ``0`` indique un succès, une valeur non nulle indique une erreur."

#: ../../tools/hvmcli/getting_started.rst:74
msgid "``messages``: Empty on success, contains error description on failure."
msgstr "``messages`` : Vide en cas de succès, contient la description de l'erreur en cas d'échec."

#: ../../tools/hvmcli/getting_started.rst:75
msgid "``data``: The command-specific response payload."
msgstr "``data`` : Charge utile de réponse spécifique à la commande."

