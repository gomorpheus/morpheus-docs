#: ../../tools/hvmcli/getting_started.rst:22
msgid "The general syntax for ``hvmcli`` commands is:"
msgstr "La syntaxe générale des commandes ``hvmcli`` est :"

#: ../../tools/hvmcli/getting_started.rst:24
msgid "sudo hvmcli <namespace> <command> [options]"
msgstr ""

#: ../../tools/hvmcli/getting_started.rst:28
msgid "For example:"
msgstr "Par exemple :"

#: ../../tools/hvmcli/getting_started.rst:30
msgid ""
"sudo hvmcli vm list\n"
"sudo hvmcli node list\n"
"sudo hvmcli virtswitch list"
