msgstr "``hvmcli`` est organisé dans les espaces de noms suivants :"

#: ../../tools/hvmcli/getting_started.rst:114
msgid "``vm``"
msgstr "``vm``"

#: ../../tools/hvmcli/getting_started.rst:115
msgid "Manage virtual machines (list, start, stop, restart)"
msgstr "Gérer les machines virtuelles (lister, démarrer, arrêter, redémarrer)"

#: ../../tools/hvmcli/getting_started.rst:116
msgid "``node``"
msgstr "``node``"

#: ../../tools/hvmcli/getting_started.rst:117
msgid "Manage the physical node (configuration, backup, reboot)"
msgstr "Gérer le nœud physique (configuration, sauvegarde, redémarrage)"

#: ../../tools/hvmcli/getting_started.rst:118
msgid "``interfaces``"
msgstr "``interfaces``"

#: ../../tools/hvmcli/getting_started.rst:119
msgid "List network interfaces and manage SR-IOV virtual functions"
msgstr "Lister les interfaces réseau et gérer les fonctions virtuelles SR-IOV"

#: ../../tools/hvmcli/getting_started.rst:121
msgid "Manage Virtual Switches (create, edit, delete, import)"
msgstr "Gérer les commutateurs virtuels (créer, modifier, supprimer, importer)"

#: ../../tools/hvmcli/getting_started.rst:122
msgid "``network``"
msgstr "``network``"

#: ../../tools/hvmcli/getting_started.rst:123
msgid "List virtual networks and run connectivity tests"
msgstr "Lister les réseaux virtuels et exécuter des tests de connectivité"

#: ../../tools/hvmcli/getting_started.rst:124
msgid "``storage``"
msgstr "``storage``"

#: ../../tools/hvmcli/getting_started.rst:125
msgid "Manage storage pools, iSCSI, Fibre Channel, and multipath"
msgstr "Gérer les pools de stockage, iSCSI, Fibre Channel et multipath"

#: ../../tools/hvmcli/getting_started.rst:126
msgid "``cluster``"
msgstr "``cluster``"

#: ../../tools/hvmcli/getting_started.rst:127
msgid "Show cluster state and quorum information"
msgstr "Afficher l'état du cluster et les informations de quorum"

#: ../../tools/hvmcli/getting_started.rst:128
msgid "``hardware``"
msgstr "``hardware``"

#: ../../tools/hvmcli/getting_started.rst:129
msgid "Inspect host hardware (CPU, memory, PCI, boot volume, IPMI)"
msgstr "Inspecter le matériel de l'hôte (CPU, mémoire, PCI, volume de démarrage, IPMI)"

#: ../../tools/hvmcli/getting_started.rst:130
msgid "``software``"
msgstr "``software``"

#: ../../tools/hvmcli/getting_started.rst:131
msgid "Inspect installed packages and manage OS updates"
msgstr "Inspecter les paquets installés et gérer les mises à jour OS"

#: ../../tools/hvmcli/getting_started.rst:132
msgid "``logs``"
msgstr "``logs``"

#: ../../tools/hvmcli/getting_started.rst:133
msgid "View node, cluster, and agent logs"
msgstr "Consulter les journaux du nœud, du cluster et de l'agent"

#: ../../tools/hvmcli/getting_started.rst:134
msgid "``health``"
msgstr "``health``"

#: ../../tools/hvmcli/getting_started.rst:135
msgid "Run host readiness and health checks"
msgstr "Exécuter des vérifications d'intégrité et de préparation de l'hôte"

#: ../../tools/hvmcli/getting_started.rst:136
msgid "``top``"
msgstr "``top``"

#: ../../tools/hvmcli/getting_started.rst:137
msgid "Real-time host and VM resource monitoring"
msgstr "Surveillance en temps réel des ressources de l'hôte et des VM"

#: ../../tools/hvmcli/getting_started.rst:138
msgid "``security``"
msgstr "``security``"

#: ../../tools/hvmcli/getting_started.rst:139
msgid "Security compliance operations (FIPS 140)"
msgstr "Opérations de conformité de sécurité (FIPS 140)"

#: ../../tools/hvmcli/getting_started.rst:141
msgid "Deploy VME Manager or Worker virtual machines"
msgstr "Déployer des machines virtuelles VME Manager ou Worker"

