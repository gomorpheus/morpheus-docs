msgstr "``--gateway <address>`` — Passerelle par défaut"

#: ../../tools/hvmcli/virtswitch.rst:108
msgid "``--mtu <1500|9000>`` — MTU size"
msgstr "``--mtu <1500|9000>`` — Taille MTU"

