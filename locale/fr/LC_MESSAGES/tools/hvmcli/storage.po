msgid "**Apply default multipath configuration:**"
msgstr "**Appliquer la configuration multipath par défaut :**"

#: ../../tools/hvmcli/storage.rst:106
msgid "sudo hvmcli storage multipath configure-default"
msgstr ""

#: ../../tools/hvmcli/storage.rst:110
msgid "**Force apply multipath configuration:**"
msgstr "**Forcer l'application de la configuration multipath :**"

#: ../../tools/hvmcli/storage.rst:112
msgid "sudo hvmcli storage multipath apply --force"
msgstr ""

#: ../../tools/hvmcli/storage.rst:117
msgid "storage rescan"
msgstr "storage rescan"

#: ../../tools/hvmcli/storage.rst:119
msgid "Rescan iSCSI and Fibre Channel storage to discover new LUNs."
msgstr "Rescanner le stockage iSCSI et Fibre Channel pour découvrir de nouveaux LUN."

#: ../../tools/hvmcli/storage.rst:121
msgid "sudo hvmcli storage rescan"
msgstr ""

#: ../../tools/hvmcli/storage.rst:125
msgid "Tip"
msgstr "Astuce"

#: ../../tools/hvmcli/storage.rst:125
msgid ""
"Run ``storage rescan`` after provisioning new LUNs on your storage array "
"to make them visible to the host."
msgstr "Exécutez ``storage rescan`` après le provisionnement de nouveaux LUN sur votre baie de stockage pour les rendre visibles à l'hôte."

