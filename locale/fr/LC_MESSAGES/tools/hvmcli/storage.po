msgstr "Gérer la configuration multipath I/O pour le stockage iSCSI et FC."

#: ../../tools/hvmcli/storage.rst:92
msgid "**Show multipath status:**"
msgstr "**Afficher l'état multipath :**"

#: ../../tools/hvmcli/storage.rst:94
msgid "sudo hvmcli storage multipath status"
msgstr ""

#: ../../tools/hvmcli/storage.rst:98
msgid "**Validate multipath configuration:**"
msgstr "**Valider la configuration multipath :**"

#: ../../tools/hvmcli/storage.rst:100
msgid "sudo hvmcli storage multipath validate"
msgstr ""

