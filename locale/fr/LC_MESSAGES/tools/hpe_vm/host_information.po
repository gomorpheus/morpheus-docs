#: ../../tools/hpe_vm/host_information.rst:2
msgid "Host Information"
msgstr "Informations sur l'hôte"

#: ../../tools/hpe_vm/host_information.rst:4
msgid ""
"The **Host Information** menu option displays basic details about the HVM"
" host hardware and operating system."
msgstr "L'option de menu **Informations sur l'hôte** affiche les détails de base du matériel et du système d'exploitation de l'hôte HVM."

#: ../../tools/hpe_vm/host_information.rst:7
msgid "Displayed Information"
msgstr "Informations affichées"

#: ../../tools/hpe_vm/host_information.rst:13
msgid "Field"
msgstr "Champ"

#: ../../tools/hpe_vm/host_information.rst:14
msgid "Source"
msgstr "Source"

#: ../../tools/hpe_vm/host_information.rst:15
msgid "**OS Name / Version**"
msgstr "**Nom / Version de l'OS**"

#: ../../tools/hpe_vm/host_information.rst:16
msgid "Operating system release information"
msgstr "Informations sur la version du système d'exploitation"

#: ../../tools/hpe_vm/host_information.rst:17
msgid "**Product Name**"
msgstr "**Nom du produit**"

#: ../../tools/hpe_vm/host_information.rst:18
msgid "DMI product name (``/sys/class/dmi/id/product_name``)"
msgstr "Nom du produit DMI (``/sys/class/dmi/id/product_name``)"

#: ../../tools/hpe_vm/host_information.rst:19
msgid "**Vendor**"
msgstr "**Fabricant**"

#: ../../tools/hpe_vm/host_information.rst:20
msgid "DMI system vendor (``/sys/class/dmi/id/sys_vendor``)"
msgstr "Fabricant système DMI (``/sys/class/dmi/id/sys_vendor``)"

#: ../../tools/hpe_vm/host_information.rst:21
msgid "**CPU Model**"
msgstr "**Modèle de processeur**"

#: ../../tools/hpe_vm/host_information.rst:22
msgid "Processor model from ``/proc/cpuinfo``"
msgstr "Modèle du processeur depuis ``/proc/cpuinfo``"

#: ../../tools/hpe_vm/host_information.rst:24
msgid ""
"This screen is read-only and provides a quick way to verify the host "
"hardware without dropping to a shell."
msgstr "Cet écran est en lecture seule et permet de vérifier rapidement le matériel de l'hôte sans accéder à un shell."

