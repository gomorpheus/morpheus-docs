#: ../../tools/migrations/overview.rst:247
msgid ""
"Infrastructure: Manage Placement = Full, Infrastructure: Clusters = "
"Group, Infrastructure: Compute = Group. Can live-migrate VMs within "
"assigned clusters only."
msgstr "Infrastructure: Manage Placement = Complet, Infrastructure: Clusters = Groupe, Infrastructure: Compute = Groupe. Peut effectuer une migration à chaud des VM uniquement dans les clusters assignés."

#: ../../tools/migrations/overview.rst:248
msgid "Migration Administrator"
msgstr "Administrateur de migration"

#: ../../tools/migrations/overview.rst:249
msgid ""
"Services: Migrations = Full, Infrastructure: Clusters = Full, "
"Infrastructure: Compute = Full, Provisioning: Instances = Full. Can "
"execute bulk migrations across all clusters."
msgstr "Services: Migrations = Complet, Infrastructure: Clusters = Complet, Infrastructure: Compute = Complet, Provisionnement: Instances = Complet. Peut exécuter des migrations en masse sur tous les clusters."

#: ../../tools/migrations/overview.rst:250
msgid "Read-only Observer"
msgstr "Observateur en lecture seule"

#: ../../tools/migrations/overview.rst:251
msgid ""
"Services: Migrations = Read, Infrastructure: Clusters = Read, "
"Infrastructure: Compute = Read. Can view migration plans and status but "
"cannot execute or modify."
msgstr "Services: Migrations = Lecture, Infrastructure: Clusters = Lecture, Infrastructure: Compute = Lecture. Peut consulter les plans de migration et l'état, mais ne peut pas exécuter ni modifier."

