#: ../../getting_started/maintenance/wars.rst:2
msgid "Morpheus UI war files"
msgstr "Fichiers war de l'interface utilisateur Morpheus"

#: ../../getting_started/maintenance/wars.rst:4
msgid ""
"Pre-release or patched versions of the |morpheus| UI are sometimes "
"provided. To deploy the ui war on a |morpheus| Appliance:"
msgstr "Des versions préliminaires ou corrigées de l'interface utilisateur |morpheus| sont parfois fournies. Pour déployer le war de l'interface utilisateur sur une appliance |morpheus| :"

#: ../../getting_started/maintenance/wars.rst:6
msgid "Download the war file to the target appliance"
msgstr "Téléchargez le fichier war sur l'appliance cible"

#: ../../getting_started/maintenance/wars.rst:8
msgid "wget https://url/war_file"
msgstr ""

#: ../../getting_started/maintenance/wars.rst:12
msgid "Note"
msgstr "Note"

#: ../../getting_started/maintenance/wars.rst:12
msgid ""
"If the war file is provided via a droplr link, ensure a ``+`` is added to"
" end of droplr url or the file will not download"
msgstr "Si le fichier war est fourni via un lien droplr, assurez-vous qu'un ``+`` est ajouté à la fin de l'URL droplr, sinon le fichier ne se téléchargera pas"

#: ../../getting_started/maintenance/wars.rst:14
msgid "Backup current war file"
msgstr "Sauvegardez le fichier war actuel"

#: ../../getting_started/maintenance/wars.rst:16
#, python-format
msgid ""
"sudo mv /opt/morpheus/lib/morpheus/morpheus-ui.war "
"/opt/morpheus/lib/morpheus/morpheus-ui.bak.`date +\"%m-%d-%Y\"`"
msgstr ""

#: ../../getting_started/maintenance/wars.rst:20
msgid "Move and rename new war file"
msgstr "Déplacez et renommez le nouveau fichier war"

#: ../../getting_started/maintenance/wars.rst:22
msgid "sudo mv <file> /opt/morpheus/lib/morpheus/morpheus-ui.war"
msgstr ""

#: ../../getting_started/maintenance/wars.rst:26
msgid "Ensure war is owned by ``morpheus-app``"
msgstr "Assurez-vous que le war appartient à ``morpheus-app``"

#: ../../getting_started/maintenance/wars.rst:28
msgid ""
"sudo chown morpheus-app.morpheus-app /opt/morpheus/lib/morpheus/morpheus-"
"ui.war"
msgstr ""

#: ../../getting_started/maintenance/wars.rst:32
msgid "Restart the |morpheus| UI"
msgstr "Redémarrez l'interface utilisateur |morpheus|"

#: ../../getting_started/maintenance/wars.rst:34
msgid "sudo morpheus-ctl restart morpheus-ui"
msgstr ""

#: ../../getting_started/maintenance/wars.rst:38
msgid "The new ui war will load on startup!"
msgstr "Le nouveau war de l'interface utilisateur se chargera au démarrage !"

