msgstr "SAML-SP-Feldwert zum Mappen auf den Vornamen des |morpheus|-Benutzers"

#: ../../integration_guides/IdentityManagement/saml.rst:87
msgid "SURNAME ATTRIBUTE NAME"
msgstr "SURNAME ATTRIBUTE NAME"

#: ../../integration_guides/IdentityManagement/saml.rst:88
msgid "SAML SP field value to map to |morpheus| user Last Name"
msgstr "SAML-SP-Feldwert zum Mappen auf den Nachnamen des |morpheus|-Benutzers"

#: ../../integration_guides/IdentityManagement/saml.rst:89
msgid "EMAIL ATTRIBUTE"
msgstr "EMAIL ATTRIBUTE"

#: ../../integration_guides/IdentityManagement/saml.rst:90
msgid "SAML SP field value to map to |morpheus| user email address"
msgstr "SAML-SP-Feldwert zum Mappen auf die E-Mail-Adresse des |morpheus|-Benutzers"

