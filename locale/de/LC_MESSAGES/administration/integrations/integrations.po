msgstr "**DESCRIPTION:** Ein Beschreibungswert (falls vorhanden), der im Plugin kodiert ist"

#: ../../administration/integrations/plugins.rst:30
msgid "**FILE NAME:** The .jar filename"
msgstr "**FILE NAME:** Der .jar-Dateiname"

#: ../../administration/integrations/plugins.rst:31
msgid "**VERSION:** The plugin version number"
msgstr "**VERSION:** Die Plugin-Versionsnummer"

#: ../../administration/integrations/plugins.rst:32
msgid ""
"**STATUS:** The status of the plugin, such as \"loaded\" when the plugin "
"is ready for use"
msgstr "**STATUS:** Der Status des Plugins, beispielsweise „loaded“, wenn das Plugin einsatzbereit ist"

#: ../../administration/integrations/plugins.rst:33
msgid "**STATUS MESSAGE:** A status message (if any) for the plugin"
msgstr "**STATUS MESSAGE:** Eine Statusmeldung (falls vorhanden) für das Plugin"

#: ../../administration/integrations/plugins.rst:34
