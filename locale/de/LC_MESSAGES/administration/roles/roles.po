msgid ""
"User can access Objects assigned to or shared with Groups the User has "
"access to"
msgstr ""

#: ../../administration/roles/role_permissions.rst:87
msgid "Remote Console: Provisioned"
msgstr ""

#: ../../administration/roles/role_permissions.rst:88
msgid ""
"Remote Console tab will only appear after instance is successfully "
"provisioned."
msgstr ""

#: ../../administration/roles/role_permissions.rst:89
msgid "Remote Console: Auto Login"
msgstr ""

#: ../../administration/roles/role_permissions.rst:90
msgid ""
"RDP and SSH only, controls if user is auto-logged in to Remote Console or"
" presented with login prompt."
msgstr ""

#: ../../administration/roles/role_permissions.rst:91
msgid "Role Mappings"
msgstr ""

#: ../../administration/roles/role_permissions.rst:92
msgid ""
"Gives User Access to Role Mappings config in ``/admin/roles`` for "
"configuring Identity Source Role Mappings without providing Access to "
"other Identity Source configuration settings."
msgstr ""

