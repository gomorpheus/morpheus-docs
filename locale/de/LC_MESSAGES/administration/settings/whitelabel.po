#: ../../administration/settings/whitelabel.rst:87
msgid "​UI Loading Page"
msgstr ""

#: ../../administration/settings/whitelabel.rst:89
msgid ""
"When the |morpheus| UI is restarted or loading, a default \"Morpheus is "
"Loading\" page is displayed. This page can be changed by adding the "
"following to ``/etc/morpheus/morpheus.rb`` and adjusting the values."
msgstr ""

#: ../../administration/settings/whitelabel.rst:91
msgid ""
"``morpheus-ctl reconfigure`` must be ran for any chnages to "
"``/etc/morpheus/morpheus.rb`` to take effect."
msgstr ""

#: ../../administration/settings/whitelabel.rst:93
msgid ""
"nginx['web_root_internal'] = \"/opt/morpheus/embedded/nginx/html\"\n"
"nginx['loading_pages']['max_loops'] = 6 * 10 # 10 secs per loop x 6 times"
" to get 60 seconds * 10 to get to 10 minutes\n"
"nginx['loading_pages']['timeout_page'] = '/timeout.html'\n"
"nginx['loading_pages']['iteration_time'] = 10_000\n"
"nginx['loading_pages']['loading_page_title'] = 'Morpheus Loading'\n"
"nginx['loading_pages']['loading_page_h1'] = 'Morpheus is Loading...'\n"
"nginx['loading_pages']['loading_page_h2'] = 'please wait'\n"
"nginx['loading_pages']['timout_page_title'] = 'Morpheus timeout, please "
"try again...'\n"
"nginx['loading_pages']['timout_page_h1'] = 'Timeout waiting for Morpheus "
"to load, click below to try again.'\n"
"nginx['loading_pages']['failure_page_title'] = 'Morpheus Server Error'\n"
"nginx['loading_pages']['failure_page_h1'] = 'Morpheus Server Error'\n"
"nginx['loading_pages']['failure_page_h2'] = 'Please contact your system "
"administrator for assistance.'"
msgstr ""

