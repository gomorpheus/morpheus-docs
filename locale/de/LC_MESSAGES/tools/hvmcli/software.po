msgstr "Paket- und Betriebssystem-Updates verwalten"

#: ../../tools/hvmcli/software.rst:21
msgid "software list"
msgstr ""

#: ../../tools/hvmcli/software.rst:23
msgid "Show installed versions of key HVM components."
msgstr "Installierte Versionen wichtiger HVM-Komponenten anzeigen."

#: ../../tools/hvmcli/software.rst:25
