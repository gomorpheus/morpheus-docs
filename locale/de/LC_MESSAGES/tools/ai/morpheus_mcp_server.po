#: ../../tools/ai/morpheus_mcp_server.rst:581
msgid "SSL/TLS Certificates"
msgstr "SSL/TLS-Zertifikate"

#: ../../tools/ai/morpheus_mcp_server.rst:585
msgid ""
"Most MCP clients require a valid, trusted SSL certificate. Self-signed or"
" untrusted certificates will cause TLS verification failures that cannot "
"be easily bypassed in most MCP client implementations."
msgstr "Die meisten MCP-Clients erfordern ein gültiges, vertrauenswürdiges SSL-Zertifikat. Selbstsignierte oder nicht vertrauenswürdige Zertifikate führen zu TLS-Überprüfungsfehlern, die sich in den meisten MCP-Client-Implementierungen nicht leicht umgehen lassen."

#: ../../tools/ai/morpheus_mcp_server.rst:588
msgid "Using a Trusted Certificate (Recommended)"
msgstr "Vertrauenswürdiges Zertifikat verwenden (empfohlen)"

#: ../../tools/ai/morpheus_mcp_server.rst:590
msgid ""
"The recommended approach is to configure your Morpheus appliance with a "
"certificate from a trusted Certificate Authority (CA). This ensures all "
"MCP clients can connect without additional configuration."
msgstr "Der empfohlene Ansatz ist, Ihre Morpheus-Appliance mit einem Zertifikat einer vertrauenswürdigen Certificate Authority (CA) zu konfigurieren. So können alle MCP-Clients ohne zusätzliche Konfiguration eine Verbindung herstellen."

#: ../../tools/ai/morpheus_mcp_server.rst:593
msgid "Self-Signed Certificates"
msgstr "Selbstsignierte Zertifikate"

#: ../../tools/ai/morpheus_mcp_server.rst:595
msgid ""
"If you must use a self-signed certificate, add it to your operating "
"system's trust store:"
msgstr "Wenn Sie ein selbstsigniertes Zertifikat verwenden müssen, fügen Sie es dem Trust Store Ihres Betriebssystems hinzu:"

#: ../../tools/ai/morpheus_mcp_server.rst:597
msgid "**macOS:**"
msgstr "**macOS:**"

#: ../../tools/ai/morpheus_mcp_server.rst:599
msgid ""
"sudo security add-trusted-cert -d -r trustRoot \\\n"
"  -k /Library/Keychains/System.keychain /path/to/morpheus-cert.pem"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:604
msgid "**Linux:**"
msgstr "**Linux:**"

#: ../../tools/ai/morpheus_mcp_server.rst:606
msgid ""
"sudo cp /path/to/morpheus-cert.pem /usr/local/share/ca-"
"certificates/morpheus.crt\n"
"sudo update-ca-certificates"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:611
msgid "**Windows (PowerShell):**"
msgstr "**Windows (PowerShell):**"

#: ../../tools/ai/morpheus_mcp_server.rst:613
msgid ""
"Import-Certificate -FilePath \"C:\\path\\to\\morpheus-cert.pem\" "
"-CertStoreLocation Cert:\\LocalMachine\\Root"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:617
msgid "**Node.js-based clients:**"
msgstr "**Node.js-basierte Clients:**"

#: ../../tools/ai/morpheus_mcp_server.rst:619
msgid "For MCP clients built on Node.js, set the following environment variable:"
msgstr "Für MCP-Clients auf Basis von Node.js setzen Sie die folgende Umgebungsvariable:"

#: ../../tools/ai/morpheus_mcp_server.rst:621
msgid "export NODE_EXTRA_CA_CERTS=/path/to/morpheus-cert.pem"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:626
msgid "Verifying the Connection"
msgstr "Verbindung prüfen"

#: ../../tools/ai/morpheus_mcp_server.rst:628
msgid ""
"Use the following curl commands to verify your MCP server is accessible "
"and responding correctly."
msgstr "Verwenden Sie die folgenden curl-Befehle, um zu prüfen, ob Ihr MCP-Server erreichbar ist und korrekt antwortet."

#: ../../tools/ai/morpheus_mcp_server.rst:630
msgid "**Initialize a session:**"
msgstr "**Sitzung initialisieren:**"

#: ../../tools/ai/morpheus_mcp_server.rst:632
#, python-brace-format
msgid ""
"curl -X POST \"https://your-morpheus-host/api/mcp\" \\\n"
"  -H \"Authorization: Bearer YOUR_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", "
"\"params\": {\"protocolVersion\": \"2025-06-18\", \"clientInfo\": "
"{\"name\": \"curl-test\", \"version\": \"1.0\"}}}'"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:639
msgid "**List available tools:**"
msgstr "**Verfügbare Tools auflisten:**"

#: ../../tools/ai/morpheus_mcp_server.rst:641
#, python-brace-format
msgid ""
"curl -X POST \"https://your-morpheus-host/api/mcp\" \\\n"
"  -H \"Authorization: Bearer YOUR_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"tools/list\"}'"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:648
msgid "**List tools filtered by category:**"
msgstr "**Tools nach Kategorie gefiltert auflisten:**"

#: ../../tools/ai/morpheus_mcp_server.rst:650
#, python-brace-format
msgid ""
"curl -X POST \"https://your-morpheus-"
"host/api/mcp?toolCategories=instances,clouds\" \\\n"
"  -H \"Authorization: Bearer YOUR_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"tools/list\"}'"
msgstr ""

#: ../../tools/ai/morpheus_mcp_server.rst:657
msgid "**Call a tool:**"
msgstr "**Tool aufrufen:**"

#: ../../tools/ai/morpheus_mcp_server.rst:659
#, python-brace-format
msgid ""
"curl -X POST \"https://your-morpheus-host/api/mcp\" \\\n"
"  -H \"Authorization: Bearer YOUR_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\"jsonrpc\": \"2.0\", \"id\": 3, \"method\": \"tools/call\", "
"\"params\": {\"name\": \"whoami\", \"arguments\": {}}}'"
msgstr ""

