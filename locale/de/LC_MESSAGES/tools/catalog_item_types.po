#, python-brace-format
msgid ""
"{\n"
"  \"instance\": {\n"
"    \"type\": \"nginx\",\n"
"    \"cloud\": {\"id\": 1},\n"
"    \"layout\": {\"id\": 105},\n"
"    \"plan\": {\"id\": 10}\n"
"  },\n"
"  \"config\": {\n"
"    \"resourcePool\": {\"id\": 5},\n"
"    \"network\": {\"id\": 3}\n"
"  },\n"
"  \"volumes\": [\n"
"    {\"rootVolume\": true, \"size\": 50}\n"
"  ]\n"
"}"
msgstr ""

#: ../../tools/catalog_item_types.rst:121
msgid ""
"Users ordering this item see only the form fields you've configured — the"
" underlying provisioning details are hidden."
msgstr "Benutzer, die diesen Eintrag bestellen, sehen nur die von Ihnen konfigurierten Formularfelder — die zugrunde liegenden Provisionierungsdetails bleiben verborgen."

#: ../../tools/catalog_item_types.rst:124
msgid "Blueprint Configuration"
msgstr "Blueprint-Konfiguration"

#: ../../tools/catalog_item_types.rst:126
msgid "For Blueprint-type catalog items, reference an existing App Blueprint:"
msgstr "Bei Katalogeinträgen vom Typ Blueprint referenzieren Sie einen vorhandenen App Blueprint:"

#: ../../tools/catalog_item_types.rst:128
msgid "Select the Blueprint from the configuration"
msgstr "Wählen Sie den Blueprint aus der Konfiguration"

#: ../../tools/catalog_item_types.rst:129
msgid "Optionally lock specific configuration values"
msgstr "Sperren Sie optional bestimmte Konfigurationswerte"

#: ../../tools/catalog_item_types.rst:130
msgid "Users can fill in only the fields exposed through the form"
msgstr "Benutzer können nur die über das Formular freigegebenen Felder ausfüllen"

#: ../../tools/catalog_item_types.rst:133
msgid "Workflow Configuration"
msgstr "Workflow-Konfiguration"

#: ../../tools/catalog_item_types.rst:135
msgid "For Workflow-type catalog items:"
msgstr "Bei Katalogeinträgen vom Typ Workflow:"

#: ../../tools/catalog_item_types.rst:137
msgid "Select an Operational Workflow"
msgstr "Wählen Sie einen Operational Workflow"

#: ../../tools/catalog_item_types.rst:138
msgid "Configure which inputs are presented to the user"
msgstr "Konfigurieren Sie, welche Eingaben dem Benutzer angezeigt werden"

#: ../../tools/catalog_item_types.rst:139
msgid "The workflow executes when the item is ordered"
msgstr "Der Workflow wird ausgeführt, wenn der Eintrag bestellt wird"

#: ../../tools/catalog_item_types.rst:142
msgid "Form Fields (Option Types)"
msgstr "Formularfelder (Option Types)"

#: ../../tools/catalog_item_types.rst:144
msgid "Option Types define the form fields shown to catalog users at order time:"
msgstr "Option Types definieren die Formularfelder, die Katalogbenutzern bei der Bestellung angezeigt werden:"

#: ../../tools/catalog_item_types.rst:146
msgid "**Text:** Free-text input"
msgstr "**Text:** Freitexteingabe"

#: ../../tools/catalog_item_types.rst:147
msgid "**Number:** Numeric input"
msgstr "**Number:** Numerische Eingabe"

#: ../../tools/catalog_item_types.rst:148
msgid "**Select List:** Dropdown from a static or dynamic list"
msgstr "**Select List:** Dropdown aus einer statischen oder dynamischen Liste"

#: ../../tools/catalog_item_types.rst:149
msgid "**Checkbox:** Boolean toggle"
msgstr "**Checkbox:** Boolescher Schalter"

#: ../../tools/catalog_item_types.rst:150
msgid "**Password:** Masked input"
msgstr "**Password:** Maskierte Eingabe"

#: ../../tools/catalog_item_types.rst:151
msgid "**Text Area:** Multi-line text"
msgstr "**Text Area:** Mehrzeiliger Text"

#: ../../tools/catalog_item_types.rst:152
msgid "**Hidden:** Value passed without user input"
msgstr "**Hidden:** Wert wird ohne Benutzereingabe übergeben"

#: ../../tools/catalog_item_types.rst:153
msgid "**Typeahead:** Search-as-you-type selection"
msgstr "**Typeahead:** Suche-während-der-Eingabe-Auswahl"

#: ../../tools/catalog_item_types.rst:155
msgid ""
"Form fields can be sourced from Option Type Lists for dynamic data (e.g.,"
" available environments, networks, resource pools)."
msgstr "Formularfelder können aus Option Type Lists für dynamische Daten stammen (z. B. verfügbare Umgebungen, Netzwerke, Ressourcenpools)."

#: ../../tools/catalog_item_types.rst:158
msgid "Quantity Support"
msgstr "Mengenunterstützung"

#: ../../tools/catalog_item_types.rst:160
msgid ""
"**ALLOW QUANTITY:** When enabled, users can order multiple copies in a "
"single request"
msgstr "**ALLOW QUANTITY:** Wenn aktiviert, können Benutzer mehrere Kopien in einer einzigen Anfrage bestellen"

#: ../../tools/catalog_item_types.rst:161
msgid ""
"**MAX QUANTITY:** Maximum number of copies per order (leave empty for "
"unlimited)"
msgstr "**MAX QUANTITY:** Maximale Anzahl von Kopien pro Auftrag (leer lassen für unbegrenzt)"

#: ../../tools/catalog_item_types.rst:162
msgid ""
"**DISABLE AUTO PRICE:** When enabled, pricing is not automatically "
"calculated for quantity changes"
msgstr "**DISABLE AUTO PRICE:** Wenn aktiviert, wird die Preisberechnung bei Mengenänderungen nicht automatisch durchgeführt"

#: ../../tools/catalog_item_types.rst:165
msgid "Managing Catalog Item Types"
msgstr "Catalog Item Types verwalten"

#: ../../tools/catalog_item_types.rst:168
msgid "Editing"
msgstr "Bearbeiten"

#: ../../tools/catalog_item_types.rst:171
msgid "Click the item name or the pencil icon"
msgstr "Klicken Sie auf den Eintragsnamen oder das Bleistiftsymbol"

#: ../../tools/catalog_item_types.rst:172
msgid "Modify settings as needed"
msgstr "Einstellungen nach Bedarf ändern"

#: ../../tools/catalog_item_types.rst:176
msgid "Deleting"
msgstr "Löschen"

#: ../../tools/catalog_item_types.rst:179
msgid "Click the trash icon on the item row"
msgstr "Klicken Sie auf das Papierkorb-Symbol in der Eintragszeile"

#: ../../tools/catalog_item_types.rst:180
msgid "Confirm deletion"
msgstr "Löschung bestätigen"

#: ../../tools/catalog_item_types.rst:182
msgid "Note"
msgstr "Hinweis"

#: ../../tools/catalog_item_types.rst:182
msgid ""
"Deleting a Catalog Item Type does not affect previously-provisioned "
"resources from that item. It only removes the item from the catalog for "
"future orders."
msgstr "Das Löschen eines Catalog Item Type wirkt sich nicht auf zuvor aus diesem Eintrag provisionierte Ressourcen aus. Es entfernt den Eintrag lediglich aus dem Katalog für zukünftige Aufträge."

#: ../../tools/catalog_item_types.rst:185
msgid "Multi-Tenant Considerations"
msgstr "Überlegungen zu mehreren Mandanten"

#: ../../tools/catalog_item_types.rst:187
msgid "**Public** items created in the Master Tenant are visible to all tenants"
msgstr "**Public**-Einträge, die im Master-Mandanten erstellt wurden, sind für alle Mandanten sichtbar"

#: ../../tools/catalog_item_types.rst:188
msgid "**Private** items are only visible to the creating tenant"
msgstr "**Private**-Einträge sind nur für den erstellenden Mandanten sichtbar"

#: ../../tools/catalog_item_types.rst:189
msgid "Sub-tenant users can only create Private catalog items"
msgstr "Sub-Mandanten-Benutzer können nur Private-Katalogeinträge erstellen"

#: ../../tools/catalog_item_types.rst:190
msgid ""
"Role-based access further restricts which users within a tenant can see "
"specific items"
msgstr "Rollenbasierter Zugriff schränkt weiter ein, welche Benutzer innerhalb eines Mandanten bestimmte Einträge sehen können"

#: ../../tools/catalog_item_types.rst:193
msgid "Layout Providers (Plugin)"
msgstr "Layout Providers (Plugin)"

#: ../../tools/catalog_item_types.rst:195
msgid ""
"Plugin-based layout providers can extend the catalog item presentation "
"with custom rendering. Installed plugins that implement "
"``AbstractCatalogItemLayoutProvider`` appear as layout options during "
"catalog item creation."
msgstr "Plugin-basierte Layout Provider können die Darstellung von Katalogeinträgen durch benutzerdefiniertes Rendering erweitern. Installierte Plugins, die ``AbstractCatalogItemLayoutProvider`` implementieren, erscheinen bei der Erstellung von Katalogeinträgen als Layout-Optionen."

#: ../../tools/catalog_item_types.rst:198
msgid "API"
msgstr "API"

#: ../../tools/catalog_item_types.rst:200
msgid "Catalog Item Types can be managed via the |morpheus| API:"
msgstr "Catalog Item Types können über die |morpheus| API verwaltet werden:"

#: ../../tools/catalog_item_types.rst:202
#, python-brace-format
msgid ""
"# List catalog item types\n"
"curl \"$MORPHEUS_API_URL/api/catalog-item-types\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Create a catalog item type\n"
"curl -X POST \"$MORPHEUS_API_URL/api/catalog-item-types\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\n"
"    \"catalogItemType\": {\n"
"      \"name\": \"Web Server\",\n"
"      \"description\": \"Standard Nginx web server\",\n"
"      \"type\": \"instance\",\n"
"      \"visibility\": \"public\",\n"
"      \"enabled\": true,\n"
"      \"config\": \"{\\\"instance\\\":{\\\"type\\\":\\\"nginx\\\"}}\"\n"
"    }\n"
"  }'"
msgstr ""

