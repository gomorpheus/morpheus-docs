#: ../../tools/hpe_vm/virtual_machines.rst:2
msgid "Virtual Machines"
msgstr "Virtuelle Maschinen"

#: ../../tools/hpe_vm/virtual_machines.rst:4
msgid ""
"The **Virtual Machines** menu option lists and manages VMs running on the"
" HVM host."
msgstr "Die Menüoption **Virtual Machines** listet auf dem HVM-Host laufende VMs auf und verwaltet sie."

#: ../../tools/hpe_vm/virtual_machines.rst:7
msgid "VM List"
msgstr "VM-Liste"

#: ../../tools/hpe_vm/virtual_machines.rst:9
msgid "Displays all VMs from ``virsh list --all``, including:"
msgstr "Zeigt alle VMs aus ``virsh list --all`` an, einschließlich:"

#: ../../tools/hpe_vm/virtual_machines.rst:11
msgid "VM name"
msgstr "VM-Name"

#: ../../tools/hpe_vm/virtual_machines.rst:12
msgid "Current state (running, shut off, paused, etc.)"
msgstr "Aktueller Zustand (wird ausgeführt, ausgeschaltet, pausiert usw.)"

#: ../../tools/hpe_vm/virtual_machines.rst:14
msgid "The list refreshes periodically to reflect current state."
msgstr "Die Liste wird regelmäßig aktualisiert, um den aktuellen Zustand widerzuspiegeln."

#: ../../tools/hpe_vm/virtual_machines.rst:17
msgid "VM Details"
msgstr "VM-Details"

#: ../../tools/hpe_vm/virtual_machines.rst:19
msgid "Selecting a VM shows its detailed information (from ``virsh dominfo``):"
msgstr "Durch Auswählen einer VM werden ihre detaillierten Informationen angezeigt (aus ``virsh dominfo``):"

#: ../../tools/hpe_vm/virtual_machines.rst:21
msgid "Name, UUID, state"
msgstr "Name, UUID, Zustand"

#: ../../tools/hpe_vm/virtual_machines.rst:22
msgid "CPU count, memory allocation"
msgstr "CPU-Anzahl, Arbeitsspeicherzuweisung"

#: ../../tools/hpe_vm/virtual_machines.rst:23
msgid "Autostart setting"
msgstr "Autostart-Einstellung"

#: ../../tools/hpe_vm/virtual_machines.rst:25
msgid "The state refreshes every 5 seconds."
msgstr "Der Zustand wird alle 5 Sekunden aktualisiert."

#: ../../tools/hpe_vm/virtual_machines.rst:28
msgid "VM Actions"
msgstr "VM-Maßnahmen"

#: ../../tools/hpe_vm/virtual_machines.rst:30
msgid "Depending on the VM's current state, the following actions are available:"
msgstr "Je nach aktuellem Zustand der VM stehen die folgenden Maßnahmen zur Verfügung:"

#: ../../tools/hpe_vm/virtual_machines.rst:36
msgid "Action"
msgstr "Maßnahme"

#: ../../tools/hpe_vm/virtual_machines.rst:37
msgid "Available When"
msgstr "Verfügbar wenn"

#: ../../tools/hpe_vm/virtual_machines.rst:38
msgid "Description"
msgstr "Beschreibung"

#: ../../tools/hpe_vm/virtual_machines.rst:39
msgid "**Start**"
msgstr "**Start**"

#: ../../tools/hpe_vm/virtual_machines.rst:40
msgid "Shut off / Paused"
msgstr "Ausgeschaltet / Pausiert"

#: ../../tools/hpe_vm/virtual_machines.rst:41
msgid "Boot or resume the VM"
msgstr "VM starten oder fortsetzen"

#: ../../tools/hpe_vm/virtual_machines.rst:42
msgid "**Shutdown**"
msgstr "**Shutdown**"

#: ../../tools/hpe_vm/virtual_machines.rst:43
#: ../../tools/hpe_vm/virtual_machines.rst:46
#: ../../tools/hpe_vm/virtual_machines.rst:49
msgid "Running"
msgstr "Wird ausgeführt"

#: ../../tools/hpe_vm/virtual_machines.rst:44
msgid "Graceful ACPI shutdown"
msgstr "Sanftes ACPI-Herunterfahren"

#: ../../tools/hpe_vm/virtual_machines.rst:45
msgid "**Reboot**"
msgstr "**Reboot**"

#: ../../tools/hpe_vm/virtual_machines.rst:47
msgid "Graceful ACPI reboot"
msgstr "Sanfter ACPI-Neustart"

#: ../../tools/hpe_vm/virtual_machines.rst:48
msgid "**Suspend**"
msgstr "**Suspend**"

#: ../../tools/hpe_vm/virtual_machines.rst:50
msgid "Pause the VM (freeze state in memory)"
msgstr "VM anhalten (Zustand im Speicher einfrieren)"

#: ../../tools/hpe_vm/virtual_machines.rst:51
msgid "**Destroy**"
msgstr "**Destroy**"

#: ../../tools/hpe_vm/virtual_machines.rst:52
msgid "Running / Paused"
msgstr "Wird ausgeführt / Pausiert"

#: ../../tools/hpe_vm/virtual_machines.rst:53
msgid "Force power off (equivalent to pulling the power cord)"
msgstr "Erzwungenes Ausschalten (entspricht dem Ziehen des Netzkabels)"

#: ../../tools/hpe_vm/virtual_machines.rst:54
msgid "**Undefine**"
msgstr "**Undefine**"

#: ../../tools/hpe_vm/virtual_machines.rst:55
msgid "Shut off"
msgstr "Ausgeschaltet"

#: ../../tools/hpe_vm/virtual_machines.rst:56
msgid "Remove the VM definition from libvirt (does not delete disk images)"
msgstr "VM-Definition aus libvirt entfernen (löscht keine Disk-Images)"

#: ../../tools/hpe_vm/virtual_machines.rst:58
msgid "Warning"
msgstr "Warnung"

#: ../../tools/hpe_vm/virtual_machines.rst:58
msgid ""
"**Destroy** immediately kills the VM without graceful shutdown. Use only "
"when the VM is unresponsive."
msgstr "**Destroy** beendet die VM sofort ohne sanftes Herunterfahren. Nur verwenden, wenn die VM nicht reagiert."

