#: ../../infrastructure/clusters/hvm/capacity_planning.rst:88
#, python-format
msgid ""
"With N+1 sizing, you should never allocate more than ``(N-1)/N`` of total"
" cluster memory to VMs. For a 3-node cluster, this means keeping 33% of "
"total capacity free. For a 5-node cluster, 20%."
msgstr ""

#: ../../infrastructure/clusters/hvm/capacity_planning.rst:91
msgid "Maintenance Capacity"
msgstr ""

#: ../../infrastructure/clusters/hvm/capacity_planning.rst:93
msgid ""
"Maintenance mode requires the same capacity headroom as failover — one "
"host worth of memory must be available across remaining hosts to evacuate"
" VMs during maintenance."
msgstr ""

