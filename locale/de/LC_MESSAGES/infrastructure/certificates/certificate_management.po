#: ../../infrastructure/certificates/certificate_management.rst:4
msgid "Certificate Management"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:7
msgid "Overview"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:9
msgid ""
"|morpheus| provides centralized SSL/TLS certificate management for "
"securing communications across your infrastructure. Certificates stored "
"in |morpheus| can be used for SSL termination on load balancers, securing"
" container communications, authenticating to integrations, and "
"provisioning encrypted endpoints."
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:11
msgid ""
"Certificate management is found in |InfTruCer| (Infrastructure > Trust > "
"Certificates). From this section, administrators can upload existing "
"certificates, generate certificate signing requests (CSRs), and manage "
"the full lifecycle of SSL/TLS certificates."
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:14
msgid "Role Permissions"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:16
msgid ""
"Access to certificate management is controlled by the following role "
"permission:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:18
msgid "**Infrastructure: Trust (Certificates)** — ``None``, ``Read``, or ``Full``"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:20
msgid "**None:** Cannot access the Certificates section"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:21
msgid "**Read:** Can view certificates but cannot create, edit, or delete"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:22
msgid "**Full:** Full management access to certificates"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:25
msgid "Certificate Types"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:27
msgid "|morpheus| supports several certificate types:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:29
msgid ""
"**SSL Certificate (PEM):** Standard PEM-encoded SSL/TLS certificate with "
"private key and optional certificate chain"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:30
msgid ""
"**x509 Client Certificate:** Client certificates used for mutual TLS "
"authentication"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:31
msgid ""
"**x509 Device Certificate:** Device certificates for IoT or machine-to-"
"machine authentication"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:32
msgid ""
"**Self-Signed Certificate:** Certificates generated and signed by "
"|morpheus| internal CA"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:33
msgid "**Root CA Certificate:** Trusted root certificate authority certificates"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:34
msgid ""
"**Certificate Signing Request (CSR):** Pending certificate requests "
"awaiting signing by a CA"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:37
msgid "Adding a Certificate"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:39
msgid "To upload or create a certificate:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:41
#: ../../infrastructure/certificates/certificate_management.rst:61
#: ../../infrastructure/certificates/certificate_management.rst:107
#: ../../infrastructure/certificates/certificate_management.rst:117
msgid "Navigate to |InfTruCer|"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:42
#: ../../infrastructure/certificates/certificate_management.rst:62
msgid "Click :guilabel:`+ ADD`"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:43
msgid "Select the certificate type"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:44
msgid "Complete the form fields:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:46
msgid "**NAME:** A descriptive name for the certificate"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:47
msgid ""
"**DOMAIN NAME:** The domain or common name the certificate covers (e.g., "
"``*.example.com``)"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:48
msgid "**CERTIFICATE (PEM):** Paste the PEM-encoded certificate content"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:49
msgid "**PRIVATE KEY (PEM):** Paste the PEM-encoded private key"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:50
msgid ""
"**CERTIFICATE CHAIN (PEM):** Paste intermediate and root CA certificates "
"(optional but recommended)"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:52
#: ../../infrastructure/certificates/certificate_management.rst:110
msgid "Click :guilabel:`SAVE`"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:54
#: ../../infrastructure/certificates/certificate_management.rst:112
msgid "Note"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:54
msgid ""
"Private keys are encrypted at rest using |morpheus| internal encryption. "
"They are never exposed in plain text through the UI after upload."
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:57
msgid "Generating a Certificate Signing Request"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:59
msgid "To generate a CSR for signing by an external Certificate Authority:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:63
msgid "Select the appropriate certificate type that supports CSR generation"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:64
msgid "Fill in the subject fields:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:66
msgid ""
"**COMMON NAME (CN):** The fully qualified domain name (e.g., "
"``app.example.com``)"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:67
msgid "**ORGANIZATION:** Your organization name"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:68
msgid "**ORGANIZATION UNIT:** Department or unit name"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:69
msgid "**CITY/LOCALITY:** City"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:70
msgid "**STATE/PROVINCE:** State or province"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:71
msgid "**COUNTRY:** Two-letter country code (e.g., ``US``)"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:72
msgid "**KEY SIZE:** Key length in bits (2048, 4096)"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:73
msgid "**KEY ALGORITHM:** RSA or ECDSA"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:75
msgid "Click :guilabel:`GENERATE REQUEST`"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:77
msgid ""
"The CSR can then be submitted to your Certificate Authority for signing. "
"Once signed, upload the resulting certificate back to |morpheus| to "
"complete the process."
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:80
msgid "Certificate Details"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:82
msgid "Selecting a certificate from the list displays its details:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:84
msgid "**Status:** Active, Expired, or Pending"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:85
msgid "**Issued To / Issued By:** Subject and issuer information"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:86
msgid "**Serial Number:** Certificate serial number"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:87
msgid "**Fingerprint:** SHA-256 fingerprint for verification"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:88
msgid "**Issue Date / Expiration Date:** Certificate validity period"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:89
msgid "**Key Algorithm / Key Size:** Cryptographic details"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:90
msgid "**Wildcard:** Whether the certificate covers wildcard domains"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:93
msgid "Certificate Usage"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:95
msgid "Certificates stored in |morpheus| can be applied in various contexts:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:97
msgid "**Load Balancers:** SSL termination and re-encryption profiles"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:98
msgid "**Network Routers:** NSX-T and other router SSL configurations"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:99
msgid ""
"**Provisioning:** Applied during Instance provisioning for SSL-enabled "
"services"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:100
msgid ""
"**Integrations:** Authentication with external services requiring client "
"certificates"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:102
msgid ""
"Certificates uploaded in this section are application objects and are not"
" the same as certificate authorities trusted by the appliance JVM. To "
"trust the CA of an outbound integration endpoint, follow "
":doc:`/getting_started/additional/ssl-import`. That procedure includes "
"the required ``morpheus-ui`` restart; reconfigure updates the truststores"
" but does not restart the running UI JVM."
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:105
msgid "Editing Certificates"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:108
msgid ""
"Click the pencil icon on the certificate row or select the certificate "
"and click :guilabel:`EDIT`"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:109
msgid "Modify the certificate fields as needed"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:112
msgid ""
"Certificate content (PEM data) can be updated, for example when renewing "
"a certificate with the same name."
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:115
msgid "Deleting Certificates"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:118
msgid ""
"Click the trash icon on the certificate row or select the certificate and"
" choose :guilabel:`DELETE` from the Actions menu"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:119
msgid "Confirm deletion"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:121
msgid "Warning"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:121
msgid ""
"Deleting a certificate that is actively in use by load balancers or other"
" services may cause service disruptions. Verify the certificate is not "
"referenced before removal."
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:124
msgid "API"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:126
msgid "Certificates can also be managed via the |morpheus| API:"
msgstr ""

#: ../../infrastructure/certificates/certificate_management.rst:128
#, python-brace-format
msgid ""
"# List certificates\n"
"curl \"$MORPHEUS_API_URL/api/certificates\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\"\n"
"\n"
"# Create a certificate\n"
"curl -X POST \"$MORPHEUS_API_URL/api/certificates\" \\\n"
"  -H \"Authorization: Bearer $MORPHEUS_API_TOKEN\" \\\n"
"  -H \"Content-Type: application/json\" \\\n"
"  -d '{\n"
"    \"certificate\": {\n"
"      \"name\": \"My SSL Cert\",\n"
"      \"certFile\": \"-----BEGIN CERTIFICATE-----\\n...\",\n"
"      \"keyFile\": \"-----BEGIN PRIVATE KEY-----\\n...\",\n"
"      \"chainFile\": \"-----BEGIN CERTIFICATE-----\\n...\"\n"
"    }\n"
"  }'"
msgstr ""

