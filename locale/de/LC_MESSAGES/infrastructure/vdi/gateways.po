#: ../../infrastructure/vdi/gateways.rst:146
msgid "API Reference"
msgstr "API-Referenz"

#: ../../infrastructure/vdi/gateways.rst:148
msgid "VDI Gateways are manageable via the |morpheus| API:"
msgstr "VDI Gateways können über die |morpheus|-API verwaltet werden:"

#: ../../infrastructure/vdi/gateways.rst:150
msgid "``GET /api/vdi-gateways`` — List all VDI Gateways"
msgstr "``GET /api/vdi-gateways`` — Alle VDI Gateways auflisten"

#: ../../infrastructure/vdi/gateways.rst:151
msgid "``GET /api/vdi-gateways/:id`` — Get a specific gateway"
msgstr "``GET /api/vdi-gateways/:id`` — Ein bestimmtes Gateway abrufen"

#: ../../infrastructure/vdi/gateways.rst:152
msgid "``POST /api/vdi-gateways`` — Create a gateway"
msgstr "``POST /api/vdi-gateways`` — Ein Gateway erstellen"

#: ../../infrastructure/vdi/gateways.rst:153
