#: ../../infrastructure/servers/server_devices.rst:62
msgid "Warning"
msgstr "Warnung"

#: ../../infrastructure/servers/server_devices.rst:62
msgid ""
"Detaching a device from a running VM may cause application errors if "
"software inside the VM is actively using the device. Always ensure "
"workloads are quiesced before detaching passthrough devices."
msgstr "Das Trennen eines Geräts von einer laufenden VM kann Anwendungsfehler verursachen, wenn Software in der VM das Gerät aktiv nutzt. Stellen Sie stets sicher, dass Arbeitslasten ruhiggestellt sind, bevor Passthrough-Geräte getrennt werden."

#: ../../infrastructure/servers/server_devices.rst:65
msgid "Supported Device Types"
msgstr "Unterstützte Gerätetypen"

#: ../../infrastructure/servers/server_devices.rst:67
msgid ""
