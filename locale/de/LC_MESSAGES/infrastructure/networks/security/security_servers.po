#: ../../infrastructure/networks/security/security_servers.rst:4
msgid "Security Servers"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:6
msgid "``Infrastructure > Network > Integrations > (select Security Server)``"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:9
msgid "Overview"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:11
msgid ""
"Security servers provide centralized management of network security "
"policies, firewall rules, and security groups within |morpheus|. These "
"integrations connect to third-party security platforms (such as Palo Alto"
" Networks, Cisco ACI, or VMware NSX) to provide security orchestration "
"alongside network provisioning workflows."
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:13
msgid "Security server integrations enable:"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:15
msgid "Centralized firewall rule management"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:16
msgid "Security group and policy enforcement"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:17
msgid "Commit-based workflow for staged changes"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:18
msgid "Integration with provisioning for automatic security policy application"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:20
msgid "Note"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:20
msgid ""
"Security servers are distinguished from network servers by their primary "
"function. A single integration (e.g., Cisco ACI) may appear as both a "
"network and security integration."
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:23
msgid "Viewing Security Servers"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:25
#: ../../infrastructure/networks/security/security_servers.rst:31
msgid "Navigate to ``Infrastructure > Network > Integrations``"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:26
msgid ""
"Security server integrations are listed alongside network integrations "
"and are identified by their type"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:29
msgid "Adding a Security Server Integration"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:32
msgid "Click :guilabel:`+ ADD`"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:33
msgid ""
"Select the desired security integration type from the **Security** "
"category"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:34
msgid ""
"Complete the integration-specific configuration fields (see individual "
"integration guides)"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:35
msgid "Click :guilabel:`ADD NETWORK INTEGRATION`"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:38
msgid "Security Server Detail View"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:40
msgid ""
"Selecting a security server integration opens the detail view with tabs "
"that may include:"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:42
msgid ""
"**Summary** — Overview of server status, connection details, and sync "
"status"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:43
msgid "**Firewall** — Firewall groups and rules management"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:44
msgid "**Groups** — Security groups and endpoint groups"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:45
msgid "**Scopes** — Scope/tenant segmentation"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:48
msgid "Commit Workflow"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:50
msgid ""
"Some security server integrations support a commit-based workflow, where "
"changes are staged locally before being pushed to the security platform. "
"This provides a review step before policy changes take effect."
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:52
msgid "Make desired changes (create/edit/delete firewall rules, groups, etc.)"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:53
msgid "Review staged changes in the pending changes section"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:54
msgid ""
"Click :guilabel:`COMMIT` to push all pending changes to the security "
"platform"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:55
msgid "Alternatively, click :guilabel:`DISCARD` to abandon pending changes"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:57
msgid "Important"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:57
msgid ""
"Changes made in a commit-based workflow do not take effect on the "
"security platform until they are committed. This allows multiple changes "
"to be batched and reviewed before deployment."
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:60
msgid "Required Role Permissions"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:62
msgid ""
"Access to security server management requires the ``Infrastructure: "
"Network Integrations`` permission with ``read`` or ``full`` access. "
"Firewall rule management requires the ``Infrastructure: Network "
"Firewalls`` permission (``infrastructure-network-firewalls``) with "
"``read``, ``managerules``, or ``full`` access."
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:65
msgid "API"
msgstr ""

