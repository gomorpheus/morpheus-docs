msgid "``GET /api/network-security-servers`` — List security servers"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:70
msgid "``GET /api/network-security-servers/:id`` — Get a specific security server"
msgstr ""

#: ../../infrastructure/networks/security/security_servers.rst:71
msgid ""
"``GET /api/network-security-server-types`` — List available security "
"server types"
msgstr ""

