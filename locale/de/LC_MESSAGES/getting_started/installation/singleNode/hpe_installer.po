#: ../../getting_started/installation/singleNode/hpe_installer.rst:257
msgid "Large Image Uploads and Timeout"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:259
msgid ""
"The installer UI has a **60-minute timeout** for the image upload step. "
"For very large QCOW2 images or slow network connections, the upload may "
"exceed this limit."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:261
msgid "**Pre-staging the image manually:**"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:263
msgid ""
"If you anticipate the upload will take longer than 60 minutes, you can "
"manually transfer the QCOW2 image to the host beforehand. The installer "
"uploads images to:"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:265
msgid "/var/lib/libvirt/images/"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:269
msgid ""
"To have the installer skip the upload and discover a pre-existing image "
"on the host, place the file at:"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:271
msgid "/var/lib/libvirt/images/<filename>.qcow2"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:275
#, python-format
msgid ""
"The installer checks the file size using ``stat -c '%s' "
"/var/lib/libvirt/images/<filename>`` — if the file exists and has the "
"same size as the local source file, the upload step is skipped "
"automatically."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:277
msgid "**Example — manually uploading via SCP:**"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:279
msgid ""
"scp hpe-vm-essentials-9.1.0-1.qcow2 ubuntu@<hvm-"
"host>:/var/lib/libvirt/images/"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:283
msgid ""
"Ensure the filename on the host matches exactly what the installer "
"expects (i.e., the same filename you selected in the QCOW2 Image field). "
"The size comparison must also match — do not rename or truncate the file."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:286
msgid "Installer Data Locations"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:288
msgid ""
"The HPE Morpheus Manager Installer stores configuration, logs, and state "
"data locally on the workstation. If you need to start fresh (e.g., clear "
"saved settings, reset SSH trust, or troubleshoot a corrupted state), you "
"can delete these files."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:290
#: ../../getting_started/installation/singleNode/hpe_installer.rst:339
msgid "**macOS:**"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:296
#: ../../getting_started/installation/singleNode/hpe_installer.rst:309
msgid "Path"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:297
#: ../../getting_started/installation/singleNode/hpe_installer.rst:310
msgid "Contents"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:298
msgid "``~/Library/Application Support/Morpheus Manager Installer/``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:299
#: ../../getting_started/installation/singleNode/hpe_installer.rst:312
msgid "Configuration and state files (see below)"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:300
msgid "``~/Library/Logs/Morpheus Manager Installer/``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:301
#: ../../getting_started/installation/singleNode/hpe_installer.rst:314
msgid "Application log files (daily rotation, 10 MB max per file)"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:303
msgid "**Windows:**"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:311
msgid "``%APPDATA%\\Morpheus Manager Installer\\``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:313
msgid "``%APPDATA%\\Morpheus Manager Installer\\logs\\``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:316
msgid "**Stored Files:**"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:322
msgid "File"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:323
msgid "Purpose"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:324
msgid "``session-config.json``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:325
msgid ""
"Saves the last-used deployment settings (SSH host, IP, network config, VM"
" size, etc.) so they are pre-populated on next launch. Passwords are "
"**not** stored."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:326
msgid "``cluster-config.json``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:327
msgid ""
"Saves cluster wizard settings (cluster name, datastore config). Secrets "
"are redacted before persisting."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:328
msgid "``cluster-state.json``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:329
msgid ""
"Tracks whether the last cluster deployment succeeded (used for "
"resume/retry logic)."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:330
msgid "``known_hosts.json``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:331
msgid ""
"Stores SSH host fingerprints for HVM hosts you have connected to. Used to"
" detect host key changes (similar to ``~/.ssh/known_hosts``)."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:332
msgid "``known_certs.json``"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:333
msgid ""
"Stores trusted TLS certificate fingerprints for Morpheus appliances with "
"self-signed or untrusted certificates."
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:335
msgid "**Resetting the Installer:**"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:337
msgid "To completely reset the installer to a clean state:"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:341
msgid ""
"rm -rf ~/Library/Application\\ Support/Morpheus\\ Manager\\ Installer/\n"
"rm -rf ~/Library/Logs/Morpheus\\ Manager\\ Installer/"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:346
msgid "**Windows (PowerShell):**"
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:348
msgid "Remove-Item -Recurse -Force \"$env:APPDATA\\Morpheus Manager Installer\""
msgstr ""

#: ../../getting_started/installation/singleNode/hpe_installer.rst:352
msgid ""
"If you are only experiencing SSH host key warnings (e.g., after re-"
"imaging a host), you can delete just ``known_hosts.json`` rather than "
"resetting everything."
msgstr ""

