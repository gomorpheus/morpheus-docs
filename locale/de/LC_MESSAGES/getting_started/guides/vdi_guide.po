msgstr "Audiowiedergabe (RDP)"

#: ../../personas/virtual_desktop.rst:20
msgid "Local Printer (RDP)"
msgstr "Lokaler Drucker (RDP)"

#: ../../personas/virtual_desktop.rst:21
