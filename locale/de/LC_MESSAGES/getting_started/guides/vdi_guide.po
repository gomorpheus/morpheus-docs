msgstr "RDP-Remote-App-Unterstützung"

#: ../../personas/virtual_desktop.rst:16
msgid "Clipboard Copy/Paste"
msgstr "Zwischenablage Kopieren/Einfügen"

#: ../../personas/virtual_desktop.rst:17
msgid "HiDPI Support"
msgstr "HiDPI-Unterstützung"

#: ../../personas/virtual_desktop.rst:18
msgid "Auto Compression Scanning based on User Bandwidth"
msgstr "Automatische Kompressionsscans basierend auf der Benutzerbandbreite"

#: ../../personas/virtual_desktop.rst:19
