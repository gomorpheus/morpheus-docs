msgid "**CREATE BUCKET:** Checked"
msgstr ""

#: ../../getting_started/guides/autoinstall_instance.rst:31
msgid "**REGION:** The AWS region to create the bucket in"
msgstr ""

#: ../../getting_started/guides/autoinstall_instance.rst:32
