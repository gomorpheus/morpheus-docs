msgid "Azure Subscription ID"
msgstr "Azure Subscription ID"

#: ../../getting_started/guides/azure_guide.rst:37
msgid "Directory (tenant) ID"
msgstr "Directory (tenant) ID"

#: ../../getting_started/guides/azure_guide.rst:38
msgid "Application (client) ID"
msgstr "Application (client) ID"

#: ../../getting_started/guides/azure_guide.rst:39
msgid "Application (client) Secret"
msgstr "Application (client) Secret"

