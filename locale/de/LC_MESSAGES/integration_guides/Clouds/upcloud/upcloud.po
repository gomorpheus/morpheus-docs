#: ../../integration_guides/Clouds/upcloud/upcloud.rst:103
msgid "Provisioning to UpCloud"
msgstr "Provisionierung zu UpCloud"

#: ../../integration_guides/Clouds/upcloud/upcloud.rst:105
msgid ""
"Instances and Apps can be created using the private Images synced from "
"UpCloud or from the |morpheus| provided Image Catalog."
msgstr "Instanzen und Apps können mit den privaten, von UpCloud synchronisierten Images oder mit dem von |morpheus| bereitgestellten Image-Katalog erstellt werden."

#: ../../integration_guides/Clouds/upcloud/upcloud.rst:108
msgid "Provision a synced Image"
msgstr "Ein synchronisiertes Image provisionieren"

