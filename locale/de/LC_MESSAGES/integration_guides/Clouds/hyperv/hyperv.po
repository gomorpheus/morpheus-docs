msgid "$ sudo yum install krb5-workstation pam_krb5 -y"
msgstr ""

#: ../../integration_guides/Clouds/hyperv/hyperv.rst:119
msgid ""
"Create a file in /etc called krb5.conf and replace the domain name with "
"the name of the domain to be used. In this case we used |morpheus| .com "
"as the domain."
msgstr ""

#: ../../integration_guides/Clouds/hyperv/hyperv.rst:121
#, python-brace-format
msgid ""
"[libdefaults]\n"
"        default_realm = |morpheus| .COM\n"
"            dns_lookup_kdc = true\n"
"            verify_ap_req_nofail = false\n"
"        default_tgs_enctypes = rc4-hmac\n"
"        default_tkt_enctypes = rc4-hmac\n"
"[realms]\n"
"        |morpheus| .COM = {\n"
"                kdc = win-ad.|morpheus| .COM:88\n"
"                admin_server = win-ad.|morpheus| .COM:749\n"
"     }\n"
"[domain_realm]\n"
"    .|morpheus| .COM = |morpheus| .COM\n"
"        |morpheus| .COM = |morpheus| .COM\n"
"[login]\n"
"     krb4_convert = true\n"
"     krb4_get_tickets = false"
msgstr ""

#: ../../integration_guides/Clouds/hyperv/hyperv.rst:141
msgid ""
"After creation of the krb5.conf a keytab file is also required. See below"
" for instructions on how to create a keytab file. "
"http://www.itadmintools.com/2011/07/creating-kerberos-keytab-files.html"
msgstr ""

