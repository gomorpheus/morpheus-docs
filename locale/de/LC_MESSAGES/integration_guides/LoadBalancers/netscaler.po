msgstr "Optionen für Sticky Sessions für die VIP angeben"

#: ../../integration_guides/LoadBalancers/netscaler.rst:82
msgid "Source IP"
msgstr "Source IP"

#: ../../integration_guides/LoadBalancers/netscaler.rst:83
msgid "Cookie"
msgstr "Cookie"

