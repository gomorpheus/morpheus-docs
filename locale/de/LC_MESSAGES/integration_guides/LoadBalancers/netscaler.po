msgstr "Hostname festlegen, der zur VIP-IP aufgelöst wird."

#: ../../integration_guides/LoadBalancers/netscaler.rst:73
msgid "Example: jwDemoHaApp59.den.example.com"
msgstr "Beispiel: jwDemoHaApp59.den.example.com"

