#: ../../integration_guides/Networking/phpipam.rst:2
msgid "phpIPAM"
msgstr "phpIPAM"

#: ../../integration_guides/Networking/phpipam.rst:5
msgid "Configuration"
msgstr "Konfiguration"

#: ../../integration_guides/Networking/phpipam.rst:7
msgid ""
"Within phpIPAM dashboard, enable api in Administration > phpIPAM settings"
" > feature settings.  Toggle API switch to ``on`` and save."
msgstr "Aktivieren Sie in der phpIPAM-Dashboard-Ansicht die API unter Administration > phpIPAM settings > feature settings. Schalten Sie den API-Switch auf ``on`` und speichern Sie."

#: ../../integration_guides/Networking/phpipam.rst:8
msgid "Go to Admin > API > create API key."
msgstr "Gehen Sie zu Admin > API > create API key."

#: ../../integration_guides/Networking/phpipam.rst:9
msgid "Create unique App ID."
msgstr "Erstellen Sie eine eindeutige App ID."

#: ../../integration_guides/Networking/phpipam.rst:10
msgid "Enable ``read/write/admin`` access under **App Permissions**."
msgstr "Aktivieren Sie unter **App Permissions** den Zugriff ``read/write/admin``."

#: ../../integration_guides/Networking/phpipam.rst:11
msgid "Under **App Security** select ``SSL with User Token``."
msgstr "Wählen Sie unter **App Security** ``SSL with User Token``."

#: ../../integration_guides/Networking/phpipam.rst:14
msgid "Add phpIPAM integration to |morpheus|"
msgstr "phpIPAM-Integration zu |morpheus| hinzufügen"

#: ../../integration_guides/Networking/phpipam.rst:16
msgid "Navigate to ``Infrastructure > Network > Integrations``"
msgstr "Navigieren Sie zu ``Infrastructure > Network > Integrations``"

#: ../../integration_guides/Networking/phpipam.rst:17
msgid "Select :guilabel:`+ ADD` > IPAM > phpIPAM"
msgstr "Wählen Sie :guilabel:`+ ADD` > IPAM > phpIPAM"

#: ../../integration_guides/Networking/phpipam.rst:18
msgid "Enter the following:"
msgstr "Geben Sie Folgendes ein:"

#: ../../integration_guides/Networking/phpipam.rst:20
msgid "Name"
msgstr "Name"

#: ../../integration_guides/Networking/phpipam.rst:21
msgid "URL"
msgstr "URL"

#: ../../integration_guides/Networking/phpipam.rst:22
msgid "Add ``/api/`` to end of URL ex. ``http://10.30.20.196/api/``"
msgstr "Fügen Sie ``/api/`` am Ende der URL hinzu, z. B. ``http://10.30.20.196/api/``"

#: ../../integration_guides/Networking/phpipam.rst:23
msgid "App ID"
msgstr "App ID"

#: ../../integration_guides/Networking/phpipam.rst:24
msgid "From phpIPAM API Key"
msgstr "Aus dem phpIPAM-API-Schlüssel"

#: ../../integration_guides/Networking/phpipam.rst:25
msgid "Username"
msgstr "Username"

#: ../../integration_guides/Networking/phpipam.rst:26
msgid "Password"
msgstr "Password"

#: ../../integration_guides/Networking/phpipam.rst:27
msgid "Enable or Disable SSL SNI Verification"
msgstr "SSL-SNI-Verifizierung aktivieren oder deaktivieren"

#: ../../integration_guides/Networking/phpipam.rst:28
msgid "Enter Network Filter"
msgstr "Netzwerkfilter eingeben"

#: ../../integration_guides/Networking/phpipam.rst:30
msgid "Select :guilabel:`SAVE IPAM INTEGRATION`"
msgstr "Wählen Sie :guilabel:`SAVE IPAM INTEGRATION`"

