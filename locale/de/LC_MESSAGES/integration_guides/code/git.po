msgid "Authentication Methods"
msgstr "Authentifizierungsmethoden"

#: ../../integration_guides/code/git.rst:105
msgid "Method"
msgstr "Methode"

#: ../../integration_guides/code/git.rst:105
msgid "Use Case"
msgstr "Anwendungsfall"

