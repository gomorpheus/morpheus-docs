#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:86
msgid "How Approvals Work"
msgstr ""

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:88
msgid "When a user triggers an action covered by a Remedy approval policy:"
msgstr ""

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:90
msgid ""
"|morpheus| creates a **Change Request** in Remedy (CHG:Infrastructure "
"Change form)"
msgstr ""

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:91
msgid "The provisioning request enters a **Pending** state in |morpheus|"
msgstr ""

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:92
msgid ""
"|morpheus| polls the Remedy Change Request for status updates (every 5 "
"minutes)"
msgstr ""

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:93
msgid ""
"When the Change Request is approved in Remedy, |morpheus| automatically "
"proceeds with the action"
msgstr ""

#: ../../integration_guides/ITSM/bmc_remedy_approvals.rst:94
msgid ""
"When the Change Request is rejected or cancelled in Remedy, |morpheus| "
"denies the request"
msgstr ""

