msgstr "``zoneTypeId : <integer>`` Datenbank-ID des Cloud-Typs. Filtert auf Gruppen, die Clouds mit dem angegebenen Cloud-Typ enthalten"

#: ../../library/options/option_lists.rst:406
msgid ""
"``zoneId : <integer>``  // Database ID of cloud. Filters to only groups "
"that contain the cloud with the specified ID"
msgstr "``zoneId : <integer>``  // Datenbank-ID der Cloud. Filtert auf Gruppen, die die Cloud mit der angegebenen ID enthalten"

#: ../../library/options/option_lists.rst:407
msgid "``siteId : <integer>`` // Database ID of group to return"
msgstr "``siteId : <integer>`` // Datenbank-ID der zurückzugebenden Gruppe"

#: ../../library/options/option_lists.rst:408
msgid "``phrase : <string>`` // Fuzzy matches phrase on group name and location."
msgstr "``phrase : <string>`` // Unscharfe Übereinstimmung der Phrase mit Gruppenname und Standort."

#: ../../library/options/option_lists.rst:412
msgid ""
"``tenantId : <integer>`` // Database ID of tenant where servers are "
"located. Filters to only servers within the specified tenant. Only "
"available in Master Tenant"
msgstr "``tenantId : <integer>`` // Datenbank-ID des Mandanten, in dem sich Server befinden. Filtert auf Server innerhalb des angegebenen Mandanten. Nur im Master-Mandanten verfügbar"

#: ../../library/options/option_lists.rst:413
msgid ""
"``serverId : <integer>`` // Database ID of server. Filters to the server "
"specified by the ID"
msgstr "``serverId : <integer>`` // Datenbank-ID des Servers. Filtert auf den durch die ID angegebenen Server"

#: ../../library/options/option_lists.rst:414
msgid ""
"``siteZoneId : <integer>`` // Database ID of cloud. Filters to servers "
"contained within the specified cloud"
msgstr "``siteZoneId : <integer>`` // Datenbank-ID der Cloud. Filtert auf Server innerhalb der angegebenen Cloud"

#: ../../library/options/option_lists.rst:415
msgid ""
"``serverType : <string>`` // Type of server. Accepted values: 'host', "
"'baremetal', 'vm'"
msgstr "``serverType : <string>`` // Servertyp. Akzeptierte Werte: 'host', 'baremetal', 'vm'"

#: ../../library/options/option_lists.rst:416
msgid ""
"``siteId : <integer>`` // Database ID of group. Filters to only servers "
"contained within clouds that are added in the specified group"
msgstr "``siteId : <integer>`` // Datenbank-ID der Gruppe. Filtert auf Server in Clouds, die in der angegebenen Gruppe hinzugefügt sind"

#: ../../library/options/option_lists.rst:417
msgid ""
"``tagName : <string>`` // Filters to servers with tags containing the "
"tagName"
msgstr "``tagName : <string>`` // Filtert auf Server mit Tags, die den tagName enthalten"

#: ../../library/options/option_lists.rst:418
msgid ""
"``tagValue : <mixed>`` // Requires tagName. Filters to servers with tags "
"containing the tagName and specified tagValue"
msgstr "``tagValue : <mixed>`` // Erfordert tagName. Filtert auf Server mit Tags, die den tagName und den angegebenen tagValue enthalten"

#: ../../library/options/option_lists.rst:419
msgid ""
"``phrase : <string>`` // Fuzzy matches phrase on server name and "
"description."
msgstr "``phrase : <string>`` // Unscharfe Übereinstimmung der Phrase mit Servername und Beschreibung."

#: ../../library/options/option_lists.rst:421
#, python-brace-format
msgid "**Example:** ``results = {max: 50, siteZoneId : 3}``"
msgstr "**Beispiel:** ``results = {max: 50, siteZoneId : 3}``"

#: ../../library/options/option_lists.rst:425
msgid "Contains same options for Instances Morpheus API type."
msgstr "Enthält dieselben Optionen wie der Instances-Morpheus-API-Typ."

#: ../../library/options/option_lists.rst:430
