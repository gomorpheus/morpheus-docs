msgstr "``serverId : <integer>`` // Datenbank-ID des Servers. Filtert auf die Instanz, die den angegebenen Server enthält"

#: ../../library/options/option_lists.rst:396
msgid ""
"``tagName : <string>`` // Filters to instances with tags containing the "
"tagName"
msgstr "``tagName : <string>`` // Filtert auf Instanzen mit Tags, die den tagName enthalten"

#: ../../library/options/option_lists.rst:397
msgid ""
"``tagValue : <mixed>`` // Requires tagName. Filters to instances with "
"tags containing the tagName and specified tagValue"
msgstr "``tagValue : <mixed>`` // Erfordert tagName. Filtert auf Instanzen mit Tags, die den tagName und den angegebenen tagValue enthalten"

#: ../../library/options/option_lists.rst:398
msgid ""
"``phrase : <string>`` // Fuzzy matches phrase on instance name and "
"description"
msgstr "``phrase : <string>`` // Unscharfe Übereinstimmung der Phrase mit Instanzname und Beschreibung"

#: ../../library/options/option_lists.rst:400
#, python-brace-format
msgid "**Example:** ``results = {tenantId:1, phrase: \"ha\"}``"
msgstr "**Beispiel:** ``results = {tenantId:1, phrase: \"ha\"}``"

#: ../../library/options/option_lists.rst:404
msgid ""
"``tenantId : <integer>`` // Database ID of tenant where groups are "
