msgstr "Aktiviert Load-Balancer-Zuweisung und Auto-Scaling-Features"

#: ../../library/blueprints/instance_types.rst:60
msgid "Support Deployments"
msgstr "Deployments unterstützen"

#: ../../library/blueprints/instance_types.rst:61
