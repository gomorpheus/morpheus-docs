msgid "Supported Clouds"
msgstr "Unterstützte Clouds"

#: ../../backups/integrations/avamar.rst:9
msgid "Avamar backup is supported for:"
msgstr "Avamar-Sicherung wird unterstützt für:"

#: ../../backups/integrations/avamar.rst:11
msgid "VMware"
msgstr "VMware"

#: ../../backups/integrations/avamar.rst:13
msgid "Important"
msgstr "Wichtig"

#: ../../backups/integrations/avamar.rst:13
