msgstr "Die Avamar-API muss auf dem Avamar-Server installiert sein (nicht standardmäßig installiert)"

#: ../../backups/integrations/avamar.rst:16
msgid "Features"
msgstr "Features"

#: ../../backups/integrations/avamar.rst:18
msgid "Share one backup provider across multiple Tenants"
msgstr "Einen Sicherungsprovider über mehrere Mandanten hinweg teilen"

#: ../../backups/integrations/avamar.rst:19
